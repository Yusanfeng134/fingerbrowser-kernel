diff --git a/third_party/blink/renderer/core/timezone/timezone_controller.cc b/third_party/blink/renderer/core/timezone/timezone_controller.cc
index 07561c9..437b364 100644
--- a/third_party/blink/renderer/core/timezone/timezone_controller.cc
+++ b/third_party/blink/renderer/core/timezone/timezone_controller.cc
@@ -18,6 +18,7 @@
 #include "third_party/blink/renderer/core/workers/worker_backing_thread.h"
 #include "third_party/blink/renderer/core/workers/worker_or_worklet_global_scope.h"
 #include "third_party/blink/renderer/core/workers/worker_thread.h"
+#include "third_party/blink/renderer/platform/fingerbrowser/fingerbrowser_fingerprint.h"
 #include "third_party/blink/renderer/platform/runtime_enabled_features.h"
 #include "third_party/blink/renderer/platform/scheduler/public/main_thread.h"
 #include "third_party/blink/renderer/platform/scheduler/public/main_thread_scheduler.h"
@@ -114,6 +115,19 @@ void TimeZoneController::Init() {
   Platform::Current()->GetBrowserInterfaceBroker()->GetInterface(
       monitor.BindNewPipeAndPassReceiver());
   monitor->AddClient(instance().receiver_.BindNewPipeAndPassRemote());
+
+  // FingerBrowser L2: apply the per-profile timezone inside this renderer.
+  // The browser process calls icu::TimeZone::adoptDefault(), but that is
+  // per-process and tzset() is POSIX-only, so on Windows Intl/Date here would
+  // otherwise keep reporting the host zone. Going through
+  // SetTimeZoneOverride() also notifies V8 so its date cache is invalidated.
+  // The handle is released on purpose: ~TimeZoneOverride() would clear the
+  // override, and this one must last for the life of the renderer.
+  const std::string fb_timezone =
+      fingerbrowser::SwitchValue(fingerbrowser::kTimezoneSwitch);
+  if (!fb_timezone.empty()) {
+    (void)SetTimeZoneOverride(String::FromUTF8(fb_timezone)).release();
+  }
 }
 
