From: FingerBrowser
Subject: [PATCH 0009] screen dimensions and geolocation

Override screen.width/height/availWidth/availHeight and short-circuit the
Geolocation API with the per-profile coordinates, so window size and reported
location match the rest of the profile.

Depends on: 0001-0008.

diff --git a/chrome/browser/fingerbrowser/fingerbrowser_policy.cc b/chrome/browser/fingerbrowser/fingerbrowser_policy.cc
index 48e89d5..83ecb56 100644
--- a/chrome/browser/fingerbrowser/fingerbrowser_policy.cc
+++ b/chrome/browser/fingerbrowser/fingerbrowser_policy.cc
@@ -202,6 +202,29 @@ std::optional<FingerBrowserPolicy> ParsePolicyDict(
         audio_noise && *audio_noise > 0) {
       policy.audio_noise_seed = *audio_noise;
     }
+    if (const std::optional<int> screen_width =
+            hardware_profile->FindInt("screenWidth");
+        screen_width && IsValidWindowSide(*screen_width)) {
+      policy.screen_width = *screen_width;
+    }
+    if (const std::optional<int> screen_height =
+            hardware_profile->FindInt("screenHeight");
+        screen_height && IsValidWindowSide(*screen_height)) {
+      policy.screen_height = *screen_height;
+    }
+  }
+
+  // 地理位置：经纬度必须成对出现且在合法范围内，缺一不可（只给一半会造出
+  // 本初子午线/赤道上的假坐标，比不伪装更可疑）。
+  if (const base::Value::Dict* geo = fingerprint_policy->FindDict("geolocation")) {
+    const std::optional<double> lat = geo->FindDouble("latitude");
+    const std::optional<double> lon = geo->FindDouble("longitude");
+    if (lat && lon && *lat >= -90.0 && *lat <= 90.0 && *lon >= -180.0 &&
+        *lon <= 180.0) {
+      policy.has_geo = true;
+      policy.geo_latitude_e6 = static_cast<int>(*lat * 1e6);
+      policy.geo_longitude_e6 = static_cast<int>(*lon * 1e6);
+    }
   }
 
   return policy;
diff --git a/chrome/browser/fingerbrowser/fingerbrowser_policy.h b/chrome/browser/fingerbrowser/fingerbrowser_policy.h
index 5658313..1e7d494 100644
--- a/chrome/browser/fingerbrowser/fingerbrowser_policy.h
+++ b/chrome/browser/fingerbrowser/fingerbrowser_policy.h
@@ -40,6 +40,15 @@ struct FingerBrowserPolicy {
   int device_memory = 0;
   int canvas_noise_seed = 0;
   int audio_noise_seed = 0;
+
+  // screen.width/height。--window-size 只影响浏览器窗口，网站读到的仍是宿主
+  // 真实分辨率，必须单独伪装。
+  int screen_width = 0;
+  int screen_height = 0;
+  // 经纬度以 1e6 倍整数保存，0 表示未配置（用 has_geo 区分真实的 0 坐标）。
+  bool has_geo = false;
+  int geo_latitude_e6 = 0;
+  int geo_longitude_e6 = 0;
 };
 
 std::optional<FingerBrowserPolicy> LoadFingerBrowserPolicy(
