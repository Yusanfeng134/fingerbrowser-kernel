+namespace {
+
+// Windows 任务栏在 100% 缩放下约占 40px。screen.height 与 availHeight 完全相等
+// 反而不自然（等于宣称没有任务栏），指纹脚本会把这个差值本身当作特征，所以伪装
+// 时保留一个常见差值。
+constexpr int kFingerBrowserTaskbarHeight = 40;
+
+}  // namespace
+
 int Screen::height() const {
+  if (const int spoofed =
+          fingerbrowser::IntSwitch(fingerbrowser::kScreenHeightSwitch);
+      spoofed > 0) {
+    return spoofed;
+  }
   if (!DomWindow())
     return 0;
   return GetRect(/*available=*/false).height();
 }
 
 int Screen::width() const {
+  if (const int spoofed =
+          fingerbrowser::IntSwitch(fingerbrowser::kScreenWidthSwitch);
+      spoofed > 0) {
+    return spoofed;
+  }
   if (!DomWindow())
     return 0;
   return GetRect(/*available=*/false).width();
@@ -132,12 +154,22 @@ int Screen::availTop() const {
 }
 
 int Screen::availHeight() const {
+  if (const int spoofed =
+          fingerbrowser::IntSwitch(fingerbrowser::kScreenHeightSwitch);
+      spoofed > 0) {
+    return std::max(1, spoofed - kFingerBrowserTaskbarHeight);
+  }
   if (!DomWindow())
     return 0;
   return GetRect(/*available=*/true).height();
 }
 
 int Screen::availWidth() const {
+  if (const int spoofed =
+          fingerbrowser::IntSwitch(fingerbrowser::kScreenWidthSwitch);
+      spoofed > 0) {
+    return spoofed;
+  }
   if (!DomWindow())
     return 0;
   return GetRect(/*available=*/true).width();
