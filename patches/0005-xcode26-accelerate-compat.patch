+ * Use of this source code is governed by a BSD-style license that can be
+ * found in the LICENSE file.
+ */
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_AUDIO_MAC_ACCELERATE_COMPAT_MAC_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_AUDIO_MAC_ACCELERATE_COMPAT_MAC_H_
+
+#include "build/build_config.h"
+
+#if BUILDFLAG(IS_MAC)
+
+#if defined(__clang__)
+#ifndef __has_builtin
+#define __has_builtin(x) 0
+#define BLINK_ACCELERATE_COMPAT_UNDEF_HAS_BUILTIN
+#endif
+
+#ifndef __has_feature
+#define __has_feature(x) 0
+#define BLINK_ACCELERATE_COMPAT_UNDEF_HAS_FEATURE
+#endif
+
+// Xcode 26 SDK headers use newer clang availability grammar and builtins than
+// Chromium 124's bundled clang understands.
+#if !__has_builtin(__builtin_verbose_trap)
+#define __builtin_verbose_trap(category, reason) __builtin_trap()
+#define BLINK_ACCELERATE_COMPAT_UNDEF_VERBOSE_TRAP
+#endif
+
+#if !__has_feature(availability_visionos)
+#define __builtin_available(...) (true)
+#define BLINK_ACCELERATE_COMPAT_UNDEF_BUILTIN_AVAILABLE
+#endif
+#endif  // defined(__clang__)
+
+#include <Accelerate/Accelerate.h>
+
+#if defined(BLINK_ACCELERATE_COMPAT_UNDEF_BUILTIN_AVAILABLE)
+#undef __builtin_available
+#undef BLINK_ACCELERATE_COMPAT_UNDEF_BUILTIN_AVAILABLE
+#endif
+
+#if defined(BLINK_ACCELERATE_COMPAT_UNDEF_VERBOSE_TRAP)
+#undef __builtin_verbose_trap
+#undef BLINK_ACCELERATE_COMPAT_UNDEF_VERBOSE_TRAP
+#endif
+
+#if defined(BLINK_ACCELERATE_COMPAT_UNDEF_HAS_FEATURE)
+#undef __has_feature
+#undef BLINK_ACCELERATE_COMPAT_UNDEF_HAS_FEATURE
+#endif
+
+#if defined(BLINK_ACCELERATE_COMPAT_UNDEF_HAS_BUILTIN)
+#undef __has_builtin
+#undef BLINK_ACCELERATE_COMPAT_UNDEF_HAS_BUILTIN
+#endif
+
+#endif  // BUILDFLAG(IS_MAC)
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_AUDIO_MAC_ACCELERATE_COMPAT_MAC_H_
