+
+namespace fingerbrowser {
+namespace {
+
+base::FilePath WritePolicy(base::ScopedTempDir* temp_dir,
+                           const std::string& body) {
+  CHECK(temp_dir->CreateUniqueTempDir());
+  const base::FilePath path =
+      temp_dir->GetPath().AppendASCII("fingerbrowser_policy.json");
+  CHECK(base::WriteFile(path, body));
+  return path;
+}
+
+TEST(FingerBrowserPolicyTest, LoadsValidPolicy) {
+  base::ScopedTempDir temp_dir;
+  const base::FilePath path = WritePolicy(
+      &temp_dir,
+      R"({
+        "schemaVersion": 1,
+        "profileId": "profile-1",
+        "runtimeChannel": "custom-kernel",
+        "fingerprintPolicy": {
+          "locale": "zh-CN",
+          "timezone": "America/Chicago",
+          "windowSize": { "width": 1360, "height": 900 },
+          "permissionDefaults": "deny",
+          "webrtcIpPolicy": "disable_non_proxied_udp"
+        }
+      })");
+
+  const std::optional<FingerBrowserPolicy> policy =
+      LoadFingerBrowserPolicy(path);
+
+  ASSERT_TRUE(policy.has_value());
+  EXPECT_EQ("profile-1", policy->profile_id);
+  EXPECT_EQ("zh-CN", policy->locale);
+  EXPECT_EQ("America/Chicago", policy->timezone);
+  EXPECT_EQ(1360, policy->window_width);
+  EXPECT_EQ(900, policy->window_height);
+  EXPECT_EQ("deny", policy->permission_defaults);
+  EXPECT_EQ("disable_non_proxied_udp", policy->webrtc_ip_policy);
+}
+
+TEST(FingerBrowserPolicyTest, RejectsSensitiveKeys) {
+  base::ScopedTempDir temp_dir;
+  const base::FilePath path = WritePolicy(
+      &temp_dir,
+      R"({
+        "schemaVersion": 1,
+        "profileId": "profile-1",
+        "runtimeChannel": "custom-kernel",
+        "fingerprintPolicy": {
+          "locale": "zh-CN",
+          "timezone": "America/Chicago",
+          "windowSize": { "width": 1360, "height": 900 },
+          "permissionDefaults": "deny",
+          "webrtcIpPolicy": "disable_non_proxied_udp",
+          "proxyPassword": "secret"
+        }
+      })");
+
+  EXPECT_FALSE(LoadFingerBrowserPolicy(path).has_value());
+}
+
+TEST(FingerBrowserPolicyTest, RejectsInvalidTimezone) {
+  base::ScopedTempDir temp_dir;
+  const base::FilePath path = WritePolicy(
+      &temp_dir,
+      R"({
+        "schemaVersion": 1,
+        "profileId": "profile-1",
+        "runtimeChannel": "custom-kernel",
+        "fingerprintPolicy": {
+          "locale": "zh-CN",
+          "timezone": "Mars/Colony",
+          "windowSize": { "width": 1360, "height": 900 },
+          "permissionDefaults": "deny",
+          "webrtcIpPolicy": "disable_non_proxied_udp"
+        }
+      })");
+
+  EXPECT_FALSE(LoadFingerBrowserPolicy(path).has_value());
+}
+
+TEST(FingerBrowserPolicyTest, AppliesPolicyToCommandLine) {
+  base::test::ScopedCommandLine scoped_command_line;
+  base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  FingerBrowserPolicy policy;
+  policy.profile_id = "profile-1";
+  policy.locale = "zh-CN";
+  policy.timezone = "America/Chicago";
+  policy.window_width = 1360;
+  policy.window_height = 900;
+  policy.permission_defaults = "deny";
+  policy.webrtc_ip_policy = "disable_non_proxied_udp";
+
+  ApplyFingerBrowserPolicy(policy, command_line);
+
+  EXPECT_EQ("zh-CN", command_line->GetSwitchValueASCII(switches::kLang));
+  EXPECT_EQ("1360,900",
+            command_line->GetSwitchValueASCII(switches::kWindowSize));
+  EXPECT_TRUE(command_line->HasSwitch(
+      permissions::switches::kDenyPermissionPrompts));
+  EXPECT_EQ("disable_non_proxied_udp",
+            command_line->GetSwitchValueASCII(
+                switches::kForceWebRtcIPHandlingPolicy));
+}
