@@ -0,0 +1,90 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_FINGERBROWSER_FINGERBROWSER_POLICY_H_
+#define CHROME_BROWSER_FINGERBROWSER_FINGERBROWSER_POLICY_H_
+
+#include <optional>
+#include <string>
+
+#include "base/files/file_path.h"
+
+namespace base {
+class CommandLine;
+}
+
+namespace fingerbrowser {
+
+struct FingerBrowserPolicy {
+  FingerBrowserPolicy();
+  FingerBrowserPolicy(const FingerBrowserPolicy&);
+  FingerBrowserPolicy& operator=(const FingerBrowserPolicy&);
+  ~FingerBrowserPolicy();
+
+  std::string profile_id;
+  std::string locale;
+  std::string timezone;
+  int window_width = 0;
+  int window_height = 0;
+  std::string permission_defaults;
+  std::string webrtc_ip_policy;
+
+  // Optional L2 hardware profile (anti-detect). Empty/zero == not set, in
+  // which case the renderer keeps the genuine value. Parsed from an optional
+  // "hardwareProfile" dict inside "fingerprintPolicy".
+  // Product brand for the Client Hints brand list, e.g. "Google Chrome".
+  // Unbranded Chromium builds omit it entirely, leaving a list that never
+  // mentions the product the UA string claims to be.
+  std::string brand;
+  std::string gpu_vendor;
+  std::string gpu_renderer;
+  // WebGPU reports a different vocabulary than WebGL (lowercase "nvidia" /
+  // "ampere" rather than "Google Inc. (NVIDIA)"), so it needs its own values
+  // instead of reusing the WebGL strings.
+  std::string webgpu_vendor;
+  std::string webgpu_architecture;
+  std::string webgpu_device;
+  std::string webgpu_description;
+  std::string platform;
+  int hardware_concurrency = 0;
+  int device_memory = 0;
+  int canvas_noise_seed = 0;
+  int audio_noise_seed = 0;
+
+  // screen.width/height。--window-size 只影响浏览器窗口，网站读到的仍是宿主
+  // 真实分辨率，必须单独伪装。
+  // Client Hints 的 platformVersion（Windows 上是 WinRT API Contract 版本，
+  // 如 "15.0.0"）。为空则保持宿主真实值 —— 合理取值取决于人格声称的 Windows
+  // 版本，内核无从判断，猜一个可能同样罕见。
+  std::string platform_version;
+  int screen_width = 0;
+  int screen_height = 0;
+  // devicePixelRatio × 1000（1000 = 1.0）。0 表示未配置，此时若伪装了 screen.*
+  // 会按 1.0 兜底——普通桌面屏几乎总是 1，而沿用宿主真实值必然与伪装后的
+  // screen.* 矛盾（宿主 4K@175% 时 DPR=1.75，媒体查询宽度算出 2195 而非 1920）。
+  int device_pixel_ratio_x1000 = 0;
+  // navigator.maxTouchPoints。0 是桌面人格的正确值，也是最常见的取值，故用单独
+  // 的标志位区分「配了 0」与「没配」——用值本身判断会把前者读成后者。
+  bool has_max_touch_points = false;
+  int max_touch_points = 0;
+  // 经纬度以 1e6 倍整数保存，0 表示未配置（用 has_geo 区分真实的 0 坐标）。
+  bool has_geo = false;
+  // Report CJK font families as unavailable (for a non-CJK persona whose host
+  // has Chinese/Japanese/Korean fonts installed).
+  bool block_cjk_fonts = false;
+  int geo_latitude_e6 = 0;
+  int geo_longitude_e6 = 0;
+};
+
+std::optional<FingerBrowserPolicy> LoadFingerBrowserPolicy(
+    const base::FilePath& policy_path);
+
+void ApplyFingerBrowserPolicy(const FingerBrowserPolicy& policy,
+                              base::CommandLine* command_line);
+
+bool ApplyFingerBrowserPolicyFromCommandLine(base::CommandLine* command_line);
+
+}  // namespace fingerbrowser
+
+#endif  // CHROME_BROWSER_FINGERBROWSER_FINGERBROWSER_POLICY_H_
