diff --git a/third_party/blink/renderer/platform/fingerbrowser/fingerbrowser_fingerprint.h b/third_party/blink/renderer/platform/fingerbrowser/fingerbrowser_fingerprint.h
new file mode 100644
index 0000000000..e6e26c7592
--- /dev/null
+++ b/third_party/blink/renderer/platform/fingerbrowser/fingerbrowser_fingerprint.h
@@ -0,0 +1,242 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// FingerBrowser L2 fingerprint helpers (renderer-side).
+//
+// Header-only. Each spoof seam (navigator / WebGL / canvas / audio) reads its
+// per-profile value from a command-line switch that the browser process
+// appended from the FingerBrowser policy (see
+// chrome/browser/fingerbrowser/fingerbrowser_policy.cc) and that
+// content/browser/renderer_host/render_process_host_impl.cc propagates to the
+// renderer. The switch names below MUST match those two files exactly.
+//
+// Noise is deterministic from a per-profile seed (mulberry32), so a given
+// profile produces a stable-but-unique fingerprint: same profile + same input
+// -> same output; different profile (different seed) -> different output.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_FINGERBROWSER_FINGERBROWSER_FINGERPRINT_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_FINGERBROWSER_FINGERBROWSER_FINGERPRINT_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+
+#include "base/command_line.h"
+#include "base/strings/string_number_conversions.h"
+
+namespace blink {
+namespace fingerbrowser {
+
+// Switch names — keep in sync with the browser-side emitter and propagator.
+inline constexpr char kGpuVendorSwitch[] = "fp-gpu-vendor";
+inline constexpr char kGpuRendererSwitch[] = "fp-gpu-renderer";
+inline constexpr char kPlatformSwitch[] = "fp-platform";
+inline constexpr char kHardwareConcurrencySwitch[] = "fp-hardware-concurrency";
+inline constexpr char kDeviceMemorySwitch[] = "fp-device-memory";
+inline constexpr char kCanvasNoiseSwitch[] = "fp-canvas-noise";
+inline constexpr char kAudioNoiseSwitch[] = "fp-audio-noise";
+// Renderer-side timezone / Accept-Language overrides. The browser process also
+// sets ICU's default zone and --lang, but those only affect the browser
+// process: Intl/Date and navigator.language are evaluated in the renderer,
+// which has its own ICU instance and reads Accept-Language, so the values have
+// to be propagated here explicitly.
+inline constexpr char kTimezoneSwitch[] = "fp-timezone";
+inline constexpr char kAcceptLangSwitch[] = "fp-accept-lang";
+// screen.* 与窗口尺寸是两回事：--window-size 只改浏览器窗口，网站读到的
+// screen.width/height 仍是宿主真实分辨率，两者不一致本身就是可检测特征。
+inline constexpr char kScreenWidthSwitch[] = "fp-screen-width";
+inline constexpr char kScreenHeightSwitch[] = "fp-screen-height";
+// devicePixelRatio。以 1000 倍整数传递（同经纬度，避免浮点字符串的本地化问题）：
+// 1000 = 1.0，1500 = 1.5。
+//
+// 不伪装它的后果不是「少伪装一项」，而是**制造矛盾**：宿主 4K + 175% 缩放时
+// DPR 报 1.75，而媒体查询的 device-width 是物理宽 ÷ DPR = 3840/1.75 ≈ 2195，
+// 与伪装成 1920 的 screen.width 对不上。检测方看到的不是一个普通用户，而是
+// 「有人动过手脚」——阳性证据，比单纯泄漏真实值严重。
+//
+// 实测该症状在本内核上确实出现（probe/run-124-audit.cjs：2195 vs 1920、DPR 1.75）。
+inline constexpr char kDevicePixelRatioX1000Switch[] = "fp-dpr-x1000";
+// navigator.maxTouchPoints。宿主带触摸屏时它是 10，而 ontouchstart 不存在、
+// pointer:coarse 为否——这三者本该同进同退，对不上同样是阳性证据。
+// 传 0 表示无触摸（桌面人格）。
+inline constexpr char kMaxTouchPointsSwitch[] = "fp-max-touch-points";
+inline constexpr char kDoNotTrackSwitch[] = "fp-do-not-track";
+// 经纬度以 1e6 倍整数传递（命令行开关只走整数解析，避免浮点字符串的本地化问题）。
+inline constexpr char kGeoLatitudeE6Switch[] = "fp-geo-lat-e6";
+inline constexpr char kGeoLongitudeE6Switch[] = "fp-geo-lon-e6";
+
+// WebRTC IP handling policy (e.g. "disable_non_proxied_udp"). This must be a
+// renderer switch, not just a pref: Chromium reads the policy from a renderer
+// preference (webrtc_ip_handling_policy) that is populated from the
+// kWebRTCIPHandlingPolicy pref, and the browser-process command line never
+// sets that pref -- so the renderer sees an empty string, falls back to
+// kDefault, and enable_nonproxied_udp stays true. The result is a STUN
+// reflexive candidate that leaks the host's real public IP even when HTTP
+// traffic exits through a proxy in another country. Reading this switch
+// directly in the peer-connection factory forces the policy regardless of the
+// pref plumbing.
+inline constexpr char kWebRtcIpPolicySwitch[] = "fp-webrtc-ip-policy";
+
+// When present, explicit page requests for CJK font families report as
+// unavailable. A non-CJK persona (en-US, de-DE, …) running on a machine with
+// Chinese/Japanese/Korean fonts installed leaks its true region through
+// measurement-based font enumeration (canvas measureText of "SomeFont, monospace"
+// differs from the fallback iff the font is installed). This only blocks the
+// explicit-family path (FontCache::CreateFontPlatformData); glyph rendering for
+// CJK text still works because it goes through the DirectWrite system fallback
+// (PlatformFallbackFontForCharacter), a different entry point.
+inline constexpr char kBlockCjkFontsSwitch[] = "fp-block-cjk-fonts";
+
+// WebGPU adapter identity. Separate from the WebGL switches because the two
+// APIs use different vocabularies: WebGL reports "Google Inc. (NVIDIA)" and an
+// ANGLE renderer string, while WebGPU reports lowercase tokens ("nvidia",
+// "ampere"). Spoofing only WebGL leaves the two APIs contradicting each other
+// within a single page, which is a stronger signal than not spoofing at all.
+inline constexpr char kWebGpuVendorSwitch[] = "fp-webgpu-vendor";
+inline constexpr char kWebGpuArchitectureSwitch[] = "fp-webgpu-architecture";
+inline constexpr char kWebGpuDeviceSwitch[] = "fp-webgpu-device";
+inline constexpr char kWebGpuDescriptionSwitch[] = "fp-webgpu-description";
+
+inline std::string SwitchValue(const char* name) {
+  const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+  return cmd->HasSwitch(name) ? cmd->GetSwitchValueASCII(name) : std::string();
+}
+
+inline int IntSwitch(const char* name) {
+  const std::string value = SwitchValue(name);
+  int parsed = 0;
+  return (!value.empty() && base::StringToInt(value, &parsed)) ? parsed : 0;
+}
+
+// 用于合法值包含 0 的开关。此前所有整数开关都靠「值 > 0」判断是否接管，那对
+// screen 宽高、DPR 成立（0 无意义），但对 maxTouchPoints 不成立 —— 0 恰恰是
+// 桌面人格最该传的值，用 IntSwitch 判会把「明确要求无触摸」读成「没配置」。
+inline bool HasSwitch(const char* name) {
+  return base::CommandLine::ForCurrentProcess()->HasSwitch(name);
+}
+
+inline uint32_t CanvasSeed() {
+  return static_cast<uint32_t>(IntSwitch(kCanvasNoiseSwitch));
+}
+
+inline uint32_t AudioSeed() {
+  return static_cast<uint32_t>(IntSwitch(kAudioNoiseSwitch));
+}
+
+// Minimum canvas area (in pixels) to noise. Real fingerprinting reads rendered
+// content — text, gradients — from canvases well above this. Tiny canvases are
+// how noise detectors probe the readback path: CreepJS getPixelMods writes
+// known data to an 8x8 canvas via putImageData and flags any difference on
+// getImageData, and putImageData->getImageData is lossless on a real browser.
+// Gating on the SOURCE CANVAS size (not the read region) keeps that round-trip
+// lossless on small buffers while a small sub-read of a large canvas still gets
+// noised, preserving the coordinate consistency from the canvas-readback patch.
+inline constexpr int64_t kMinCanvasNoisePixels = 1024;
+
+// mulberry32 — small, fast, deterministic PRNG.
+inline uint32_t NextRandom(uint32_t& state) {
+  state += 0x6D2B79F5u;
+  uint32_t t = state;
+  t = (t ^ (t >> 15)) * (t | 1u);
+  t ^= t + (t ^ (t >> 7)) * (t | 61u);
+  return t ^ (t >> 14);
+}
+
+// Perturb ~3% of each color channel by +/-1, deterministically. Alpha (the 4th
+// byte of each pixel) is left untouched so the change stays imperceptible.
+// Deterministic hash of (seed, x, y). Finalizer-style mixing so that adjacent
+// coordinates do not produce correlated output.
+inline uint32_t PixelHash(uint32_t seed, int32_t x, int32_t y) {
+  uint32_t h = seed;
+  h ^= static_cast<uint32_t>(x) * 0x9E3779B1u;
+  h = (h ^ (h >> 15)) * 0x85EBCA6Bu;
+  h ^= static_cast<uint32_t>(y) * 0xC2B2AE35u;
+  h = (h ^ (h >> 13)) * 0xC2B2AE35u;
+  return h ^ (h >> 16);
+}
+
+// Perturb a pixel block, keying the noise on each pixel's ABSOLUTE canvas
+// coordinate rather than on its offset within the returned buffer.
+//
+// This distinction is load-bearing. A buffer-offset-keyed stream gives the same
+// canvas pixel different noise depending on the shape of the read that returned
+// it, so getImageData(sx, sy, w, h) disagrees with getImageData(0, 0, W, H) for
+// the pixels they share. That breaks legitimate partial-readback image
+// processing (measured: 59 mismatched bytes over a 20x20 sub-read). Keying on
+// absolute coordinates makes every read of a given pixel agree, which is a
+// correctness requirement for the canvas API independent of any defense goal.
+inline void PerturbPixelsAt(uint8_t* data,
+                            size_t byte_length,
+                            uint32_t seed,
+                            int bytes_per_pixel,
+                            size_t row_bytes,
+                            int32_t width,
+                            int32_t height,
+                            int32_t origin_x,
+                            int32_t origin_y) {
+  if (!data || !seed || bytes_per_pixel < 3 || width <= 0 || height <= 0) {
+    return;
+  }
+  const int color_channels = bytes_per_pixel >= 4 ? 3 : bytes_per_pixel;
+  for (int32_t row = 0; row < height; ++row) {
+    const size_t row_offset = static_cast<size_t>(row) * row_bytes;
+    if (row_offset >= byte_length) {
+      break;
+    }
+    for (int32_t col = 0; col < width; ++col) {
+      const size_t i =
+          row_offset + static_cast<size_t>(col) *
+                           static_cast<size_t>(bytes_per_pixel);
+      if (i + static_cast<size_t>(bytes_per_pixel) > byte_length) {
+        break;
+      }
+      // One hash per pixel, sliced into per-channel fields, rather than one
+      // hash per channel. Hashing each channel separately cost four PixelHash
+      // calls per pixel (~16 multiplies) and made getImageData 5-10x slower;
+      // on canvas-heavy pages that was enough to stall rendering outright.
+      // Small test canvases hid this -- the cost only shows at real sizes.
+      //
+      // Layout: bits 0-7, 8-15, 16-23 carry each channel's probability field,
+      // bits 24-26 carry its sign. 27 bits used of 32, no overlap.
+      const uint32_t h = PixelHash(seed, origin_x + col, origin_y + row);
+      for (int channel = 0; channel < color_channels; ++channel) {
+        if (((h >> (channel * 8)) & 0xFFu) < 8u) {  // ~3.1% of channels
+          const int delta = (h & (1u << (24 + channel))) ? 1 : -1;
+          const int value = static_cast<int>(data[i + channel]) + delta;
+          data[i + channel] =
+              static_cast<uint8_t>(value < 0 ? 0 : (value > 255 ? 255 : value));
+        }
+      }
+    }
+  }
+}
+
+// Add an inaudible deterministic perturbation to float audio samples. Used by
+// the offline-render audio seam (Build 2); harmless if unreferenced.
+inline void PerturbAudio(float* data, size_t count, uint32_t seed) {
+  if (!data || !seed) {
+    return;
+  }
+  // Key the perturbation on each sample's VALUE, not its position. A
+  // position-sequential PRNG gave every sample an independent nudge, which
+  // destroyed the duplicate sample values a real render naturally has: measured
+  // unique-sample count jumped from ~4736/5000 to a maxed-out 5000/5000, a
+  // signature detectors read (CreepJS reports it as "unique"). Hashing the
+  // sample value means equal samples get equal noise and stay equal, so the
+  // duplicate structure is preserved while the fingerprint still shifts
+  // deterministically per profile.
+  for (size_t i = 0; i < count; ++i) {
+    uint32_t bits = 0;
+    static_assert(sizeof(bits) == sizeof(float), "float must be 32-bit");
+    __builtin_memcpy(&bits, &data[i], sizeof(bits));
+    const uint32_t h = PixelHash(seed, static_cast<int32_t>(bits), 0);
+    const float unit = static_cast<float>(h & 0xFFFFu) / 65535.0f - 0.5f;
+    data[i] += unit * 2e-7f;
+  }
+}
