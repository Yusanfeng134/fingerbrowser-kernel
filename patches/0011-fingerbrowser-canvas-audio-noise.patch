 .../canvas2d/base_rendering_context_2d.cc     | 25 +++++++++++++
 .../modules/webaudio/offline_audio_context.cc | 19 ++++++++++
 .../platform/graphics/image_data_buffer.cc    | 36 +++++++++++++++++--
 3 files changed, 77 insertions(+), 3 deletions(-)

diff --git a/third_party/blink/renderer/modules/canvas/canvas2d/base_rendering_context_2d.cc b/third_party/blink/renderer/modules/canvas/canvas2d/base_rendering_context_2d.cc
index 7626ccf7bd..df9efb2487 100644
--- a/third_party/blink/renderer/modules/canvas/canvas2d/base_rendering_context_2d.cc
+++ b/third_party/blink/renderer/modules/canvas/canvas2d/base_rendering_context_2d.cc
@@ -12,6 +12,7 @@
 
 #include "base/check_deref.h"
 #include "base/logging.h"
+#include "third_party/blink/renderer/platform/fingerbrowser/fingerbrowser_fingerprint.h"
 #include "base/memory/scoped_refptr.h"
 #include "base/metrics/histogram_functions.h"
 #include "base/metrics/histogram_macros.h"
@@ -2491,6 +2492,30 @@ ImageData* BaseRenderingContext2D::getImageDataInternal(
     }
   }
 
+  // FingerBrowser L2: deterministic readback noise (canvas fingerprint
+  // defense). No-op unless a per-profile seed switch is present.
+  if (const uint32_t fb_seed = fingerbrowser::CanvasSeed()) {
+    // Gate on the source canvas size, not the read region: a small sub-read of
+    // a large canvas must still be noised (to stay consistent with a full
+    // read), while a genuinely small canvas — as used by putImageData round-
+    // trip noise detectors — is left lossless.
+    const int64_t canvas_pixels =
+        snapshot ? static_cast<int64_t>(snapshot->Size().width()) *
+                       snapshot->Size().height()
+                 : 0;
+    SkPixmap fb_pixmap = image_data->GetSkPixmap();
+    if (fb_pixmap.addr() &&
+        canvas_pixels >= fingerbrowser::kMinCanvasNoisePixels) {
+      // Key on absolute canvas coordinates (sx, sy), not buffer offset, so a
+      // partial read and a full read agree on the pixels they share.
+      fingerbrowser::PerturbPixelsAt(
+          static_cast<uint8_t*>(fb_pixmap.writable_addr()),
+          fb_pixmap.computeByteSize(), fb_seed,
+          fb_pixmap.info().bytesPerPixel(), fb_pixmap.rowBytes(),
+          fb_pixmap.width(), fb_pixmap.height(), sx, sy);
+    }
+  }
+
   return image_data;
 }
 
diff --git a/third_party/blink/renderer/modules/webaudio/offline_audio_context.cc b/third_party/blink/renderer/modules/webaudio/offline_audio_context.cc
index 9aad422c44..859f302c86 100644
--- a/third_party/blink/renderer/modules/webaudio/offline_audio_context.cc
+++ b/third_party/blink/renderer/modules/webaudio/offline_audio_context.cc
@@ -35,7 +35,10 @@
 #include "third_party/blink/renderer/core/frame/local_dom_window.h"
 #include "third_party/blink/renderer/modules/webaudio/audio_listener.h"
 #include "third_party/blink/renderer/modules/webaudio/deferred_task_handler.h"
+#include "third_party/blink/renderer/core/typed_arrays/dom_typed_array.h"
+#include "third_party/blink/renderer/modules/webaudio/audio_buffer.h"
 #include "third_party/blink/renderer/modules/webaudio/offline_audio_completion_event.h"
+#include "third_party/blink/renderer/platform/fingerbrowser/fingerbrowser_fingerprint.h"
 #include "third_party/blink/renderer/modules/webaudio/offline_audio_destination_node.h"
 #include "third_party/blink/renderer/platform/audio/audio_utilities.h"
 #include "third_party/blink/renderer/platform/bindings/exception_messages.h"
@@ -370,6 +373,22 @@ void OfflineAudioContext::FireCompletionEvent() {
       return;
     }
 
+    // FingerBrowser L2: deterministic noise on the offline-rendered result
+    // (the audio-fingerprint vector that fingerprintjs/creepjs read). Safe
+    // here: this is one-shot render output handed to JS, not live playback, so
+    // AudioBuffer.getChannelData stays untouched/native. No-op unless a
+    // per-profile seed switch is present.
+    if (const uint32_t fb_audio_seed = fingerbrowser::AudioSeed()) {
+      for (unsigned fb_ch = 0; fb_ch < rendered_buffer->numberOfChannels();
+           ++fb_ch) {
+        DOMFloat32Array* fb_data = rendered_buffer->getChannelData(fb_ch).Get();
+        if (fb_data) {
+          fingerbrowser::PerturbAudio(fb_data->Data(), fb_data->length(),
+                                      fb_audio_seed + fb_ch);
+        }
+      }
+    }
+
     // Call the offline rendering completion event listener and resolve the
     // promise too.
     DispatchEvent(*OfflineAudioCompletionEvent::Create(rendered_buffer));
diff --git a/third_party/blink/renderer/platform/graphics/image_data_buffer.cc b/third_party/blink/renderer/platform/graphics/image_data_buffer.cc
index 16875cc89c..114639f181 100644
--- a/third_party/blink/renderer/platform/graphics/image_data_buffer.cc
+++ b/third_party/blink/renderer/platform/graphics/image_data_buffer.cc
@@ -36,12 +36,14 @@
 
 #include "base/compiler_specific.h"
 #include "base/memory/ptr_util.h"
+#include "third_party/blink/renderer/platform/fingerbrowser/fingerbrowser_fingerprint.h"
 #include "third_party/blink/renderer/platform/graphics/static_bitmap_image.h"
 #include "third_party/blink/renderer/platform/image-encoders/image_encoder.h"
 #include "third_party/blink/renderer/platform/runtime_enabled_features.h"
 #include "third_party/blink/renderer/platform/wtf/text/base64.h"
 #include "third_party/blink/renderer/platform/wtf/text/wtf_string.h"
 #include "third_party/blink/renderer/platform/wtf/vector.h"
+#include "third_party/skia/include/core/SkBitmap.h"
 #include "third_party/skia/include/core/SkImage.h"
 #include "third_party/skia/include/core/SkSurface.h"
 #include "third_party/skia/include/core/SkSwizzle.h"
@@ -146,6 +148,34 @@ bool ImageDataBuffer::EncodeImageInternal(const ImageEncodingMimeType mime_type,
                                           const SkPixmap& pixmap) const {
   DCHECK(is_valid_);
 
+  // FingerBrowser L2: deterministic canvas noise. toDataURL and toBlob both
+  // funnel through here, so noising a copy here covers both while leaving the
+  // source pixmap (and any other readers) untouched. No-op unless a per-profile
+  // seed switch is present.
+  SkBitmap fb_noised;
+  SkPixmap fb_noised_pixmap;
+  const SkPixmap* active_pixmap = &pixmap;
+  // This path encodes the whole canvas, so the pixmap area is the canvas size;
+  // gate it the same way as the getImageData seam so small canvases stay
+  // unnoised and consistent between the two paths.
+  const int64_t encode_pixels =
+      static_cast<int64_t>(pixmap.width()) * pixmap.height();
+  if (const uint32_t fb_seed = fingerbrowser::CanvasSeed();
+      fb_seed && encode_pixels >= fingerbrowser::kMinCanvasNoisePixels &&
+      pixmap.addr() && fb_noised.tryAllocPixels(pixmap.info()) &&
+      pixmap.readPixels(fb_noised.pixmap()) &&
+      fb_noised.peekPixels(&fb_noised_pixmap)) {
+    // Origin (0, 0): this path always encodes the whole canvas. Sharing the
+    // coordinate-keyed function with the getImageData seam means toDataURL and
+    // getImageData report the same value for the same pixel.
+    fingerbrowser::PerturbPixelsAt(
+        static_cast<uint8_t*>(fb_noised_pixmap.writable_addr()),
+        fb_noised_pixmap.computeByteSize(), fb_seed,
+        fb_noised_pixmap.info().bytesPerPixel(), fb_noised_pixmap.rowBytes(),
+        fb_noised_pixmap.width(), fb_noised_pixmap.height(), 0, 0);
+    active_pixmap = &fb_noised_pixmap;
+  }
+
   if (mime_type == kMimeTypeJpeg) {
     SkJpegEncoder::Options options;
     options.fQuality = ImageEncoder::ComputeJpegQuality(quality);
@@ -153,19 +183,19 @@ bool ImageDataBuffer::EncodeImageInternal(const ImageEncodingMimeType mime_type,
     if (options.fQuality == 100) {
       options.fDownsample = SkJpegEncoder::Downsample::k444;
     }
-    return ImageEncoder::Encode(encoded_image, pixmap, options);
+    return ImageEncoder::Encode(encoded_image, *active_pixmap, options);
   }
 
   if (mime_type == kMimeTypeWebp) {
     SkWebpEncoder::Options options = ImageEncoder::ComputeWebpOptions(quality);
-    return ImageEncoder::Encode(encoded_image, pixmap, options);
+    return ImageEncoder::Encode(encoded_image, *active_pixmap, options);
   }
 
   DCHECK_EQ(mime_type, kMimeTypePng);
   SkPngEncoder::Options options;
   options.fFilterFlags = SkPngEncoder::FilterFlag::kSub;
   options.fZLibLevel = 3;
-  return ImageEncoder::Encode(encoded_image, pixmap, options);
+  return ImageEncoder::Encode(encoded_image, *active_pixmap, options);
 }
 
 String ImageDataBuffer::ToDataURL(const ImageEncodingMimeType mime_type,
