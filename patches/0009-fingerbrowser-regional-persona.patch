 namespace blink {
 
+namespace {
+
+// Returns true if an explicit request for `family` should report as
+// unavailable under the CJK-font block (see kBlockCjkFontsSwitch). Placed on
+// the explicit-family lookup (GetFontData / IsPlatformFamilyMatchAvailable),
+// NOT on the shared GetFontPlatformData/CreateFontPlatformData path, because
+// the system glyph fallback (GetDWriteFallbackFamily) also flows through the
+// latter -- blocking there rendered CJK text as tofu. The fallback bypasses
+// GetFontData, so CJK text still renders while enumeration sees the fonts as
+// absent. Matches common English names plus the most frequent native names.
+bool FingerBrowserIsBlockedCjkFont(const AtomicString& family) {
+  static const base::CommandLine* cmd =
+      base::CommandLine::ForCurrentProcess();
+  if (!cmd->HasSwitch(fingerbrowser::kBlockCjkFontsSwitch)) {
+    return false;
+  }
+  DEFINE_STATIC_LOCAL(
+      const Vector<AtomicString>, blocked,
+      ({// Chinese (Simplified)
+        AtomicString("Microsoft YaHei"), AtomicString("Microsoft YaHei UI"),
+        AtomicString(u"微软雅黑"), AtomicString("SimSun"),
+        AtomicString("NSimSun"), AtomicString(u"宋体"),
+        AtomicString("SimHei"), AtomicString(u"黑体"), AtomicString("KaiTi"),
+        AtomicString("FangSong"), AtomicString("DengXian"),
+        AtomicString(u"等线"),
+        // Chinese (Traditional)
+        AtomicString("Microsoft JhengHei"),
+        AtomicString("Microsoft JhengHei UI"), AtomicString(u"微軟正黑體"),
+        AtomicString("PMingLiU"), AtomicString("MingLiU"),
+        AtomicString("DFKai-SB"),
+        // Japanese
+        AtomicString("Meiryo"), AtomicString("Meiryo UI"),
+        AtomicString(u"メイリオ"), AtomicString("MS Gothic"),
+        AtomicString("MS PGothic"), AtomicString("MS Mincho"),
+        AtomicString("MS PMincho"), AtomicString("Yu Gothic"),
+        AtomicString("Yu Gothic UI"), AtomicString("Yu Mincho"),
+        AtomicString(u"游ゴシック"),
+        // Korean
+        AtomicString("Malgun Gothic"), AtomicString(u"맑은 고딕"),
+        AtomicString("Gulim"), AtomicString("Dotum"), AtomicString("Batang"),
+        AtomicString("Gungsuh")}));
+  for (const AtomicString& name : blocked) {
+    if (EqualIgnoringASCIICase(family, name)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace
+
 const char kColorEmojiLocale[] = "und-Zsye";
 
