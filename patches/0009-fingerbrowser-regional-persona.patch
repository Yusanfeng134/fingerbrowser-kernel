@@ -114,6 +117,36 @@ void TimeZoneController::Init() {
   Platform::Current()->GetBrowserInterfaceBroker()->GetInterface(
       monitor.BindNewPipeAndPassReceiver());
   monitor->AddClient(instance().receiver_.BindNewPipeAndPassRemote());
+
+  // FingerBrowser L2: apply the per-profile timezone inside this renderer.
+  // The browser process calls icu::TimeZone::adoptDefault(), but that is
+  // per-process and tzset() is POSIX-only, so on Windows Intl/Date here would
+  // otherwise keep reporting the host zone. Going through
+  // SetTimeZoneOverride() also notifies V8 so its date cache is invalidated.
+  // The handle is released on purpose: ~TimeZoneOverride() would clear the
+  // override, and this one must last for the life of the renderer.
+  const std::string fb_timezone =
+      fingerbrowser::SwitchValue(fingerbrowser::kTimezoneSwitch);
+  if (!fb_timezone.empty()) {
+    (void)SetTimeZoneOverride(String::FromUTF8(fb_timezone)).release();
+  }
+
+  // FingerBrowser L2: override the ICU default locale so Intl reports the
+  // profile locale, not the host's. V8 reads icu::Locale::getDefault() lazily
+  // on first Intl use (Isolate::DefaultLocale()); setting it here at blink
+  // init — before any page script runs — makes
+  // Intl.DateTimeFormat().resolvedOptions().locale agree with
+  // navigator.language. --lang sets the UI locale but not this.
+  const std::string fb_lang =
+      fingerbrowser::SwitchValue(fingerbrowser::kAcceptLangSwitch);
+  if (!fb_lang.empty()) {
+    UErrorCode status = U_ZERO_ERROR;
+    icu::Locale fb_locale = icu::Locale::forLanguageTag(
+        icu::StringPiece(fb_lang.data(), fb_lang.size()), status);
+    if (U_SUCCESS(status) && !fb_locale.isBogus()) {
+      icu::Locale::setDefault(fb_locale, status);
+    }
+  }
 }
 
