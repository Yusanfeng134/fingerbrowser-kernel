+      "fp-webgpu-architecture",
+      "fp-webgpu-device",
+      "fp-webgpu-description",
       "fp-platform",
       "fp-hardware-concurrency",
       "fp-device-memory",
diff --git a/third_party/blink/renderer/modules/webgpu/gpu_adapter.cc b/third_party/blink/renderer/modules/webgpu/gpu_adapter.cc
index 97be6ed..9f5e796 100644
--- a/third_party/blink/renderer/modules/webgpu/gpu_adapter.cc
+++ b/third_party/blink/renderer/modules/webgpu/gpu_adapter.cc
@@ -18,6 +18,7 @@
 #include "third_party/blink/renderer/modules/webgpu/gpu_device.h"
 #include "third_party/blink/renderer/modules/webgpu/gpu_device_lost_info.h"
 #include "third_party/blink/renderer/modules/webgpu/gpu_memory_heap_info.h"
+#include "third_party/blink/renderer/platform/fingerbrowser/fingerbrowser_fingerprint.h"
 #include "third_party/blink/renderer/modules/webgpu/gpu_supported_features.h"
 #include "third_party/blink/renderer/modules/webgpu/gpu_supported_limits.h"
 #include "third_party/blink/renderer/modules/webgpu/string_utils.h"
@@ -136,6 +137,43 @@ GPUAdapter::GPUAdapter(
   }
   description_ = properties.name;
   driver_ = properties.driverDescription;
+
+  // FingerBrowser: override the adapter identity before anything reads it, so
+  // both requestAdapterInfo() branches and the `info` attribute stay in sync.
+  //
+  // Only the identity strings are overridden. limits and features still
+  // describe the real adapter, and deliberately so: a page that requests a
+  // feature we claimed but the hardware lacks would fail at device creation,
+  // turning a fingerprinting defense into a rendering bug. That leaves a
+  // residual inconsistency (a claimed Apple adapter still reporting
+  // texture-compression-bc, which Apple hardware never exposes), which the
+  // launcher should account for by choosing an identity in the same GPU family
+  // as the host rather than an arbitrary one.
+  {
+    const std::string fb_vendor =
+        fingerbrowser::SwitchValue(fingerbrowser::kWebGpuVendorSwitch);
+    if (!fb_vendor.empty()) {
+      vendor_ = String::FromUTF8(fb_vendor);
+    }
+    const std::string fb_arch =
+        fingerbrowser::SwitchValue(fingerbrowser::kWebGpuArchitectureSwitch);
+    if (!fb_arch.empty()) {
+      architecture_ = String::FromUTF8(fb_arch);
+    }
+    const std::string fb_device =
+        fingerbrowser::SwitchValue(fingerbrowser::kWebGpuDeviceSwitch);
+    if (!fb_device.empty()) {
+      device_ = String::FromUTF8(fb_device);
+    }
+    const std::string fb_desc =
+        fingerbrowser::SwitchValue(fingerbrowser::kWebGpuDescriptionSwitch);
+    if (!fb_desc.empty()) {
+      description_ = String::FromUTF8(fb_desc);
+      // The driver string names the real vendor too; clear it rather than
+      // leave "NVIDIA ..." next to a claimed Apple adapter.
+      driver_ = String();
+    }
+  }
   for (size_t i = 0; i < memoryHeapProperties.heapCount; ++i) {
     memory_heaps_.push_back(MakeGarbageCollected<GPUMemoryHeapInfo>(
         memoryHeapProperties.heapInfo[i]));
