+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_PROFILES_ACCOUNT_PANEL_BUBBLE_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_PROFILES_ACCOUNT_PANEL_BUBBLE_VIEW_H_
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/ui/views/bubble/webui_bubble_dialog_view.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+
+class Browser;
+
+// 云登账号面板的气泡宿主。
+//
+// 存在的唯一理由是重写 OpenURLFromTab。WebUI 气泡默认的实现返回 nullptr —— 页面
+// 里的链接点了什么都不会发生，所以「面板项就是几个 <a href>」这个形态在上游是
+// 走不通的，必须由宿主把导航接过来。
+//
+// 接过来之后顺带得到了一个更好的性质：**能去哪由这里的白名单决定，不由页面决定**。
+// 另一条路是给页面一个 mojo 方法让它请求打开 URL，那样就多了一个可调用的特权面，
+// 而这个面的成本特征是加一个方法几乎零成本、减一个方法要改两边。这里页面只有
+// 普通链接，一个可调用接口都没有。
+class AccountPanelBubbleView : public WebUIBubbleDialogView {
+  METADATA_HEADER(AccountPanelBubbleView, WebUIBubbleDialogView)
+
+ public:
+  AccountPanelBubbleView(views::View* anchor_view,
+                         base::WeakPtr<WebUIContentsWrapper> contents_wrapper,
+                         Browser* browser);
+  AccountPanelBubbleView(const AccountPanelBubbleView&) = delete;
+  AccountPanelBubbleView& operator=(const AccountPanelBubbleView&) = delete;
+  ~AccountPanelBubbleView() override;
+
+  // WebUIContentsWrapper::Host:
+  content::WebContents* OpenURLFromTab(
+      content::WebContents* source,
+      const content::OpenURLParams& params,
+      base::OnceCallback<void(content::NavigationHandle&)>
+          navigation_handle_callback) override;
+
+ private:
+  raw_ptr<Browser> browser_;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_PROFILES_ACCOUNT_PANEL_BUBBLE_VIEW_H_
