new file mode 100644
index 0000000000..1b0e1d25b7
--- /dev/null
+++ b/chrome/browser/ui/webui/account_panel/account_panel_ui.cc
@@ -0,0 +1,77 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/account_panel/account_panel_ui.h"
+
+#include <string>
+
+#include "base/command_line.h"
+#include "base/strings/utf_string_conversions.h"
+#include "build/build_config.h"
+#include "chrome/browser/fingerbrowser/fingerbrowser_console.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/common/webui_url_constants.h"
+#include "chrome/grit/account_panel_resources.h"
+#include "chrome/grit/account_panel_resources_map.h"
+#include "chrome/grit/generated_resources.h"
+#include "content/public/browser/web_ui.h"
+#include "content/public/browser/web_ui_data_source.h"
+#include "content/public/common/url_constants.h"
+#include "ui/webui/webui_util.h"
+
+namespace {
+
+// 面板显示名。客户端在启动时下发，内核当不透明串——长度、语言、是否含空格
+// 都不做校验，因为这是产品/白标的东西，不是内核该有意见的地方。
+std::string AccountDisplayName() {
+  const base::CommandLine::StringType raw =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueNative(
+          "fp-account-initial");
+#if BUILDFLAG(IS_WIN)
+  return base::WideToUTF8(raw);
+#else
+  return raw;
+#endif
+}
+
+}  // namespace
+
+AccountPanelUIConfig::AccountPanelUIConfig()
+    : DefaultTopChromeWebUIConfig(content::kChromeUIScheme,
+                                  chrome::kChromeUIAccountPanelHost) {}
+
+bool AccountPanelUIConfig::IsWebUIEnabled(
+    content::BrowserContext* browser_context) {
+  // 独立开关而非复用 fp-shell：面板替换的是原生头像菜单，属于可以单独回退的
+  // 产品形态。不传即完全走原生 ProfileMenuView，行为与上游一致。
+  return base::CommandLine::ForCurrentProcess()->HasSwitch("fp-account-panel");
+}
+
+bool AccountPanelUIConfig::ShouldAutoResizeHost() {
+  return true;
+}
+
+AccountPanelUI::AccountPanelUI(content::WebUI* web_ui)
+    : TopChromeWebUIController(web_ui) {
+  Profile* profile = Profile::FromWebUI(web_ui);
+  content::WebUIDataSource* source = content::WebUIDataSource::CreateAndAdd(
+      profile, chrome::kChromeUIAccountPanelHost);
+
+  static constexpr webui::LocalizedString kStrings[] = {
+      {"title", IDS_ACCOUNT_PANEL_TITLE},
+  };
+  source->AddLocalizedStrings(kStrings);
+
+  // 页面拿到的全部东西：一个显示名、一个管理台地址。都是只读字符串，页面无法
+  // 用它们请求内核做任何事——链接去哪仍由气泡宿主的白名单裁决。
+  source->AddString("accountDisplayName", AccountDisplayName());
+  source->AddString("consoleUrl", fingerbrowser::GetConsoleUrl().spec());
+
+  webui::SetupWebUIDataSource(source, kAccountPanelResources,
+                              IDR_ACCOUNT_PANEL_ACCOUNT_PANEL_HTML);
+}
+
+AccountPanelUI::~AccountPanelUI() = default;
+
+WEB_UI_CONTROLLER_TYPE_IMPL(AccountPanelUI)
