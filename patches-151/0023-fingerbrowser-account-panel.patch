+  // 看不见和做不到是两回事，那三项还能从三点菜单和 chrome://profile-picker
+  // 走到。换面板是品牌与体验，不是安全边界。
+  if (!is_incognito &&
+      base::CommandLine::ForCurrentProcess()->HasSwitch("fp-account-panel")) {
+    auto contents_wrapper =
+        std::make_unique<WebUIContentsWrapperT<AccountPanelUI>>(
+            GURL(chrome::kChromeUIAccountPanelURL), GetProfile(),
+            IDS_ACCOUNT_PANEL_TITLE);
+    auto* wrapper_ptr = contents_wrapper.get();
+    account_panel_contents_ = std::move(contents_wrapper);
