+    // 表现就是点头像闪退。原生 ProfileMenuView 接受 BubbleAnchor 所以没这问题。
+    views::View* const anchor_view =
+        BrowserView::GetBrowserViewForBrowser(browser)
+            ->toolbar()
+            ->avatar_toolbar_button();
+    auto panel = std::make_unique<AccountPanelBubbleView>(
+        anchor_view, wrapper_ptr->GetWeakPtr(), browser);
+    panel->SetProperty(views::kElementIdentifierKey,
