--- /dev/null
+++ b/chrome/browser/resources/account_panel/app.ts
@@ -0,0 +1,56 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import '/strings.m.js';
+
+import {CrLitElement} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+import {loadTimeData} from 'chrome://resources/js/load_time_data.js';
+
+import {getHtml} from './app.html.js';
+
+// 云登账号面板。替换原生 ProfileMenuView —— 后者的「添加/管理个人资料」操作的是
+// 原生 Chromium profile，而本产品里 profile 这个位置已经被「环境」占了。
+//
+// 这个面板**没有任何可调用的接口**：不接 mojo，也没有 RPC 面。它能做的全部事情
+// 就是渲染几个 <a href>，去哪由 C++ 侧的白名单决定（见 account_panel_ui.cc 的
+// OpenURLFromTab）。页面拿到的只有下面这几个只读字符串。
+//
+// 第一期登录态是**启动时的快照**：显示名由 --fp-account-initial 传入，用户在
+// 管理台里登录/登出后这里不会跟着变。这是已知限制，不是缺陷——要跟着变需要
+// 内核与客户端之间的状态通道，那是第二期。
+export class AccountPanelAppElement extends CrLitElement {
+  static get is() {
+    return 'account-panel-app';
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      displayName_: {type: String},
+      consoleUrl_: {type: String},
+    };
+  }
+
+  protected accessor displayName_: string =
+      loadTimeData.getString('accountDisplayName');
+  protected accessor consoleUrl_: string =
+      loadTimeData.getString('consoleUrl');
+
+  // 面板项对应的管理台路由。拼接放在这里而不是 C++ 里，是因为它们是产品导航结构
+  // 的一部分，改动频繁；而「允许去哪个 origin」在 C++ 白名单里，改动罕见。
+  protected route_(hash: string): string {
+    return this.consoleUrl_ ? `${this.consoleUrl_}#/${hash}` : '';
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'account-panel-app': AccountPanelAppElement;
+  }
+}
+
+customElements.define(AccountPanelAppElement.is, AccountPanelAppElement);
