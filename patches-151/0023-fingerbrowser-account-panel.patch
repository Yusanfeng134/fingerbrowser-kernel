+++ b/chrome/browser/ui/views/profiles/account_panel_bubble_view.cc
@@ -0,0 +1,54 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/profiles/account_panel_bubble_view.h"
+
+#include "chrome/browser/fingerbrowser/fingerbrowser_console.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/navigator/browser_navigator.h"
+#include "chrome/browser/ui/navigator/browser_navigator_params.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/base/window_open_disposition.h"
+
+AccountPanelBubbleView::AccountPanelBubbleView(
+    views::View* anchor_view,
+    base::WeakPtr<WebUIContentsWrapper> contents_wrapper,
+    Browser* browser)
+    : WebUIBubbleDialogView(anchor_view, std::move(contents_wrapper)),
+      browser_(browser) {}
+
+AccountPanelBubbleView::~AccountPanelBubbleView() = default;
+
+content::WebContents* AccountPanelBubbleView::OpenURLFromTab(
+    content::WebContents* source,
+    const content::OpenURLParams& params,
+    base::OnceCallback<void(content::NavigationHandle&)>
+        navigation_handle_callback) {
+  // 白名单：只放行管理台。这里是这个面板唯一的安全边界 —— 面板本身没有可调用
+  // 接口，它能造成的全部影响就是让宿主导航到某个 URL，而 URL 去哪由这一行决定。
+  //
+  // 用 IsConsoleUrl 而不是自己再写一遍匹配：管理台的判定只能有一处定义，否则
+  // 两份规则迟早漂移，而漂移出来的口子是静默的。
+  if (!browser_ || !fingerbrowser::IsConsoleUrl(params.url)) {
+    return nullptr;
+  }
+
+  // 在浏览器里开标签页，而不是在气泡内部导航：气泡是个临时浮层，把管理台加载
+  // 到里面既没有标签栏也无法返回。
+  NavigateParams nav_params(browser_, params.url,
+                            ui::PAGE_TRANSITION_AUTO_BOOKMARK);
+  nav_params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  Navigate(&nav_params);
+
+  // 选完就收起来，与原生头像菜单点任一项后的行为一致。
+  if (GetWidget()) {
+    GetWidget()->CloseWithReason(views::Widget::ClosedReason::kAcceptButtonClicked);
+  }
+
+  return nav_params.navigated_or_inserted_contents;
+}
+
