+
+#ifndef CHROME_BROWSER_UI_WEBUI_ACCOUNT_PANEL_ACCOUNT_PANEL_UI_H_
+#define CHROME_BROWSER_UI_WEBUI_ACCOUNT_PANEL_ACCOUNT_PANEL_UI_H_
+
+#include <string_view>
+
+#include "chrome/browser/ui/webui/top_chrome/top_chrome_web_ui_controller.h"
+#include "chrome/browser/ui/webui/top_chrome/top_chrome_webui_config.h"
+
+class AccountPanelUI;
+
+class AccountPanelUIConfig
+    : public DefaultTopChromeWebUIConfig<AccountPanelUI> {
+ public:
+  AccountPanelUIConfig();
+
+  // DefaultTopChromeWebUIConfig:
+  bool IsWebUIEnabled(content::BrowserContext* browser_context) override;
+
+  // 气泡必须跟着页面内容定尺寸。默认实现返回 false —— 那对侧栏是对的（尺寸由
+  // 侧栏决定），但气泡没有外部尺寸来源，关掉自动伸缩就停在最小尺寸，表现为
+  // 「弹出一个空白小气泡」，看起来像页面没加载，其实页面是好的。
+  bool ShouldAutoResizeHost() override;
+};
+
+// 云登账号面板，替换原生 ProfileMenuView。
+//
+// 这个面被有意做成**没有任何可调用接口**：不绑 mojo，不注册 message handler。
+// 页面唯一能做的事是渲染 <a href>，而链接能去哪由气泡宿主的白名单决定。
+//
+// 这条约束不是洁癖。WebUI 跑在 chrome:// 上，天生带 WebUI 绑定，是真正的特权面
+// ——AI 新标签页是普通 http 页面，能做到一个字节的桥都不注入，这里做不到。而这
+// 类接口的成本特征是「加一个方法几乎零成本、减一个方法要改两边」，所以要在还
+// 没有第一个方法的时候就卡住。
+//
+// 第一期不需要任何方法：面板项全是「打开某个管理台路由」，用链接即可表达。
+class AccountPanelUI : public TopChromeWebUIController {
+ public:
+  explicit AccountPanelUI(content::WebUI* web_ui);
+  AccountPanelUI(const AccountPanelUI&) = delete;
+  AccountPanelUI& operator=(const AccountPanelUI&) = delete;
+  ~AccountPanelUI() override;
+
+  static constexpr std::string_view GetWebUIName() { return "AccountPanel"; }
+
+  WEB_UI_CONTROLLER_TYPE_DECL();
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_ACCOUNT_PANEL_ACCOUNT_PANEL_UI_H_
