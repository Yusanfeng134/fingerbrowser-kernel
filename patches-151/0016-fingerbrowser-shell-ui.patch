+#ifndef CHROME_BROWSER_UI_VIEWS_SIDE_PANEL_VOYAGER_VOYAGER_SIDE_PANEL_COORDINATOR_H_
+#define CHROME_BROWSER_UI_VIEWS_SIDE_PANEL_VOYAGER_VOYAGER_SIDE_PANEL_COORDINATOR_H_
+
+class BrowserWindowInterface;
+class Profile;
+class SidePanelRegistry;
+
+// 创建并注册 Voyager 侧栏的 SidePanelEntry。
+//
+// 无状态，所以做成静态方法而不是像 TabsFromOtherDevices 那样挂在
+// BrowserWindowFeatures 上 —— 那需要额外改两个文件来存放实例，而这个探针
