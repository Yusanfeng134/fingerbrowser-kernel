+
+// 最小 WebUI 侧栏。不绑 mojo、不持有 BrowserWindowInterface —— 这个探针只用来
+// 量「新增一个 WebUI 侧栏」要接多少线、编译一轮多久。
+class VoyagerSidePanelUI : public TopChromeWebUIController {
+ public:
+  explicit VoyagerSidePanelUI(content::WebUI* web_ui);
+  VoyagerSidePanelUI(const VoyagerSidePanelUI&) = delete;
+  VoyagerSidePanelUI& operator=(const VoyagerSidePanelUI&) = delete;
+  ~VoyagerSidePanelUI() override;
+
+  static constexpr std::string_view GetWebUIName() {
+    return "VoyagerSidePanel";
+  }
+
+  WEB_UI_CONTROLLER_TYPE_DECL();
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_SIDE_PANEL_VOYAGER_VOYAGER_SIDE_PANEL_UI_H_
