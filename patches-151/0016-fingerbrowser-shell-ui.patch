diff --git a/chrome/browser/ui/views/side_panel/voyager/voyager_side_panel_coordinator.cc b/chrome/browser/ui/views/side_panel/voyager/voyager_side_panel_coordinator.cc
new file mode 100644
index 0000000000..8210b8ef37
--- /dev/null
+++ b/chrome/browser/ui/views/side_panel/voyager/voyager_side_panel_coordinator.cc
@@ -0,0 +1,81 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/side_panel/voyager/voyager_side_panel_coordinator.h"
+
+#include <memory>
+
+#include "base/command_line.h"
+#include "base/functional/bind.h"
+#include "base/functional/callback.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/side_panel/side_panel_entry.h"
+#include "chrome/browser/ui/side_panel/side_panel_entry_scope.h"
+#include "chrome/browser/ui/side_panel/side_panel_content_proxy.h"
+#include "chrome/browser/ui/side_panel/side_panel_registry.h"
+#include "chrome/browser/ui/side_panel/side_panel_util.h"
+#include "chrome/browser/ui/views/side_panel/side_panel_web_ui_view.h"
+#include "chrome/browser/ui/webui/side_panel/voyager/voyager_side_panel_ui.h"
+#include "chrome/browser/ui/webui/top_chrome/webui_contents_wrapper.h"
+#include "chrome/common/webui_url_constants.h"
+#include "chrome/grit/generated_resources.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+
+using SidePanelWebUIViewT_VoyagerSidePanelUI =
+    SidePanelWebUIViewT<VoyagerSidePanelUI>;
+BEGIN_TEMPLATE_METADATA(SidePanelWebUIViewT_VoyagerSidePanelUI,
+                        SidePanelWebUIViewT)
+END_METADATA
+
+namespace {
+
+std::unique_ptr<views::View> CreateVoyagerWebView(Profile* profile,
+                                                  SidePanelEntryScope& scope) {
+  auto contents_wrapper =
+      std::make_unique<WebUIContentsWrapperT<VoyagerSidePanelUI>>(
+          GURL(chrome::kChromeUIVoyagerSidePanelURL), profile,
+          IDS_SIDE_PANEL_VOYAGER_TITLE,
+          /*esc_closes_ui=*/false,
+          /*supports_draggable_regions=*/false);
+
+  auto view = std::make_unique<SidePanelWebUIViewT<VoyagerSidePanelUI>>(
+      scope, base::RepeatingClosure(), base::RepeatingClosure(),
+      std::move(contents_wrapper));
+
+  // 探针捷径，不是产品写法。
+  //
+  // SidePanelWebUIView 构造时 SetVisible(is_ready_to_show)，而 ready_to_show
+  // 只有在 WebUI 通过 mojo 反向调用 ShowUI() 之后才为真。也就是说，一个不接
+  // mojo 的侧栏永远不会显示 —— 「最小 WebUI 侧栏」在 Chromium 里并不存在，
+  // mojo 通道是必需项而非可选项。
+  //
+  // 这里直接置位只是为了让探针产出可见结果、完成成本测量。真正要做的面板必须
+  // 补齐 mojom + PageHandler + binder 注册 + TS 侧 api proxy。
+  view->SetVisible(true);
+  SidePanelUtil::GetSidePanelContentProxy(view.get())->SetAvailable(true);
+
+  return view;
+}
+
+}  // namespace
+
+// static
+bool VoyagerSidePanelCoordinator::IsSupported(Profile* profile) {
+  // 与 WebUIConfig::IsWebUIEnabled 保持同一条件：两处不一致会出现「入口在但
+  // 打开是空白」或反过来的情况。
+  return profile->IsRegularProfile() &&
+         base::CommandLine::ForCurrentProcess()->HasSwitch("fp-shell");
+}
+
+// static
+void VoyagerSidePanelCoordinator::CreateAndRegisterEntry(
+    BrowserWindowInterface* browser,
+    SidePanelRegistry* global_registry) {
+  Profile* profile = browser->GetProfile();
+  global_registry->Register(std::make_unique<SidePanelEntry>(
+      SidePanelEntry::Key(SidePanelEntry::Id::kVoyager),
+      base::BindRepeating(&CreateVoyagerWebView, profile),
+      /*default_content_width_callback=*/base::NullCallback()));
+}
