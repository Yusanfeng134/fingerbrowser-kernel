+
+  static bool IsSupported(Profile* profile);
+
+  static void CreateAndRegisterEntry(BrowserWindowInterface* browser,
+                                     SidePanelRegistry* global_registry);
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_SIDE_PANEL_VOYAGER_VOYAGER_SIDE_PANEL_COORDINATOR_H_
