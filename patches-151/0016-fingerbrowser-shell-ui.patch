+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/side_panel/voyager/voyager_side_panel_ui.h"
+
+#include "base/command_line.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/common/webui_url_constants.h"
+#include "chrome/grit/generated_resources.h"
+#include "chrome/grit/side_panel_voyager_resources.h"
+#include "chrome/grit/side_panel_voyager_resources_map.h"
+#include "content/public/browser/web_ui.h"
+#include "content/public/browser/web_ui_data_source.h"
+#include "content/public/common/url_constants.h"
+#include "ui/webui/webui_util.h"
+
+VoyagerSidePanelUIConfig::VoyagerSidePanelUIConfig()
+    : DefaultTopChromeWebUIConfig(content::kChromeUIScheme,
+                                  chrome::kChromeUIVoyagerSidePanelHost) {}
+
+bool VoyagerSidePanelUIConfig::IsWebUIEnabled(
+    content::BrowserContext* browser_context) {
+  // 与垂直标签栏同一个门控 fp-shell（浏览器外壳），不是 fp-active（指纹伪装）：
+  // 侧栏在用户日常浏览时也该有，而日常 profile 不带 fp-active。
+  return base::CommandLine::ForCurrentProcess()->HasSwitch("fp-shell");
+}
+
+VoyagerSidePanelUI::VoyagerSidePanelUI(content::WebUI* web_ui)
+    : TopChromeWebUIController(web_ui) {
+  Profile* profile = Profile::FromWebUI(web_ui);
+  content::WebUIDataSource* source = content::WebUIDataSource::CreateAndAdd(
+      profile, chrome::kChromeUIVoyagerSidePanelHost);
+
+  static constexpr webui::LocalizedString kStrings[] = {
+      {"title", IDS_SIDE_PANEL_VOYAGER_TITLE},
+  };
+  source->AddLocalizedStrings(kStrings);
+
+  webui::SetupWebUIDataSource(source, kSidePanelVoyagerResources,
+                              IDR_SIDE_PANEL_VOYAGER_VOYAGER_HTML);
+}
+
+VoyagerSidePanelUI::~VoyagerSidePanelUI() = default;
+
+WEB_UI_CONTROLLER_TYPE_IMPL(VoyagerSidePanelUI)
