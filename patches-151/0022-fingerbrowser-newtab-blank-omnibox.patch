---
 .../fingerbrowser/fingerbrowser_console.cc     | 13 ++++++++-----
 .../fingerbrowser/fingerbrowser_console.h      | 13 +++++++++++++
 .../chrome_location_bar_model_delegate.cc      | 18 ++++++++++++++++++
 3 files changed, 39 insertions(+), 5 deletions(-)

diff --git a/chrome/browser/fingerbrowser/fingerbrowser_console.cc b/chrome/browser/fingerbrowser/fingerbrowser_console.cc
index 99279a0f41..8273a0ee4a 100644
--- a/chrome/browser/fingerbrowser/fingerbrowser_console.cc
+++ b/chrome/browser/fingerbrowser/fingerbrowser_console.cc
@@ -57,6 +57,12 @@ const GURL& GetNewTabUrl() {
   return *url;
 }
 
+bool IsNewTabUrl(const GURL& url) {
+  const GURL& newtab = GetNewTabUrl();
+  return newtab.is_valid() && url.is_valid() && url.path() == newtab.path() &&
+         url::Origin::Create(url) == url::Origin::Create(newtab);
+}
+
 bool IsConsoleUrl(const GURL& url) {
   const url::Origin& console = ConsoleOrigin();
   // An opaque origin means the console was never configured; it must not
@@ -70,11 +76,8 @@ bool IsConsoleUrl(const GURL& url) {
   // The AI new tab page comes off the same local server, so it shares the
   // console's origin -- but it is a browsing surface. Treating it as the
   // console would rewrite its address bar and make that bar read-only, leaving
-  // the user unable to type a URL in a new tab. Matched by path because both
-  // are hash-routed: the console lives at "/" with routes in the fragment,
-  // the new tab page at "/newtab".
-  if (const GURL& newtab = GetNewTabUrl();
-      newtab.is_valid() && url.path() == newtab.path()) {
+  // the user unable to type a URL in a new tab.
+  if (IsNewTabUrl(url)) {
     return false;
   }
 
diff --git a/chrome/browser/fingerbrowser/fingerbrowser_console.h b/chrome/browser/fingerbrowser/fingerbrowser_console.h
index 4a779980e6..abb9e6b2f4 100644
--- a/chrome/browser/fingerbrowser/fingerbrowser_console.h
+++ b/chrome/browser/fingerbrowser/fingerbrowser_console.h
@@ -46,6 +46,19 @@ bool IsConsoleUrl(const GURL& url);
 // granting privileges here would hand every new tab the console's API surface.
 const GURL& GetNewTabUrl();
 
+// Returns true if `url` is the AI new tab page.
+//
+// Matched by path, not by whole URL: the page is hash-routed, so the fragment
+// changes as the user moves inside it while the path stays put. The console is
+// hash-routed at "/" and this page at "/newtab" -- that difference is the only
+// thing separating them, since they share an origin.
+//
+// Single definition on purpose. Two callers depend on it and they want opposite
+// things: the console rules must exclude this page (its address bar has to stay
+// usable), while the omnibox must blank the address for it. Two copies of the
+// rule would drift, and the drift would be silent.
+bool IsNewTabUrl(const GURL& url);
+
 // Returns true if `url` looks like a management console left over from an
 // earlier launch: a loopback http(s) origin that is not this launch's console.
 //
diff --git a/chrome/browser/ui/toolbar/chrome_location_bar_model_delegate.cc b/chrome/browser/ui/toolbar/chrome_location_bar_model_delegate.cc
index 708f393585..ef9be03075 100644
--- a/chrome/browser/ui/toolbar/chrome_location_bar_model_delegate.cc
+++ b/chrome/browser/ui/toolbar/chrome_location_bar_model_delegate.cc
@@ -103,6 +103,24 @@ bool ChromeLocationBarModelDelegate::ShouldDisplayURL() const {
     return true;
   }
 
+  // FingerBrowser：AI 新标签页的地址栏留空，与原生新标签页一致。
+  //
+  // 它的真实地址是 http://127.0.0.1:<每次启动都变的端口>/newtab#/ai-newtab ——
+  // 复制给别人、存书签、下次手输全是死的，是一个天然无法被引用的地址，却摆在
+  // 最适合复制引用的位置。用户需要知道的是「这是新标签页」，不是本机某服务的
+  // 某条路由。
+  //
+  // 走 ShouldDisplayURL 而不是 GetDisplayTextOverride：这正是原生 NTP 用的那条
+  // 机制，返回 false 即空地址栏加占位文案，**且地址栏保持可聚焦、可输入、可导航**
+  // —— 用户开新标签本来就是为了敲网址。用显示文本覆盖只能做到「看起来是空的」，
+  // 做不到这一点。
+  //
+  // 逐次按当前 URL 求值，所以导航到真实网站后立刻显示真实域名：不会出现「对这个
+  // 标签永远显示空」那种真正的地址栏欺骗。
+  if (GURL url; GetURL(&url) && fingerbrowser::IsNewTabUrl(url)) {
+    return false;
+  }
+
   security_interstitials::SecurityInterstitialTabHelper*
       security_interstitial_tab_helper =
           security_interstitials::SecurityInterstitialTabHelper::
