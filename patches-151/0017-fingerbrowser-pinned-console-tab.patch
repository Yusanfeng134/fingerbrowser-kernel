diff --git a/chrome/browser/ui/startup/startup_browser_creator_impl.cc b/chrome/browser/ui/startup/startup_browser_creator_impl.cc
index a1d71b78b0..b89f8ead0c 100644
--- a/chrome/browser/ui/startup/startup_browser_creator_impl.cc
+++ b/chrome/browser/ui/startup/startup_browser_creator_impl.cc
@@ -551,6 +551,35 @@ void StartupBrowserCreatorImpl::DetermineURLsAndLaunch(
   Browser* browser = RestoreOrCreateBrowser(
       tabs, behavior, restore_options, process_startup, is_post_crash_launch);
 
+  // FingerBrowser：把 --fp-pinned-url 指定的标签设为固定。
+  //
+  // 客户端的形态就是浏览器，管理台是它的第一个标签页 —— 那个标签就是这个应用。
+  // 关掉它用户只剩一个没有入口的浏览器，环境列表、指纹配置、Cookie 全都进不去，
+  // 而且没有恢复路径，只能杀进程重启。固定之后 web_app::HasPinnedHomeTab 会把它
+  // 当首页标签处理，标签上的关闭按钮、右键关闭、Ctrl+W、拖出成窗口一并禁掉。
+  //
+  // 放在这里而不是在创建标签时给 StartupTab::Type::kPinned：标签有多条创建路径
+  // （会话恢复走 SessionRestore::RestoreSession，命令行走 OpenTabsInBrowser），
+  // 在其中一条上打标记，另一条就漏掉 —— 最初改在 GetCommandLineTabs 里，实测
+  // 那条路径压根没被走到。在浏览器已经建好之后按 URL 找，与创建方式无关。
+  //
+  // 用显式的 URL 开关而不是「固定第一个标签」：启动参数里可能带多个地址（例如
+  // 用户从系统里用它打开一个链接），只有管理台那个该被固定。
+  if (browser) {
+    const std::string pinned_url =
+        command_line_->GetSwitchValueASCII("fp-pinned-url");
+    if (!pinned_url.empty()) {
+      TabStripModel* const model = browser->tab_strip_model();
+      for (int i = 0; i < model->count(); ++i) {
+        content::WebContents* const contents = model->GetWebContentsAt(i);
+        if (contents && contents->GetVisibleURL().spec() == pinned_url) {
+          model->SetTabPinned(i, true);
+          break;
+        }
+      }
+    }
+  }
+
   tab_groups::MaybeShowSharedTabGroupVersionOutOfDateModal(browser);
   tab_groups::MaybeShowSharedTabGroupVersionUpToDateToast(browser);
 
diff --git a/chrome/browser/ui/web_applications/web_app_tabbed_utils.cc b/chrome/browser/ui/web_applications/web_app_tabbed_utils.cc
