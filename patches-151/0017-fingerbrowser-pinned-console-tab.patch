@@ -4,6 +4,7 @@
 
 #include "chrome/browser/ui/web_applications/web_app_tabbed_utils.h"
 
+#include "base/command_line.h"
 #include "chrome/browser/ui/browser.h"
 #include "chrome/browser/ui/tabs/tab_strip_model.h"
 #include "chrome/browser/ui/tabs/tab_strip_model_delegate.h"
@@ -15,8 +16,21 @@ bool HasPinnedHomeTab(const TabStripModel* tab_strip_model) {
   if (!tab_strip_model->ContainsIndex(0)) {
     return false;
   }
-  return tab_strip_model->delegate()->IsForWebApp() &&
-         tab_strip_model->IsTabPinned(0);
+  if (!tab_strip_model->IsTabPinned(0)) {
+    return false;
+  }
+  // FingerBrowser：外壳（--fp-shell）的第 0 个标签是管理台，语义上和 PWA 的
+  // 「固定首页标签」完全一致 —— 它就是这个应用本身，不该能被关掉。
+  //
+  // 复用上游这套机制而不是自己做「关闭即重开」：这一个判断会同时让标签上的 ×
+  // 消失、右键菜单里的「关闭」隐藏、Ctrl+W 失效、且标签不能被拖出成独立窗口
+  // （IsTabDetachable 也走这里）。补救式的重开只能盖住其中一条路径。
+  //
+  // 用户关掉整个窗口仍然可以：IsTabClosable 在 count()==1 时返回 true。
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch("fp-shell")) {
+    return true;
+  }
+  return tab_strip_model->delegate()->IsForWebApp();
 }
 
 bool IsPinnedHomeTab(const TabStripModel* tab_strip_model, int index) {
