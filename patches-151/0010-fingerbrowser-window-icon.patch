 // treated as clicks to the frame, rather than clicks to the tab.
 const int kTabShadowSize = 2;
 
+#if BUILDFLAG(IS_WIN)
+// FingerBrowser: per-environment taskbar / Alt-Tab icon.
+//
+// An operator running a dozen store environments sees a dozen identical
+// buttons on the taskbar; there is no way to tell which window belongs to
+// which store. Letting each environment carry its own icon is what makes them
+// distinguishable at a glance.
+//
+// The icon is supplied as a path to a managed .ico file. It only affects the
+// window's icon: page favicons, titles and every fingerprint surface are
+// untouched, and the path never reaches the renderer.
+constexpr char kEnvironmentWindowIconSwitch[] = "yunlogin-window-icon";
+
+// Loads the .ico into a Chromium image. Returned empty when unset, missing or
+// unreadable -- callers then fall back to the default browser icon, which is
+// the right outcome: a window with the stock icon is merely indistinguishable,
+// whereas failing to open the window would cost the user their session.
+//
+// Windows picks a different frame out of a multi-size .ico depending on DPI, so
+// LoadImage is asked for the two sizes the shell actually uses (small for the
+// title bar, large for the taskbar and Alt-Tab) rather than one scaled bitmap.
+gfx::ImageSkia LoadEnvironmentWindowIcon(bool large) {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch(kEnvironmentWindowIconSwitch)) {
+    return gfx::ImageSkia();
+  }
+  const base::FilePath icon_path =
+      command_line->GetSwitchValuePath(kEnvironmentWindowIconSwitch);
+  if (icon_path.empty()) {
+    return gfx::ImageSkia();
+  }
+  const int metric = large ? SM_CXICON : SM_CXSMICON;
+  const int size = ::GetSystemMetrics(metric);
+  base::win::ScopedGDIObject<HICON> icon(reinterpret_cast<HICON>(
+      ::LoadImage(nullptr, icon_path.value().c_str(), IMAGE_ICON, size, size,
+                  LR_LOADFROMFILE)));
+  if (!icon.is_valid()) {
+    return gfx::ImageSkia();
+  }
+  const SkBitmap bitmap = IconUtil::CreateSkBitmapFromHICON(icon.get());
+  if (bitmap.isNull()) {
+    return gfx::ImageSkia();
+  }
+  return gfx::ImageSkia::CreateFrom1xBitmap(bitmap);
+}
+#endif  // BUILDFLAG(IS_WIN)
