 chrome/browser/resources/account_panel/app.html.ts | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/chrome/browser/resources/account_panel/app.html.ts b/chrome/browser/resources/account_panel/app.html.ts
index 593ea79c00..8c500e1690 100644
--- a/chrome/browser/resources/account_panel/app.html.ts
+++ b/chrome/browser/resources/account_panel/app.html.ts
@@ -93,6 +93,18 @@ export function getHtml(this: AccountPanelAppElement) {
 -->
 <a class="item" href="${this.route_('yunlogin-environments')}">环境管理</a>
 <a class="item" href="${this.route_('proxies')}">代理管理</a>
-<a class="item" href="${this.route_('settings')}">设置</a>
+<!--
+  这里曾有一项「设置」指向 #/settings，而管理台没有这个路由 —— SPA 的兜底
+  <Route path="*"> 接住它，最终显示环境管理。**能点、有反应、页面也正常渲染，
+  只是去错了地方**，用户只会以为设置页坏了。
+
+  它躲过验收的方式值得记住：只验「每一项都能点开一个标签页」，这条必然通过，
+  因为它确实打开了一个标签页。要发现它，验收得逐项核对**落地页是不是它声称
+  的那个**。
+
+  设置页真做出来之前不放替代目的地 —— 任何「指向别处凑数」都是同一个名不副实
+  换了个形式。
+-->
