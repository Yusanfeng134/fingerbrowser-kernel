---
 .../embedder_support/user_agent_utils.cc      | 42 +++++++++++++++++++
 1 file changed, 42 insertions(+)

diff --git a/components/embedder_support/user_agent_utils.cc b/components/embedder_support/user_agent_utils.cc
index c220516f39..0a41f062d4 100644
--- a/components/embedder_support/user_agent_utils.cc
+++ b/components/embedder_support/user_agent_utils.cc
@@ -647,6 +647,48 @@ std::string GetPlatformVersion() {
 }
 
 std::string GetPlatformForUAMetadata() {
+  // FingerBrowser：Client Hints 的 platform，与 navigator.platform 同源。
+  //
+  // 不伪装这一项的后果**不是「未伪装」，是矛盾**，而且是三方的。实测（全量策略
+  // 扫描 probe/run-policy-sweep.cjs，人格配 MacIntel）：
+  //
+  //     navigator.platform     MacIntel   ← 已伪装
+  //     UA-CH platform         Windows    ← 宿主真值
+  //     UA-CH platformVersion  14.5.0     ← 已伪装成 macOS 版本
+  //
+  // 于是 UA-CH **自己内部就不自洽**：声称 Windows，却报一个 Windows 不存在的
+  // 版本号（那套契约编号是 10/14/15/19）。再加上 navigator.platform 说 MacIntel，
+  // 读三个字段就能断定这个浏览器被改过。
+  //
+  // 注意 GetPlatformVersion() 上方那段注释说 platformVersion「属于未伪装而非
+  // 矛盾」—— 那句在**只**伪装 platformVersion 时成立，一旦人格跨平台就不成立。
+  // 「某项是未伪装还是矛盾」不是它的固有属性，取决于它旁边那些项被伪装成什么。
+  //
+  // 从已有的 fp-platform 派生，不新开开关：同一属性只能有一处真相（0026 在屏幕
+  // 尺寸上定下的规则）。navigator.platform 用的是 NavigatorID 那套值
+  // （Win32 / MacIntel / Linux x86_64），而 UA-CH 用的是展示名
+  // （Windows / macOS / Linux），两套词汇不同，这里做映射而不是直接透传 ——
+  // 直接透传会让 CH 报出 "MacIntel" 这种真实浏览器从不出现的值。
+  {
+    const std::string fb_platform =
+        base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+            "fp-platform");
+    if (!fb_platform.empty()) {
+      if (fb_platform == "Win32" || fb_platform == "Win64") {
+        return "Windows";
+      }
+      if (fb_platform == "MacIntel" || fb_platform == "MacPPC" ||
+          fb_platform == "Mac68K") {
+        return "macOS";
+      }
+      if (fb_platform.starts_with("Linux")) {
+        return "Linux";
+      }
+      // 认不出的值**不猜**：透传一个 CH 词汇表里没有的字符串，比保持宿主真值
+      // 更容易被识别。落回下面的原生分支。
+    }
+  }
+
 #if BUILDFLAG(IS_ANDROID)
   if (base::android::device_info::is_desktop() ||
       base::android::device_info::is_xr()) {
