+// FingerBrowser L2: deterministic canvas noise for the encode path. toDataURL
+// and toBlob both encode the whole canvas, so noising a copy here covers both
+// while leaving the source pixmap untouched. Returns a noised copy backed by
+// `storage` (which must outlive the returned pixmap) when a per-profile seed is
+// set and the canvas is large enough; otherwise returns the original. Small
+// canvases stay unnoised, matching the getImageData seam so the two paths agree
+// and the putImageData->getImageData round-trip detectors probe stays lossless.
+SkPixmap FingerBrowserPixmapForEncoding(const SkPixmap& pixmap,
+                                        SkBitmap& storage) {
+  const int64_t encode_pixels =
+      static_cast<int64_t>(pixmap.width()) * pixmap.height();
+  SkPixmap noised;
+  if (const uint32_t fb_seed = fingerbrowser::CanvasSeed();
+      fb_seed && encode_pixels >= fingerbrowser::kMinCanvasNoisePixels &&
+      pixmap.addr() && storage.tryAllocPixels(pixmap.info()) &&
+      pixmap.readPixels(storage.pixmap()) && storage.peekPixels(&noised)) {
+    // Origin (0, 0): the whole canvas. Sharing the coordinate-keyed function
+    // with the getImageData seam means toDataURL and getImageData report the
+    // same value for the same pixel.
+    fingerbrowser::PerturbPixelsAt(
+        static_cast<uint8_t*>(noised.writable_addr()), noised.computeByteSize(),
+        fb_seed, noised.info().bytesPerPixel(), noised.rowBytes(),
+        noised.width(), noised.height(), 0, 0);
+    return noised;
+  }
+  return pixmap;
+}
