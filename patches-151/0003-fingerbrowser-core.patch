@@ -0,0 +1,431 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/fingerbrowser/fingerbrowser_policy.h"
+
+#include <memory>
+#include <string>
+#include <string_view>
+
+#include "base/check.h"
+#include "base/command_line.h"
+#include "base/environment.h"
+#include "base/files/file_util.h"
+#include "base/json/json_reader.h"
+#include "base/logging.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/values.h"
+#include "build/build_config.h"
+#include "chrome/common/chrome_switches.h"
+#include "components/permissions/switches.h"
+#include "content/public/common/content_switches.h"
+#include "ui/base/ui_base_switches.h"
+#include "unicode/timezone.h"
+#include "unicode/unistr.h"
+
+#if BUILDFLAG(IS_POSIX) || BUILDFLAG(IS_FUCHSIA)
+#include <time.h>
+#endif
+
+namespace fingerbrowser {
+namespace {
+
+constexpr int kPolicySchemaVersion = 1;
+constexpr int kMinWindowSide = 200;
+constexpr int kMaxWindowSide = 10000;
+
+bool IsSensitiveText(std::string_view value) {
+  const std::string lower = base::ToLowerASCII(value);
+  return lower.find("password") != std::string::npos ||
+         lower.find("token") != std::string::npos ||
+         lower.find("secret") != std::string::npos ||
+         lower.find("encrypted") != std::string::npos ||
+         lower.find("cookie") != std::string::npos ||
+         lower.find("cache") != std::string::npos;
+}
+
+bool ContainsSensitiveData(const base::Value& value) {
+  if (value.is_string()) {
+    return IsSensitiveText(value.GetString());
+  }
+  if (value.is_dict()) {
+    for (const auto [key, entry] : value.GetDict()) {
+      if (IsSensitiveText(key) || ContainsSensitiveData(entry)) {
+        return true;
+      }
+    }
+  }
+  if (value.is_list()) {
+    for (const base::Value& entry : value.GetList()) {
+      if (ContainsSensitiveData(entry)) {
+        return true;
+      }
+    }
+  }
+  return false;
+}
+
+bool IsSafePolicyString(std::string_view value) {
+  if (value.empty() || value.size() > 128) {
+    return false;
+  }
+  for (const char c : value) {
+    if (base::IsAsciiWhitespace(c) || c < 0x20 || c == 0x7f) {
+      return false;
+    }
+  }
+  return true;
+}
+
+// Looser than IsSafePolicyString: allows interior spaces, parentheses and
+// commas (real GPU strings look like "ANGLE (Apple, Apple M1, ...)") while
+// still rejecting control characters and over-long values. Leading/trailing
+// whitespace is rejected. Sensitive content is already filtered globally by
+// ContainsSensitiveData() before this runs.
+bool IsSafeDisplayString(std::string_view value) {
+  if (value.empty() || value.size() > 256) {
+    return false;
+  }
+  if (base::IsAsciiWhitespace(value.front()) ||
+      base::IsAsciiWhitespace(value.back())) {
+    return false;
+  }
+  for (const char c : value) {
+    if (c == '\t' || c == '\n' || c == '\r' || (c >= 0 && c < 0x20) ||
+        c == 0x7f) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool IsValidTimeZone(std::string_view timezone) {
+  if (!IsSafePolicyString(timezone)) {
+    return false;
+  }
+  std::unique_ptr<icu::TimeZone> zone(icu::TimeZone::createTimeZone(
+      icu::UnicodeString::fromUTF8(std::string(timezone))));
+  return zone && *zone != icu::TimeZone::getUnknown();
+}
+
+bool IsValidWindowSide(int value) {
+  return value >= kMinWindowSide && value <= kMaxWindowSide;
+}
+
+std::optional<FingerBrowserPolicy> ParsePolicyDict(
+    const base::DictValue& root) {
+  const std::optional<int> schema_version = root.FindInt("schemaVersion");
+  const std::string* profile_id = root.FindString("profileId");
+  const std::string* runtime_channel = root.FindString("runtimeChannel");
+  const base::DictValue* fingerprint_policy =
+      root.FindDict("fingerprintPolicy");
+  if (schema_version != kPolicySchemaVersion || !profile_id ||
+      profile_id->empty() || !runtime_channel ||
+      *runtime_channel != "custom-kernel" || !fingerprint_policy) {
+    return std::nullopt;
+  }
+
+  const std::string* locale = fingerprint_policy->FindString("locale");
+  const std::string* timezone = fingerprint_policy->FindString("timezone");
+  const base::DictValue* window_size =
+      fingerprint_policy->FindDict("windowSize");
+  const std::string* permission_defaults =
+      fingerprint_policy->FindString("permissionDefaults");
+  const std::string* webrtc_ip_policy =
+      fingerprint_policy->FindString("webrtcIpPolicy");
+  if (!locale || !timezone || !window_size || !permission_defaults ||
+      !webrtc_ip_policy) {
+    return std::nullopt;
+  }
+
+  const std::optional<int> width = window_size->FindInt("width");
+  const std::optional<int> height = window_size->FindInt("height");
+  if (!width || !height || !IsSafePolicyString(*locale) ||
+      !IsValidTimeZone(*timezone) || !IsValidWindowSide(*width) ||
+      !IsValidWindowSide(*height) ||
+      (*permission_defaults != "ask" && *permission_defaults != "deny") ||
+      (*webrtc_ip_policy != "default" &&
+       *webrtc_ip_policy != "disable_non_proxied_udp")) {
+    return std::nullopt;
+  }
+
+  FingerBrowserPolicy policy;
+  policy.profile_id = *profile_id;
+  policy.locale = *locale;
+  policy.timezone = *timezone;
+  policy.window_width = *width;
+  policy.window_height = *height;
+  policy.permission_defaults = *permission_defaults;
+  policy.webrtc_ip_policy = *webrtc_ip_policy;
+
+  // Brand sits at the policy root rather than under hardwareProfile: it
+  // describes the browser product, not the machine.
+  if (const std::string* brand = fingerprint_policy->FindString("brand");
+      brand && IsSafeDisplayString(*brand)) {
+    policy.brand = *brand;
+  }
+
+  // Optional L2 hardware profile. Every field is optional and individually
+  // validated; an invalid field is skipped (left unset) rather than failing
+  // the whole policy, so compliant policies without this block are unaffected.
+  if (const base::DictValue* hardware_profile =
+          fingerprint_policy->FindDict("hardwareProfile")) {
+    if (const std::string* gpu_vendor =
+            hardware_profile->FindString("gpuVendor");
+        gpu_vendor && IsSafeDisplayString(*gpu_vendor)) {
+      policy.gpu_vendor = *gpu_vendor;
+    }
+    if (const std::string* gpu_renderer =
+            hardware_profile->FindString("gpuRenderer");
+        gpu_renderer && IsSafeDisplayString(*gpu_renderer)) {
+      policy.gpu_renderer = *gpu_renderer;
+    }
+    if (const std::string* webgpu_vendor =
+            hardware_profile->FindString("webgpuVendor");
+        webgpu_vendor && IsSafeDisplayString(*webgpu_vendor)) {
+      policy.webgpu_vendor = *webgpu_vendor;
+    }
+    if (const std::string* webgpu_architecture =
+            hardware_profile->FindString("webgpuArchitecture");
+        webgpu_architecture && IsSafeDisplayString(*webgpu_architecture)) {
+      policy.webgpu_architecture = *webgpu_architecture;
+    }
+    if (const std::string* webgpu_device =
+            hardware_profile->FindString("webgpuDevice");
+        webgpu_device && IsSafeDisplayString(*webgpu_device)) {
+      policy.webgpu_device = *webgpu_device;
+    }
+    if (const std::string* webgpu_description =
+            hardware_profile->FindString("webgpuDescription");
+        webgpu_description && IsSafeDisplayString(*webgpu_description)) {
+      policy.webgpu_description = *webgpu_description;
+    }
+    if (const std::string* platform =
+            hardware_profile->FindString("platform");
+        platform && IsSafeDisplayString(*platform)) {
+      policy.platform = *platform;
+    }
+    if (const std::optional<int> hardware_concurrency =
+            hardware_profile->FindInt("hardwareConcurrency");
+        hardware_concurrency && *hardware_concurrency >= 1 &&
+        *hardware_concurrency <= 128) {
+      policy.hardware_concurrency = *hardware_concurrency;
+    }
+    if (const std::optional<int> device_memory =
+            hardware_profile->FindInt("deviceMemory");
+        device_memory && (*device_memory == 1 || *device_memory == 2 ||
+                          *device_memory == 4 || *device_memory == 8)) {
+      policy.device_memory = *device_memory;
+    }
+    if (const std::optional<int> canvas_noise =
+            hardware_profile->FindInt("canvasNoise");
+        canvas_noise && *canvas_noise > 0) {
+      policy.canvas_noise_seed = *canvas_noise;
+    }
+    if (const std::optional<int> audio_noise =
+            hardware_profile->FindInt("audioNoise");
+        audio_noise && *audio_noise > 0) {
+      policy.audio_noise_seed = *audio_noise;
+    }
+    if (const std::optional<int> screen_width =
+            hardware_profile->FindInt("screenWidth");
+        screen_width && IsValidWindowSide(*screen_width)) {
+      policy.screen_width = *screen_width;
+    }
+    if (const std::optional<int> screen_height =
+            hardware_profile->FindInt("screenHeight");
+        screen_height && IsValidWindowSide(*screen_height)) {
+      policy.screen_height = *screen_height;
+    }
+  }
+
+  // 地理位置：经纬度必须成对出现且在合法范围内，缺一不可（只给一半会造出
+  // 本初子午线/赤道上的假坐标，比不伪装更可疑）。
+  if (const base::DictValue* geo = fingerprint_policy->FindDict("geolocation")) {
+    const std::optional<double> lat = geo->FindDouble("latitude");
+    const std::optional<double> lon = geo->FindDouble("longitude");
+    if (lat && lon && *lat >= -90.0 && *lat <= 90.0 && *lon >= -180.0 &&
+        *lon <= 180.0) {
+      policy.has_geo = true;
+      policy.geo_latitude_e6 = static_cast<int>(*lat * 1e6);
+      policy.geo_longitude_e6 = static_cast<int>(*lon * 1e6);
+    }
+  }
+
+  if (const std::optional<bool> block =
+          fingerprint_policy->FindBool("blockCjkFonts")) {
+    policy.block_cjk_fonts = *block;
+  }
+
+  return policy;
+}
+
+void ApplyTimezone(std::string_view timezone) {
+  std::unique_ptr<base::Environment> environment = base::Environment::Create();
+  environment->SetVar("TZ", std::string(timezone));
+#if BUILDFLAG(IS_POSIX) || BUILDFLAG(IS_FUCHSIA)
+  tzset();
+#endif
+  icu::TimeZone::adoptDefault(icu::TimeZone::createTimeZone(
+      icu::UnicodeString::fromUTF8(std::string(timezone))));
+}
+
+}  // namespace
+
+FingerBrowserPolicy::FingerBrowserPolicy() = default;
+
+FingerBrowserPolicy::FingerBrowserPolicy(const FingerBrowserPolicy&) = default;
+
+FingerBrowserPolicy& FingerBrowserPolicy::operator=(
+    const FingerBrowserPolicy&) = default;
+
+FingerBrowserPolicy::~FingerBrowserPolicy() = default;
+
+std::optional<FingerBrowserPolicy> LoadFingerBrowserPolicy(
+    const base::FilePath& policy_path) {
+  std::string contents;
+  if (!base::ReadFileToString(policy_path, &contents)) {
+    LOG(ERROR) << "FingerBrowser policy file is missing or unreadable: "
+               << policy_path;
+    return std::nullopt;
+  }
+  std::optional<base::DictValue> root =
+      base::JSONReader::ReadDict(contents, base::JSON_PARSE_RFC, 20);
+  if (!root) {
+    LOG(ERROR) << "FingerBrowser policy JSON is invalid";
+    return std::nullopt;
+  }
+  if (ContainsSensitiveData(base::Value(root->Clone()))) {
+    LOG(ERROR) << "FingerBrowser policy contains sensitive data";
+    return std::nullopt;
+  }
+  std::optional<FingerBrowserPolicy> policy = ParsePolicyDict(*root);
+  if (!policy) {
+    LOG(ERROR) << "FingerBrowser policy schema is invalid";
+  }
+  return policy;
+}
+
+void ApplyFingerBrowserPolicy(const FingerBrowserPolicy& policy,
+                              base::CommandLine* command_line) {
+  CHECK(command_line);
+  // Marks this process as running under a FingerBrowser profile. Read by
+  // components/embedder_support/user_agent_utils.cc, which otherwise blanks
+  // every high-entropy Client Hint whenever --user-agent is present -- leaving
+  // a populated UA string and brand list next to an empty platform_version /
+  // uaFullVersion / fullVersionList. No real Chrome install reports that
+  // combination, and upstream's own comment warns that empty low-entropy hints
+  // trip web application firewalls.
+  command_line->AppendSwitch("fp-active");
+  if (!policy.brand.empty()) {
+    command_line->AppendSwitchASCII("fp-brand", policy.brand);
+  }
+  command_line->AppendSwitchASCII(switches::kLang, policy.locale);
+  command_line->AppendSwitchASCII(
+      switches::kWindowSize,
+      base::NumberToString(policy.window_width) + "," +
+          base::NumberToString(policy.window_height));
+  if (policy.permission_defaults == "deny") {
+    command_line->AppendSwitch(permissions::switches::kDenyPermissionPrompts);
+  }
+  if (policy.webrtc_ip_policy != "default") {
+    // switches::kForceWebRtcIPHandlingPolicy is not consumed anywhere in this
+    // build, so passing it did nothing and WebRTC kept leaking the real IP.
+    // Send a dedicated fp switch that the peer-connection factory reads in the
+    // renderer instead.
+    command_line->AppendSwitchASCII("fp-webrtc-ip-policy",
+                                    policy.webrtc_ip_policy);
+  }
+
+  // L2 hardware profile -> renderer switches. Switch names must stay in sync
+  // with third_party/blink/.../fingerbrowser/fingerbrowser_fingerprint.h and
+  // the propagation list in render_process_host_impl.cc.
+  if (!policy.gpu_vendor.empty()) {
+    command_line->AppendSwitchASCII("fp-gpu-vendor", policy.gpu_vendor);
+  }
+  if (!policy.gpu_renderer.empty()) {
+    command_line->AppendSwitchASCII("fp-gpu-renderer", policy.gpu_renderer);
+  }
+  if (!policy.webgpu_vendor.empty()) {
+    command_line->AppendSwitchASCII("fp-webgpu-vendor", policy.webgpu_vendor);
+  }
+  if (!policy.webgpu_architecture.empty()) {
+    command_line->AppendSwitchASCII("fp-webgpu-architecture",
+                                    policy.webgpu_architecture);
+  }
+  if (!policy.webgpu_device.empty()) {
+    command_line->AppendSwitchASCII("fp-webgpu-device", policy.webgpu_device);
+  }
+  if (!policy.webgpu_description.empty()) {
+    command_line->AppendSwitchASCII("fp-webgpu-description",
+                                    policy.webgpu_description);
+  }
+  if (!policy.platform.empty()) {
+    command_line->AppendSwitchASCII("fp-platform", policy.platform);
+  }
+  if (policy.hardware_concurrency > 0) {
+    command_line->AppendSwitchASCII(
+        "fp-hardware-concurrency",
+        base::NumberToString(policy.hardware_concurrency));
+  }
+  if (policy.device_memory > 0) {
+    command_line->AppendSwitchASCII(
+        "fp-device-memory", base::NumberToString(policy.device_memory));
+  }
+  if (policy.canvas_noise_seed > 0) {
+    command_line->AppendSwitchASCII(
+        "fp-canvas-noise", base::NumberToString(policy.canvas_noise_seed));
+  }
+  if (policy.audio_noise_seed > 0) {
+    command_line->AppendSwitchASCII(
+        "fp-audio-noise", base::NumberToString(policy.audio_noise_seed));
+  }
+
+  // Timezone and Accept-Language must also reach the renderer. ApplyTimezone()
+  // below only adjusts this (browser) process: tzset() is POSIX-only and
+  // icu::TimeZone::adoptDefault() is per-process, while Intl/Date run in the
+  // renderer against its own ICU instance. Likewise --lang sets the UI locale,
+  // not the Accept-Language list that navigator.language reports.
+  command_line->AppendSwitchASCII("fp-timezone", policy.timezone);
+  command_line->AppendSwitchASCII("fp-accept-lang", policy.locale);
+
+  if (policy.screen_width > 0) {
+    command_line->AppendSwitchASCII("fp-screen-width",
+                                    base::NumberToString(policy.screen_width));
+  }
+  if (policy.screen_height > 0) {
+    command_line->AppendSwitchASCII("fp-screen-height",
+                                    base::NumberToString(policy.screen_height));
+  }
+  if (policy.has_geo) {
+    command_line->AppendSwitchASCII(
+        "fp-geo-lat-e6", base::NumberToString(policy.geo_latitude_e6));
+    command_line->AppendSwitchASCII(
+        "fp-geo-lon-e6", base::NumberToString(policy.geo_longitude_e6));
+  }
+  if (policy.block_cjk_fonts) {
+    command_line->AppendSwitch("fp-block-cjk-fonts");
+  }
+
+  ApplyTimezone(policy.timezone);
+}
+
+bool ApplyFingerBrowserPolicyFromCommandLine(base::CommandLine* command_line) {
+  CHECK(command_line);
+  if (!command_line->HasSwitch(switches::kFingerBrowserPolicy)) {
+    return true;
+  }
+  const base::FilePath policy_path =
+      command_line->GetSwitchValuePath(switches::kFingerBrowserPolicy);
+  std::optional<FingerBrowserPolicy> policy =
+      LoadFingerBrowserPolicy(policy_path);
+  if (!policy) {
+    return false;
+  }
+  ApplyFingerBrowserPolicy(*policy, command_line);
+  return true;
+}
+
+}  // namespace fingerbrowser
