+inline std::string SwitchValue(const char* name) {
+  const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+  return cmd->HasSwitch(name) ? cmd->GetSwitchValueASCII(name) : std::string();
+}
+
+inline int IntSwitch(const char* name) {
+  const std::string value = SwitchValue(name);
+  int parsed = 0;
+  return (!value.empty() && base::StringToInt(value, &parsed)) ? parsed : 0;
+}
+
+inline uint32_t CanvasSeed() {
+  return static_cast<uint32_t>(IntSwitch(kCanvasNoiseSwitch));
+}
+
+inline uint32_t AudioSeed() {
+  return static_cast<uint32_t>(IntSwitch(kAudioNoiseSwitch));
+}
+
+// Minimum canvas area (in pixels) to noise. Real fingerprinting reads rendered
+// content — text, gradients — from canvases well above this. Tiny canvases are
+// how noise detectors probe the readback path: CreepJS getPixelMods writes
+// known data to an 8x8 canvas via putImageData and flags any difference on
+// getImageData, and putImageData->getImageData is lossless on a real browser.
+// Gating on the SOURCE CANVAS size (not the read region) keeps that round-trip
+// lossless on small buffers while a small sub-read of a large canvas still gets
+// noised, preserving the coordinate consistency from the canvas-readback patch.
+inline constexpr int64_t kMinCanvasNoisePixels = 1024;
+
+// mulberry32 — small, fast, deterministic PRNG.
+inline uint32_t NextRandom(uint32_t& state) {
+  state += 0x6D2B79F5u;
+  uint32_t t = state;
+  t = (t ^ (t >> 15)) * (t | 1u);
+  t ^= t + (t ^ (t >> 7)) * (t | 61u);
+  return t ^ (t >> 14);
+}
+
+// Perturb ~3% of each color channel by +/-1, deterministically. Alpha (the 4th
+// byte of each pixel) is left untouched so the change stays imperceptible.
+// Deterministic hash of (seed, x, y). Finalizer-style mixing so that adjacent
+// coordinates do not produce correlated output.
+inline uint32_t PixelHash(uint32_t seed, int32_t x, int32_t y) {
+  uint32_t h = seed;
+  h ^= static_cast<uint32_t>(x) * 0x9E3779B1u;
+  h = (h ^ (h >> 15)) * 0x85EBCA6Bu;
+  h ^= static_cast<uint32_t>(y) * 0xC2B2AE35u;
+  h = (h ^ (h >> 13)) * 0xC2B2AE35u;
+  return h ^ (h >> 16);
+}
+
+// Perturb a pixel block, keying the noise on each pixel's ABSOLUTE canvas
+// coordinate rather than on its offset within the returned buffer.
+//
+// This distinction is load-bearing. A buffer-offset-keyed stream gives the same
+// canvas pixel different noise depending on the shape of the read that returned
+// it, so getImageData(sx, sy, w, h) disagrees with getImageData(0, 0, W, H) for
+// the pixels they share. That breaks legitimate partial-readback image
+// processing (measured: 59 mismatched bytes over a 20x20 sub-read). Keying on
+// absolute coordinates makes every read of a given pixel agree, which is a
+// correctness requirement for the canvas API independent of any defense goal.
+inline void PerturbPixelsAt(uint8_t* data,
+                            size_t byte_length,
+                            uint32_t seed,
+                            int bytes_per_pixel,
+                            size_t row_bytes,
+                            int32_t width,
+                            int32_t height,
+                            int32_t origin_x,
+                            int32_t origin_y) {
+  if (!data || !seed || bytes_per_pixel < 3 || width <= 0 || height <= 0) {
+    return;
+  }
+  const int color_channels = bytes_per_pixel >= 4 ? 3 : bytes_per_pixel;
+  for (int32_t row = 0; row < height; ++row) {
+    const size_t row_offset = static_cast<size_t>(row) * row_bytes;
+    if (row_offset >= byte_length) {
+      break;
+    }
+    for (int32_t col = 0; col < width; ++col) {
+      const size_t i =
+          row_offset + static_cast<size_t>(col) *
+                           static_cast<size_t>(bytes_per_pixel);
+      if (i + static_cast<size_t>(bytes_per_pixel) > byte_length) {
+        break;
+      }
+      // One hash per pixel, sliced into per-channel fields, rather than one
+      // hash per channel. Hashing each channel separately cost four PixelHash
+      // calls per pixel (~16 multiplies) and made getImageData 5-10x slower;
+      // on canvas-heavy pages that was enough to stall rendering outright.
+      // Small test canvases hid this -- the cost only shows at real sizes.
+      //
+      // Layout: bits 0-7, 8-15, 16-23 carry each channel's probability field,
+      // bits 24-26 carry its sign. 27 bits used of 32, no overlap.
+      const uint32_t h = PixelHash(seed, origin_x + col, origin_y + row);
+      for (int channel = 0; channel < color_channels; ++channel) {
+        if (((h >> (channel * 8)) & 0xFFu) < 8u) {  // ~3.1% of channels
+          const int delta = (h & (1u << (24 + channel))) ? 1 : -1;
+          const int value = static_cast<int>(data[i + channel]) + delta;
+          data[i + channel] =
+              static_cast<uint8_t>(value < 0 ? 0 : (value > 255 ? 255 : value));
+        }
+      }
+    }
+  }
+}
+
+// Add an inaudible deterministic perturbation to float audio samples. Used by
+// the offline-render audio seam (Build 2); harmless if unreferenced.
+inline void PerturbAudio(float* data, size_t count, uint32_t seed) {
+  if (!data || !seed) {
+    return;
+  }
+  // Key the perturbation on each sample's VALUE, not its position. A
+  // position-sequential PRNG gave every sample an independent nudge, which
+  // destroyed the duplicate sample values a real render naturally has: measured
+  // unique-sample count jumped from ~4736/5000 to a maxed-out 5000/5000, a
+  // signature detectors read (CreepJS reports it as "unique"). Hashing the
+  // sample value means equal samples get equal noise and stay equal, so the
+  // duplicate structure is preserved while the fingerprint still shifts
+  // deterministically per profile.
+  for (size_t i = 0; i < count; ++i) {
+    uint32_t bits = 0;
+    static_assert(sizeof(bits) == sizeof(float), "float must be 32-bit");
+    __builtin_memcpy(&bits, &data[i], sizeof(bits));
+    const uint32_t h = PixelHash(seed, static_cast<int32_t>(bits), 0);
+    const float unit = static_cast<float>(h & 0xFFFFu) / 65535.0f - 0.5f;
+    data[i] += unit * 2e-7f;
+  }
+}
