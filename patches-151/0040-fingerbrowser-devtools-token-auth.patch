new file mode 100644
index 0000000000..4b2642f613
--- /dev/null
+++ b/chrome/browser/fingerbrowser/fingerbrowser_stdin_config.h
@@ -0,0 +1,57 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_FINGERBROWSER_FINGERBROWSER_STDIN_CONFIG_H_
+#define CHROME_BROWSER_FINGERBROWSER_FINGERBROWSER_STDIN_CONFIG_H_
+
+#include <string>
+
+#include "base/functional/callback.h"
+
+namespace fingerbrowser {
+
+// FingerBrowser: the single read of stdin.
+//
+// Two features are fed by the same channel -- the DevTools authentication token
+// and the seeded passwords -- and this module exists because **stdin can only be
+// read once**. Two independent readers would race for the same bytes and one of
+// them would silently get nothing. So there is exactly one read, here, and the
+// parsed pieces are handed to whoever needs them.
+//
+// Expected payload (a single JSON object):
+//
+//   { "version": 1,
+//     "devtoolsToken": "<hex>",         // optional
+//     "entries": [ { "origin": …, "username": …, "password": … } ] }  // optional
+//
+// Nothing here is written to disk, logged, or placed on the command line. The
+// command line in particular is readable by every process on the machine, which
+// is precisely the attacker this token defends against.
+
+// Call once, early -- from PreCreateThreads, before the remote debugging server
+// can start. Two things happen:
+//
+//   1. If --fp-devtools-auth=stdin was passed, the DevTools gate is immediately
+//      moved to "required but not yet loaded", which refuses everything. This
+//      must happen *before* any bytes are read: whether a token is coming can
+//      only be declared up front, never inferred from the payload, because by
+//      the time the JSON is parsed the port would already have been open and
+//      unguarded.
+//   2. The actual read is posted to a blocking thread pool sequence. It is not
+//      read synchronously on the UI thread: if the client dies before writing,
+//      EOF never arrives and startup would hang forever. Refusing during the
+//      gap is the answer to that, not blocking.
+void StartStdinConfigRead();
+
+// Hand the raw payload to a consumer once it has been read. Invoked immediately
+// if the read already finished. The payload is moved out and the internal copy
+// cleared, so the credentials do not outlive their single use.
+//
+// Called with an empty string when no stdin channel was requested at all, so
+// consumers get a definite answer rather than waiting forever.
+void TakeStdinPayload(base::OnceCallback<void(std::string)> callback);
+
+}  // namespace fingerbrowser
+
+#endif  // CHROME_BROWSER_FINGERBROWSER_FINGERBROWSER_STDIN_CONFIG_H_
