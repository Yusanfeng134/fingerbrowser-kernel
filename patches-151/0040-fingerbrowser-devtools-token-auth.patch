diff --git a/content/browser/devtools/devtools_auth.cc b/content/browser/devtools/devtools_auth.cc
new file mode 100644
index 0000000000..c53b6bc36c
--- /dev/null
+++ b/content/browser/devtools/devtools_auth.cc
@@ -0,0 +1,82 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "content/public/browser/devtools_auth.h"
+
+#include <utility>
+
+#include "base/no_destructor.h"
+#include "base/synchronization/lock.h"
+#include "crypto/secure_util.h"
+
+namespace content {
+
+const char kDevToolsAuthHeader[] = "x-fp-devtools-token";
+
+namespace {
+
+struct AuthConfig {
+  base::Lock lock;
+  DevToolsAuthState state GUARDED_BY(lock) = DevToolsAuthState::kNotRequested;
+  std::string token GUARDED_BY(lock);
+};
+
+AuthConfig& GetConfig() {
+  static base::NoDestructor<AuthConfig> config;
+  return *config;
+}
+
+}  // namespace
+
+void RequireDevToolsAuth() {
+  AuthConfig& config = GetConfig();
+  base::AutoLock guard(config.lock);
+  // Only ever tightens. A second call cannot walk an already-loaded token back
+  // to kPending.
+  if (config.state == DevToolsAuthState::kNotRequested) {
+    config.state = DevToolsAuthState::kPending;
+  }
+}
+
+void SetDevToolsAuthToken(std::string token) {
+  AuthConfig& config = GetConfig();
+  base::AutoLock guard(config.lock);
+  if (token.empty()) {
+    // Treat empty as "still not configured", never as "the token is the empty
+    // string". Otherwise a request with no header at all would compare equal
+    // and every check would pass -- the failure mode looks identical to working
+    // authentication from the outside.
+    return;
+  }
+  config.token = std::move(token);
+  config.state = DevToolsAuthState::kConfigured;
+}
+
+DevToolsAuthState GetDevToolsAuthState() {
+  AuthConfig& config = GetConfig();
+  base::AutoLock guard(config.lock);
+  return config.state;
+}
+
+bool DevToolsAuthAllows(std::string_view presented) {
+  AuthConfig& config = GetConfig();
+  base::AutoLock guard(config.lock);
+  switch (config.state) {
+    case DevToolsAuthState::kNotRequested:
+      return true;
+    case DevToolsAuthState::kPending:
+      return false;
+    case DevToolsAuthState::kConfigured:
+      break;
+  }
+  // Length is not secret (it is fixed by our own client), but SecureMemEqual
+  // requires equal sizes, so check first.
+  if (presented.size() != config.token.size()) {
+    return false;
+  }
+  return crypto::SecureMemEqual(base::as_byte_span(presented),
+                                base::as_byte_span(config.token));
+}
+
+}  // namespace content
