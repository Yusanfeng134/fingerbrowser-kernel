+#ifndef CONTENT_PUBLIC_BROWSER_DEVTOOLS_AUTH_H_
+#define CONTENT_PUBLIC_BROWSER_DEVTOOLS_AUTH_H_
+
+#include <string>
+#include <string_view>
+
+#include "content/common/content_export.h"
+
+namespace content {
+
+// FingerBrowser: header-token authentication for the remote debugging endpoint.
+//
+// The port opened by --remote-debugging-port grants *complete* control of the
+// profile to anyone who can connect: read cookies, export storage, inject
+// script, download files. A random port does not help -- the number is written
+// to DevToolsActivePort in the profile directory, and scanning 1024-65535 takes
+// seconds.
+//
+// The two protections upstream already has both target a different attacker:
+//   - Host header validation blocks DNS rebinding (a remote page resolving a
+//     name to 127.0.0.1). A local process just sends Host: 127.0.0.1:<port>.
+//   - --remote-allow-origins validates the WebSocket Origin header, i.e. it
+//     blocks connections initiated by a *page*. A local script sends no Origin
+//     at all and sails through.
+//
+// Neither covers "another process on this machine", which is the threat here.
+// Note what this is really worth: a process running as the *same user* can
+// already read the profile's cookie database directly (DPAPI keys are bound to
+// the user account), so against that attacker the token is defence in depth.
+// The real gain is that loopback TCP has no user isolation while the filesystem
+// does -- a different user account, or a sandboxed process, can reach the port
+// but cannot read the profile directory. The token puts the port back on the
+// same boundary as the files.
+//
+// The token deliberately does NOT arrive on the command line: the whole process
+// list is world-readable, and this credential is worth more than any single
+// password. It comes in over stdin (see chrome/browser/fingerbrowser).
+
+// Gate state. The middle one is the reason this is an enum rather than a bool.
+enum class DevToolsAuthState {
+  // No authentication was requested. Behaviour is exactly as upstream --
+  // existing --remote-debugging-port workflows are untouched.
+  kNotRequested,
+  // Authentication was requested but the token has not arrived yet. Everything
+  // is refused.
+  //
+  // This state exists because of an ordering problem that has no comfortable
+  // solution: the remote debugging server starts in PreMainMessageLoopRunImpl,
+  // while the token is read from stdin on a blocking thread pool sequence (it
+  // cannot be read synchronously on the UI thread -- if the client dies before
+  // writing, EOF never arrives and startup would hang forever). So there is a
+  // window where the port exists and the token does not.
+  //
+  // Refusing during that window is the only answer that neither hangs startup
+  // nor leaves the port bare. A client that connects too early gets 403 and
+  // must retry; that is a retry, not a breach.
+  kPending,
+  // Token loaded. Requests must present a matching header.
+  kConfigured,
+};
+
+// Called before the remote debugging server can possibly start, when the
+// command line asks for stdin-delivered authentication. Flips the gate to
+// kPending so the window described above is closed rather than open.
+CONTENT_EXPORT void RequireDevToolsAuth();
+
+// Called once when the token has been read. An empty token is rejected and
+// leaves the gate at kPending: an empty string compares equal to a missing
+// header, which would look like "authentication passes" while being no
+// authentication at all.
+CONTENT_EXPORT void SetDevToolsAuthToken(std::string token);
+
+CONTENT_EXPORT DevToolsAuthState GetDevToolsAuthState();
+
+// True when the request may proceed. `presented` is the raw header value, empty
+// when the header is absent. Constant-time comparison; a local attacker timing
+// this is not realistic, but the guarantee costs nothing.
+CONTENT_EXPORT bool DevToolsAuthAllows(std::string_view presented);
+
+// The header clients must send. Lower case because net::HttpServer lower-cases
+// header names while parsing, so this is also the lookup key.
+CONTENT_EXPORT extern const char kDevToolsAuthHeader[];
+
+}  // namespace content
+
+#endif  // CONTENT_PUBLIC_BROWSER_DEVTOOLS_AUTH_H_
