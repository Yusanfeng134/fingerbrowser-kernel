new file mode 100644
index 0000000000..835f2fa1fe
--- /dev/null
+++ b/chrome/browser/fingerbrowser/fingerbrowser_stdin_config.cc
@@ -0,0 +1,150 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/fingerbrowser/fingerbrowser_stdin_config.h"
+
+#include <stdio.h>
+
+#include <optional>
+#include <utility>
+
+#include "base/command_line.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/no_destructor.h"
+#include "base/task/thread_pool.h"
+#include "base/values.h"
+#include "content/public/browser/browser_thread.h"
+#include "content/public/browser/devtools_auth.h"
+
+namespace fingerbrowser {
+
+namespace {
+
+constexpr char kSeedPasswordsSwitch[] = "fp-seed-passwords";
+constexpr char kDevToolsAuthSwitch[] = "fp-devtools-auth";
+constexpr char kStdinValue[] = "stdin";
+
+// One-off payload sized for shop credentials. The cap exists to reject
+// malformed input, not for performance.
+constexpr size_t kMaxStdinBytes = 1024 * 1024;
+
+enum class ReadState { kNotRequested, kPending, kDone };
+
+struct StdinConfig {
+  ReadState state = ReadState::kNotRequested;
+  std::string payload;
+  base::OnceCallback<void(std::string)> waiter;
+};
+
+StdinConfig& GetConfig() {
+  static base::NoDestructor<StdinConfig> config;
+  return *config;
+}
+
+bool WantsStdin(const char* switch_name) {
+  return base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+             switch_name) == kStdinValue;
+}
+
+// Runs on a blocking sequence.
+std::string ReadStdinBlocking() {
+  std::string raw;
+  if (!base::ReadStreamToStringWithMaxSize(stdin, kMaxStdinBytes, &raw)) {
+    // Neither the content nor its length is printed.
+    fprintf(stderr, "[fp-stdin-config] error=stdin_read_failed\n");
+    fflush(stderr);
+    return std::string();
+  }
+  return raw;
+}
+
+// Pull just the token out and give it to content. The rest of the payload is
+// left alone for the password seeder to consume later.
+void ApplyDevToolsToken(const std::string& raw) {
+  if (!WantsStdin(kDevToolsAuthSwitch)) {
+    return;
+  }
+  // Every failure below leaves the gate at kPending, i.e. DevTools stays shut.
+  // That is the intended direction: a browser that was told to require a token
+  // and did not get one must not fall back to serving everyone.
+  std::optional<base::DictValue> root =
+      base::JSONReader::ReadDict(raw, base::JSON_PARSE_RFC);
+  if (!root) {
+    fprintf(stderr, "[fp-devtools-auth] error=not_json_object\n");
+    fflush(stderr);
+    return;
+  }
+  const std::string* token = root->FindString("devtoolsToken");
+  if (!token || token->empty()) {
+    // An empty token is not "a token that is the empty string" -- an absent
+    // header would compare equal to it and every request would pass. Treated
+    // as missing.
+    fprintf(stderr, "[fp-devtools-auth] error=no_token\n");
+    fflush(stderr);
+    return;
+  }
+  content::SetDevToolsAuthToken(*token);
+  // Deliberately no success line. Printing one would turn "is this browser
+  // guarded?" into something observable from the outside.
+}
+
+void OnStdinRead(std::string raw) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  ApplyDevToolsToken(raw);
+
+  StdinConfig& config = GetConfig();
+  config.state = ReadState::kDone;
+  if (config.waiter) {
+    std::move(config.waiter).Run(std::move(raw));
+    return;
+  }
+  config.payload = std::move(raw);
+}
+
+}  // namespace
+
+void StartStdinConfigRead() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+
+  const bool wants_auth = WantsStdin(kDevToolsAuthSwitch);
+  const bool wants_seed = WantsStdin(kSeedPasswordsSwitch);
+
+  // Close the gate before anything is read. See the header for why this cannot
+  // wait until the payload has been parsed.
+  if (wants_auth) {
+    content::RequireDevToolsAuth();
+  }
+  if (!wants_auth && !wants_seed) {
+    return;
+  }
+
+  GetConfig().state = ReadState::kPending;
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::USER_BLOCKING,
+       base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+      base::BindOnce(&ReadStdinBlocking), base::BindOnce(&OnStdinRead));
+}
+
+void TakeStdinPayload(base::OnceCallback<void(std::string)> callback) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  StdinConfig& config = GetConfig();
+  switch (config.state) {
+    case ReadState::kNotRequested:
+      // Answer definitively rather than leaving the caller hanging.
+      std::move(callback).Run(std::string());
+      return;
+    case ReadState::kPending:
+      config.waiter = std::move(callback);
+      return;
+    case ReadState::kDone:
+      std::move(callback).Run(std::move(config.payload));
+      config.payload.clear();
+      return;
+  }
+}
+
+}  // namespace fingerbrowser
