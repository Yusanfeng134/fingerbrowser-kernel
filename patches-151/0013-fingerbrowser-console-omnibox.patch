diff --git a/chrome/browser/fingerbrowser/fingerbrowser_console.cc b/chrome/browser/fingerbrowser/fingerbrowser_console.cc
new file mode 100644
index 0000000000..c445526547
--- /dev/null
+++ b/chrome/browser/fingerbrowser/fingerbrowser_console.cc
@@ -0,0 +1,78 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/fingerbrowser/fingerbrowser_console.h"
+
+#include "base/command_line.h"
+#include "base/no_destructor.h"
+#include "base/strings/utf_string_conversions.h"
+#include "build/build_config.h"
+#include "net/base/url_util.h"
+#include "url/gurl.h"
+#include "url/origin.h"
+
+namespace fingerbrowser {
+
+namespace {
+
+// Already passed by the client (shell-launcher.ts) to pin the console tab.
+constexpr char kConsoleUrlSwitch[] = "fp-pinned-url";
+constexpr char kConsoleTitleSwitch[] = "fp-console-title";
+
+// Parsed once: the command line does not change over the process lifetime, and
+// this is consulted on every omnibox update.
+const url::Origin& ConsoleOrigin() {
+  static const base::NoDestructor<url::Origin> origin([] {
+    const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+    const GURL url(cmd->GetSwitchValueASCII(kConsoleUrlSwitch));
+    // Loopback-only. Without this check a --fp-pinned-url pointing at a public
+    // site would let that site render under the product's own name.
+    if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS() ||
+        !net::IsLocalhost(url)) {
+      return url::Origin();
+    }
+    return url::Origin::Create(url);
+  }());
+  return *origin;
+}
+
+}  // namespace
+
+bool IsConsoleUrl(const GURL& url) {
+  const url::Origin& console = ConsoleOrigin();
+  // An opaque origin means the console was never configured; it must not
+  // compare equal to anything.
+  if (console.opaque()) {
+    return false;
+  }
+  if (!url.is_valid()) {
+    return false;
+  }
+  // Origin rather than whole-URL equality: the console is a single-page app
+  // whose routes live in the fragment (#/yunlogin-environments), so the URL
+  // changes as the user moves around while the origin stays put.
+  return url::Origin::Create(url) == console;
+}
+
+std::u16string GetConsoleOmniboxTitle(const GURL& url) {
+  if (!IsConsoleUrl(url)) {
+    return std::u16string();
+  }
+  // Native, not ASCII: the title is a product name and will normally be
+  // non-Latin ("YunLogin 管理中心"). GetSwitchValueASCII silently returns an
+  // empty string for anything outside ASCII.
+  const base::CommandLine::StringType title =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueNative(
+          kConsoleTitleSwitch);
+  if (title.empty()) {
+    return std::u16string();
+  }
+#if BUILDFLAG(IS_WIN)
+  return base::WideToUTF16(title);
+#else
+  return base::UTF8ToUTF16(title);
+#endif
+}
+
+}  // namespace fingerbrowser
diff --git a/chrome/browser/fingerbrowser/fingerbrowser_console.h b/chrome/browser/fingerbrowser/fingerbrowser_console.h
new file mode 100644
index 0000000000..fe1e0aba1b
--- /dev/null
+++ b/chrome/browser/fingerbrowser/fingerbrowser_console.h
@@ -0,0 +1,40 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_FINGERBROWSER_FINGERBROWSER_CONSOLE_H_
+#define CHROME_BROWSER_FINGERBROWSER_FINGERBROWSER_CONSOLE_H_
+
+#include <string>
+
+class GURL;
+
+namespace fingerbrowser {
+
+// The client serves its management console (environment list, proxies,
+// settings) from a local HTTP server on an OS-assigned port and hands the
+// kernel that URL at launch. Showing "http://127.0.0.1:53483/#/..." in the
+// omnibox exposes an implementation detail the user has no use for, so the
+// console is presented under a product name instead -- the same treatment
+// Chromium gives its own internal pages.
+//
+// This is deliberately narrow. Rewriting what the omnibox shows is exactly the
+// spoofing browsers exist to prevent, so the rule matches only the one origin
+// passed on the command line at launch, and only when that origin is loopback.
+// A page cannot navigate its way into the trusted presentation: it would have
+// to be served from the port our own server is holding.
+//
+// Returns true if `url` belongs to the management console origin.
+bool IsConsoleUrl(const GURL& url);
+
+// The name to show in place of the console URL, e.g. "YunLogin 管理中心".
+// Empty when the console is not configured or `url` is not the console --
+// callers treat empty as "no override, format the URL normally".
+//
+// The title comes from the command line rather than being baked in so that
+// rebranding does not require rebuilding the kernel.
+std::u16string GetConsoleOmniboxTitle(const GURL& url);
+
+}  // namespace fingerbrowser
+
+#endif  // CHROME_BROWSER_FINGERBROWSER_FINGERBROWSER_CONSOLE_H_
