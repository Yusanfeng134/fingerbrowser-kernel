+std::u16string ChromeLocationBarModelDelegate::GetDisplayTextOverride() const {
+  GURL url;
+  if (!GetURL(&url)) {
+    return std::u16string();
+  }
+  return fingerbrowser::GetConsoleOmniboxTitle(url);
+}
+
 const gfx::VectorIcon* ChromeLocationBarModelDelegate::GetVectorIconOverride()
     const {
 #if !BUILDFLAG(IS_ANDROID)
   GURL url;
   GetURL(&url);
 
+  // The management console is served over plain HTTP on loopback, which would
+  // otherwise draw the neutral "info" icon next to a product name -- reading as
+  // if the product itself were untrusted. Only the icon is overridden; the
+  // security level is left alone, since it feeds permission decisions and the
+  // page info bubble.
+  // A padlock rather than the SECURE icon: since M117 upstream's "secure" glyph
+  // is the page-info control, which next to a product name reads as a button
+  // rather than a statement about the page.
+  if (fingerbrowser::IsConsoleUrl(url)) {
+    return &(features::IsRoundedIconsEnabled() ? vector_icons::kLockFilledIcon
+                                               : vector_icons::kLockIcon);
+  }
+
   if (IsContextualTasksPage()) {
     return &vector_icons::kGoogleColorIcon;
   }
