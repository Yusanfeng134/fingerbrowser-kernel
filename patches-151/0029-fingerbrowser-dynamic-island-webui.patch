+import {html} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import type {DynamicIslandAppElement} from './app.js';
+
+export function getHtml(this: DynamicIslandAppElement) {
+  return html`<!--_html_template_start_-->
+<style>
+  :host {
+    display: block;
+    /* 固定宽度：气泡尺寸由内容决定（ShouldAutoResizeHost），不给宽度会随文字
+       长度抖动。高度让内容决定，此处只有一行输入，不需要 max-height。 */
+    width: 420px;
+  }
+
+  .row {
+    align-items: center;
+    display: flex;
+    gap: 8px;
+    padding: 10px 12px;
+  }
+
+  input {
+    background: transparent;
+    border: 0;
+    color: inherit;
+    flex: 1;
+    font: inherit;
+    outline: none;
+  }
+
+  input::placeholder {
+    color: var(--color-sys-on-surface-subtle, #444746);
+  }
+
+  .hint {
+    color: var(--color-sys-on-surface-subtle, #444746);
+    font-size: 11px;
+    flex: none;
+  }
+</style>
+
+<div class="row">
+  <input type="text"
+         .value="${this.query_}"
+         placeholder="问点什么…"
+         maxlength="500"
+         autofocus
+         @input="${this.onInput_}"
+         @keydown="${this.onKeydown_}">
+  <span class="hint">回车发送</span>
+</div>
+<!--_html_template_end_-->`;
+}
diff --git a/chrome/browser/resources/dynamic_island/app.ts b/chrome/browser/resources/dynamic_island/app.ts
new file mode 100644
index 0000000000..8c2deaa101
--- /dev/null
+++ b/chrome/browser/resources/dynamic_island/app.ts
@@ -0,0 +1,83 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import '/strings.m.js';
+
+import {CrLitElement} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+import {loadTimeData} from 'chrome://resources/js/load_time_data.js';
+
+import {getHtml} from './app.html.js';
+
+// 灵动岛第一期：只做「唤起」。
+//
+// 输入问题 → 回车 → 带着问题打开 AI 新标签页。**不新增任何能力**：就地对话需要
+// 气泡直接调 /ai/chat，而气泡跑在 chrome:// 源上，拿不到 AI 令牌、Origin 也对
+// 不上 —— 那要新开 mojo 通道，是第二期的事。
+//
+// 本页面没有任何可调用接口：不绑 mojo，不注册 message handler。它能造成的全部
+// 影响就是让宿主导航到管理台 origin 下的一个 URL，而去哪由 C++ 白名单裁决
+// （见 dynamic_island_bubble_view.cc 的 OpenURLFromTab）。
+export class DynamicIslandAppElement extends CrLitElement {
+  static get is() {
+    return 'dynamic-island-app';
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      query_: {type: String},
+    };
+  }
+
+  protected accessor query_: string = '';
+
+  // 问题经 URL 传递，所以要限长。客户端那边做了防御性截断（2000），但 URL 不该
+  // 承载长文本 —— 两侧都限，且这一侧限得更严：用户在这里能看到输入框，超长时
+  // 的截断对他是可见的；到了 URL 那层再截就是静默丢失。
+  protected static readonly MAX_QUERY_LENGTH = 500;
+
+  protected onInput_(e: Event) {
+    this.query_ = (e.target as HTMLInputElement).value;
+  }
+
+  protected onKeydown_(e: KeyboardEvent) {
+    if (e.key !== 'Enter' || e.isComposing) {
+      // isComposing：中文输入法组词过程中的回车是「确认候选词」，不是提交。
+      // 不判这一条的话，用户打「亚马逊」按回车选词就会直接把半截问题发出去。
+      return;
+    }
+    e.preventDefault();
+    this.submit_();
+  }
+
+  protected submit_() {
+    const q = this.query_.trim().slice(0, DynamicIslandAppElement.MAX_QUERY_LENGTH);
+    if (!q) {
+      return;
+    }
+    const base = loadTimeData.getString('newTabUrl');
+    if (!base) {
+      return;
+    }
+    // 用锚点导航而不是 location.assign：导航要经过宿主的 OpenURLFromTab 白名单，
+    // 由它决定放不放行、开在哪里。页面自己跳转会试图在气泡内部导航，那既没有
+    // 标签栏也回不去。
+    const a = document.createElement('a');
+    a.href = `${base}?q=${encodeURIComponent(q)}`;
+    this.shadowRoot.appendChild(a);
+    a.click();
+    a.remove();
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'dynamic-island-app': DynamicIslandAppElement;
+  }
+}
+
+customElements.define(DynamicIslandAppElement.is, DynamicIslandAppElement);
