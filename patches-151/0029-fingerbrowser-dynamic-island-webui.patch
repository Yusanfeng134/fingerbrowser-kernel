@@ -0,0 +1,51 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_DYNAMIC_ISLAND_DYNAMIC_ISLAND_UI_H_
+#define CHROME_BROWSER_UI_WEBUI_DYNAMIC_ISLAND_DYNAMIC_ISLAND_UI_H_
+
+#include <string_view>
+
+#include "chrome/browser/ui/webui/top_chrome/top_chrome_web_ui_controller.h"
+#include "chrome/browser/ui/webui/top_chrome/top_chrome_webui_config.h"
+
+class DynamicIslandUI;
+
+class DynamicIslandUIConfig
+    : public DefaultTopChromeWebUIConfig<DynamicIslandUI> {
+ public:
+  DynamicIslandUIConfig();
+
+  // DefaultTopChromeWebUIConfig:
+  bool IsWebUIEnabled(content::BrowserContext* browser_context) override;
+  // 气泡必须跟着页面内容定尺寸。默认 false 对侧栏是对的（尺寸由侧栏决定），
+  // 气泡没有外部尺寸来源，关掉自动伸缩就停在最小尺寸 —— 表现为「弹出一个空白
+  // 小气泡」，看起来像页面没加载，实际页面完好（0023 上实测：内容已渲染成
+  // 288x186 而视口只有 26px）。
+  bool ShouldAutoResizeHost() override;
+};
+
+// 灵动岛第一期：唤起 AI 新标签页。
+//
+// 只做「带着问题打开一个标签页」，不新增任何能力。就地对话需要气泡直接调
+// /ai/chat，而气泡跑在 chrome:// 源上拿不到 AI 令牌、Origin 也对不上 —— 那要
+// 新开 mojo 通道，属第二期。
+//
+// 与 0023 账号面板同样的约束：不绑 mojo、不注册 message handler。页面唯一能做
+// 的是渲染一个 <a href>，去哪由气泡宿主的白名单决定。WebUI 跑在 chrome:// 上、
+// 天生带 WebUI 绑定，是真正的特权面，而这类接口「加一个方法几乎零成本、减一个
+// 方法要改两边」，所以在还没有第一个方法时就卡住。
+class DynamicIslandUI : public TopChromeWebUIController {
+ public:
+  explicit DynamicIslandUI(content::WebUI* web_ui);
+  DynamicIslandUI(const DynamicIslandUI&) = delete;
+  DynamicIslandUI& operator=(const DynamicIslandUI&) = delete;
+  ~DynamicIslandUI() override;
+
+  static constexpr std::string_view GetWebUIName() { return "DynamicIsland"; }
+
+  WEB_UI_CONTROLLER_TYPE_DECL();
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_DYNAMIC_ISLAND_DYNAMIC_ISLAND_UI_H_
