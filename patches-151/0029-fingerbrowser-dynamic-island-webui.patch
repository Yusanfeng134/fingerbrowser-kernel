@@ -0,0 +1,68 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/dynamic_island/dynamic_island_ui.h"
+
+#include "base/command_line.h"
+#include "chrome/browser/fingerbrowser/fingerbrowser_console.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/common/webui_url_constants.h"
+#include "chrome/grit/dynamic_island_resources.h"
+#include "chrome/grit/dynamic_island_resources_map.h"
+#include "chrome/grit/generated_resources.h"
+#include "content/public/browser/web_ui.h"
+#include "content/public/browser/web_ui_data_source.h"
+#include "content/public/common/url_constants.h"
+#include "ui/webui/webui_util.h"
+
+DynamicIslandUIConfig::DynamicIslandUIConfig()
+    : DefaultTopChromeWebUIConfig(content::kChromeUIScheme,
+                                  chrome::kChromeUIDynamicIslandHost) {}
+
+bool DynamicIslandUIConfig::IsWebUIEnabled(
+    content::BrowserContext* browser_context) {
+  // 门控用 --fp-shell（浏览器外壳）而非 --fp-active：岛只在客户端外壳出现。
+  //
+  // 不进店铺环境是有意的，理由不是「保持一致」：岛在环境里唤起会打开一个由
+  // 客户端本地服务提供的页面，等于让 AI 令牌多一个持有者，而店铺环境正是日常
+  // 承载外部内容的地方。
+  //
+  // 实测确认过一条既有性质（probe/run-env-localhost-reach.cjs）：店铺环境**本来
+  // 就够得着**客户端本地服务 —— Chromium 不让代理拦 127.0.0.1，配一个连不通的
+  // 代理时外部地址被挡而本地服务照样可达。所以这不是新洞；但「能做到」和「我们
+  // 主动把入口放进去」是两回事，后者会把边角情况变成常规路径。
+  //
+  // 还要 --fp-newtab-url：没有它岛无处可去，与其弹出一个按回车没反应的输入框，
+  // 不如不出现。
+  const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+  return cmd->HasSwitch("fp-shell") &&
+         fingerbrowser::GetNewTabUrl().is_valid();
+}
+
+bool DynamicIslandUIConfig::ShouldAutoResizeHost() {
+  return true;
+}
+
+DynamicIslandUI::DynamicIslandUI(content::WebUI* web_ui)
+    : TopChromeWebUIController(web_ui) {
+  Profile* profile = Profile::FromWebUI(web_ui);
+  content::WebUIDataSource* source = content::WebUIDataSource::CreateAndAdd(
+      profile, chrome::kChromeUIDynamicIslandHost);
+
+  static constexpr webui::LocalizedString kStrings[] = {
+      {"title", IDS_DYNAMIC_ISLAND_TITLE},
+  };
+  source->AddLocalizedStrings(kStrings);
+
+  // 页面拿到的全部东西：AI 新标签页的地址。只读字符串，页面无法用它请求内核做
+  // 任何事 —— 导航去哪仍由气泡宿主的白名单裁决。
+  source->AddString("newTabUrl", fingerbrowser::GetNewTabUrl().spec());
+
+  webui::SetupWebUIDataSource(source, kDynamicIslandResources,
+                              IDR_DYNAMIC_ISLAND_DYNAMIC_ISLAND_HTML);
+}
+
+DynamicIslandUI::~DynamicIslandUI() = default;
+
+WEB_UI_CONTROLLER_TYPE_IMPL(DynamicIslandUI)
