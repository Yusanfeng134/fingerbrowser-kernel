+#ifndef CONTENT_BROWSER_WEBAUTH_FINGERBROWSER_PASSKEY_STORE_H_
+#define CONTENT_BROWSER_WEBAUTH_FINGERBROWSER_PASSKEY_STORE_H_
+
+#include "base/files/file_path.h"
+#include "content/common/content_export.h"
+
+namespace content {
+
+class VirtualAuthenticator;
+
+// FingerBrowser: persists the per-environment software authenticator's passkeys
+// inside that environment's profile directory.
+//
+// Without this the credentials live only in memory, so a passkey registered in
+// one session disappears when the environment is closed -- the account would
+// then be unrecoverable through that route. Storing them under the profile is
+// also what keeps environments isolated: each environment already has its own
+// user-data-dir, so credentials cannot leak across store accounts, and an
+// environment that is exported or handed to a teammate carries its passkeys
+// with it.
+//
+// The file is encrypted at rest (OSCrypt / DPAPI on Windows), the same
+// protection the profile's cookies get. A passkey private key IS the account
+// credential: anyone holding it can sign in, so it must never be written in
+// the clear.
+class CONTENT_EXPORT FingerBrowserPasskeyStore {
+ public:
+  // Restores previously stored credentials into |authenticator|. Missing or
+  // unreadable state is not an error: the environment simply starts with no
+  // passkeys, exactly as a fresh one would.
+  static void Load(VirtualAuthenticator* authenticator,
+                   const base::FilePath& profile_dir);
+
+  // Writes |authenticator|'s current credentials back to the profile. Called
+  // whenever a credential is created, updated (the signature counter changes on
+  // every assertion) or deleted.
+  static void Save(const VirtualAuthenticator* authenticator,
+                   const base::FilePath& profile_dir);
+
+  // Absolute path of the store for |profile_dir|. Exposed for tests.
+  static base::FilePath PathFor(const base::FilePath& profile_dir);
+};
+
+}  // namespace content
+
+#endif  // CONTENT_BROWSER_WEBAUTH_FINGERBROWSER_PASSKEY_STORE_H_
