+++ b/content/browser/webauth/fingerbrowser_passkey_store.cc
@@ -0,0 +1,271 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "content/browser/webauth/fingerbrowser_passkey_store.h"
+
+#include <utility>
+
+#include "base/base64.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/logging.h"
+#include "base/task/thread_pool.h"
+#include "base/threading/scoped_blocking_call.h"
+#include "base/threading/thread_restrictions.h"
+#include "base/values.h"
+#include "build/build_config.h"
+#include "content/browser/webauth/virtual_authenticator.h"
+#include "device/fido/public/public_key_credential_rp_entity.h"
+#include "device/fido/public/public_key_credential_user_entity.h"
+
+#if BUILDFLAG(IS_WIN)
+#include <windows.h>
+
+#include <wincrypt.h>
+#endif
+
+namespace content {
+
+namespace {
+
+constexpr char kStoreFileName[] = "FingerBrowserPasskeys";
+
+// Serialized field names.
+constexpr char kCredentials[] = "credentials";
+constexpr char kCredentialId[] = "id";
+constexpr char kPrivateKey[] = "privateKey";
+constexpr char kRpIdHash[] = "rpIdHash";
+constexpr char kCounter[] = "counter";
+constexpr char kIsResident[] = "isResident";
+constexpr char kRpId[] = "rpId";
+constexpr char kRpName[] = "rpName";
+constexpr char kUserId[] = "userId";
+constexpr char kUserName[] = "userName";
+constexpr char kUserDisplayName[] = "userDisplayName";
+
+// A passkey private key is the account credential itself. It is only ever
+// written through these two functions, which bind the data to the current OS
+// user account (DPAPI on Windows -- the same mechanism that protects the
+// profile's cookies).
+//
+// On platforms without an implementation here, persistence is refused rather
+// than falling back to plaintext: losing passkeys across restarts is an
+// inconvenience, leaking them is an account compromise.
+bool EncryptForStorage(const std::string& plaintext, std::string* out) {
+#if BUILDFLAG(IS_WIN)
+  DATA_BLOB input = {};
+  input.pbData =
+      reinterpret_cast<BYTE*>(const_cast<char*>(plaintext.data()));
+  input.cbData = static_cast<DWORD>(plaintext.size());
+  DATA_BLOB output = {};
+  if (!::CryptProtectData(&input, L"FingerBrowser passkeys", /*pOptionalEntropy=*/nullptr,
+                          /*pvReserved=*/nullptr, /*pPromptStruct=*/nullptr,
+                          /*dwFlags=*/0, &output)) {
+    return false;
+  }
+  out->assign(reinterpret_cast<char*>(output.pbData), output.cbData);
+  ::LocalFree(output.pbData);
+  return true;
+#else
+  return false;
+#endif
+}
+
+bool DecryptFromStorage(const std::string& ciphertext, std::string* out) {
+#if BUILDFLAG(IS_WIN)
+  DATA_BLOB input = {};
+  input.pbData =
+      reinterpret_cast<BYTE*>(const_cast<char*>(ciphertext.data()));
+  input.cbData = static_cast<DWORD>(ciphertext.size());
+  DATA_BLOB output = {};
+  if (!::CryptUnprotectData(&input, /*ppszDataDescr=*/nullptr,
+                            /*pOptionalEntropy=*/nullptr, /*pvReserved=*/nullptr,
+                            /*pPromptStruct=*/nullptr, /*dwFlags=*/0, &output)) {
+    return false;
+  }
+  out->assign(reinterpret_cast<char*>(output.pbData), output.cbData);
+  ::LocalFree(output.pbData);
+  return true;
+#else
+  return false;
+#endif
+}
+
+// Writes the already-encrypted blob. Runs on a thread pool sequence: file I/O
+// is forbidden on the UI thread, and credential changes arrive on it.
+void WriteStoreOnBlockingSequence(const base::FilePath& path,
+                                  const std::string& encrypted) {
+  base::ScopedBlockingCall scoped_blocking_call(FROM_HERE,
+                                                base::BlockingType::MAY_BLOCK);
+  if (!base::WriteFile(path, encrypted)) {
+    LOG(ERROR) << "FingerBrowser: failed writing passkey store.";
+  }
+}
+
+}  // namespace
+
+// static
+base::FilePath FingerBrowserPasskeyStore::PathFor(
+    const base::FilePath& profile_dir) {
+  return profile_dir.AppendASCII(kStoreFileName);
+}
+
+// static
+void FingerBrowserPasskeyStore::Save(const VirtualAuthenticator* authenticator,
+                                     const base::FilePath& profile_dir) {
+  if (!authenticator || profile_dir.empty()) {
+    return;
+  }
+
+  base::ListValue credentials;
+  for (const auto& [credential_id, registration] :
+       authenticator->registrations()) {
+    base::DictValue entry;
+    entry.Set(kCredentialId, base::Base64Encode(credential_id));
+    entry.Set(kPrivateKey,
+              base::Base64Encode(registration.private_key->GetPKCS8PrivateKey()));
+    entry.Set(kRpIdHash, base::Base64Encode(registration.application_parameter));
+    // The signature counter must survive restarts: relying parties treat a
+    // counter that goes backwards as evidence of a cloned authenticator.
+    entry.Set(kCounter, static_cast<int>(registration.counter));
+    entry.Set(kIsResident, registration.is_resident);
+    if (registration.rp) {
+      entry.Set(kRpId, registration.rp->id);
+      if (registration.rp->name) {
+        entry.Set(kRpName, *registration.rp->name);
+      }
+    }
+    if (registration.user) {
+      entry.Set(kUserId, base::Base64Encode(registration.user->id));
+      if (registration.user->name) {
+        entry.Set(kUserName, *registration.user->name);
+      }
+      if (registration.user->display_name) {
+        entry.Set(kUserDisplayName, *registration.user->display_name);
+      }
+    }
+    credentials.Append(std::move(entry));
+  }
+
+  base::DictValue root;
+  root.Set(kCredentials, std::move(credentials));
+  std::string json;
+  if (!base::JSONWriter::Write(root, &json)) {
+    return;
+  }
+  std::string encrypted;
+  if (!EncryptForStorage(json, &encrypted)) {
+    LOG(ERROR) << "FingerBrowser: refusing to persist passkeys without "
+                  "encryption support on this platform.";
+    return;
+  }
+  // Serialization and encryption happen here, on the caller's thread, because
+  // they read the authenticator's live state. Only the write is handed off --
+  // the blob is self-contained, so nothing dangles if the authenticator goes
+  // away before the task runs.
+  base::ThreadPool::PostTask(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+       base::TaskShutdownBehavior::BLOCK_SHUTDOWN},
+      base::BindOnce(&WriteStoreOnBlockingSequence, PathFor(profile_dir),
+                     std::move(encrypted)));
+}
+
+// static
+void FingerBrowserPasskeyStore::Load(VirtualAuthenticator* authenticator,
+                                     const base::FilePath& profile_dir) {
+  if (!authenticator || profile_dir.empty()) {
+    return;
+  }
+  const base::FilePath path = PathFor(profile_dir);
+  std::string encrypted;
+  {
+    // Read synchronously: the authenticator is being created right now and must
+    // come up already holding this environment's passkeys, otherwise the first
+    // sign-in attempt would see an empty authenticator. The file is small (a
+    // handful of credentials) and this happens once per environment, on the
+    // first WebAuthn call.
+    base::ScopedAllowBlocking allow_blocking;
+    if (!base::ReadFileToString(path, &encrypted) || encrypted.empty()) {
+      return;  // No passkeys stored yet; a fresh environment looks like this.
+    }
+  }
+  std::string json;
+  if (!DecryptFromStorage(encrypted, &json)) {
+    LOG(ERROR) << "FingerBrowser: passkey store could not be decrypted.";
+    return;
+  }
+  std::optional<base::DictValue> root =
+      base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+  if (!root) {
+    return;
+  }
+  const base::ListValue* credentials = root->FindList(kCredentials);
+  if (!credentials) {
+    return;
+  }
+
+  for (const base::Value& value : *credentials) {
+    const base::DictValue* entry = value.GetIfDict();
+    if (!entry) {
+      continue;
+    }
+    const std::string* id_b64 = entry->FindString(kCredentialId);
+    const std::string* key_b64 = entry->FindString(kPrivateKey);
+    const std::string* rp_id_hash_b64 = entry->FindString(kRpIdHash);
+    if (!id_b64 || !key_b64 || !rp_id_hash_b64) {
+      continue;
+    }
+    std::optional<std::vector<uint8_t>> credential_id =
+        base::Base64Decode(*id_b64);
+    std::optional<std::vector<uint8_t>> pkcs8 = base::Base64Decode(*key_b64);
+    std::optional<std::vector<uint8_t>> rp_id_hash =
+        base::Base64Decode(*rp_id_hash_b64);
+    if (!credential_id || !pkcs8 || !rp_id_hash ||
+        rp_id_hash->size() != device::kRpIdHashLength) {
+      continue;
+    }
+    std::optional<std::unique_ptr<device::VirtualFidoDevice::PrivateKey>> key =
+        device::VirtualFidoDevice::PrivateKey::FromPKCS8(*pkcs8);
+    if (!key) {
+      continue;
+    }
+
+    device::VirtualFidoDevice::RegistrationData registration(
+        std::move(*key),
+        base::span<const uint8_t, device::kRpIdHashLength>(*rp_id_hash),
+        static_cast<uint32_t>(entry->FindInt(kCounter).value_or(0)));
+    registration.is_resident = entry->FindBool(kIsResident).value_or(false);
+
+    if (const std::string* rp_id = entry->FindString(kRpId)) {
+      device::PublicKeyCredentialRpEntity rp;
+      rp.id = *rp_id;
+      if (const std::string* rp_name = entry->FindString(kRpName)) {
+        rp.name = *rp_name;
+      }
+      registration.rp = std::move(rp);
+    }
+    if (const std::string* user_id_b64 = entry->FindString(kUserId)) {
+      if (std::optional<std::vector<uint8_t>> user_id =
+              base::Base64Decode(*user_id_b64)) {
+        device::PublicKeyCredentialUserEntity user;
+        user.id = std::move(*user_id);
+        if (const std::string* user_name = entry->FindString(kUserName)) {
+          user.name = *user_name;
+        }
+        if (const std::string* display = entry->FindString(kUserDisplayName)) {
+          user.display_name = *display;
+        }
+        registration.user = std::move(user);
+      }
+    }
+
+    authenticator->registrations().emplace(std::move(*credential_id),
+                                           std::move(registration));
+  }
+}
+
+}  // namespace content
