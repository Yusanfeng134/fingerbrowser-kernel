+VirtualAuthenticatorManagerImpl*
+AuthenticatorEnvironment::EnsureFingerBrowserAuthenticatorFor(
+    FrameTreeNode* node) {
+  // Always attach at the root of the frame tree. Lookups walk from a frame up
+  // to its ancestors, so a manager on the root serves every frame in the tab.
+  // Attaching to whichever frame happened to ask first would give a subframe
+  // its own authenticator, and the main frame would later get a second one --
+  // two separate credential stores in one tab, so a passkey registered in one
+  // would be invisible to the other.
+  while (FrameTreeNode* parent = FrameTreeNode::From(node->parent())) {
+    node = parent;
+  }
+  EnableVirtualAuthenticatorFor(node, /*enable_ui=*/false);
+  auto it = virtual_authenticator_managers_.find(node);
+  if (it == virtual_authenticator_managers_.end()) {
+    return nullptr;
+  }
+  VirtualAuthenticatorManagerImpl* manager = it->second.get();
+
+  VirtualAuthenticator::Options options;
+  options.protocol = device::ProtocolVersion::kCtap2;
+  options.ctap2_version = device::Ctap2Version::kCtap2_1;
+  // An internal/platform authenticator: this environment's own passkey store,
+  // not a roaming key. Discoverable credentials are required because that is
+  // what "passkey" means to a relying party (and what lets sign-in work without
+  // the site supplying allowCredentials).
+  options.transport = device::FidoTransportProtocol::kInternal;
+  options.attachment = device::AuthenticatorAttachment::kPlatform;
+  options.has_resident_key = true;
+  options.has_user_verification = true;
+  // Identify no vendor. See VirtualAuthenticator::Options::zero_aaguid.
+  options.zero_aaguid = true;
+
+  VirtualAuthenticator* authenticator =
+      manager->AddAuthenticatorAndReturnNonOwningPointer(options);
+  if (authenticator) {
+    // The environment itself is the trust boundary: the user already unlocked
+    // the profile to open it, so the authenticator does not impose a second
+    // gesture. No UI is shown (enable_ui above is false).
+    authenticator->set_user_verified(true);
+    authenticator->SetUserPresence(true);
+
+    // Restore this environment's passkeys and keep them in sync from here on.
+    // The profile directory is what makes environments isolated: each one has
+    // its own user-data-dir, so credentials never cross store accounts.
+    base::FilePath profile_dir;
+    if (BrowserContext* context = node->current_frame_host()
+                                      ? node->current_frame_host()->GetBrowserContext()
+                                      : nullptr) {
+      profile_dir = context->GetPath();
+    }
+    if (!profile_dir.empty()) {
+      fingerbrowser_passkey_paths_[authenticator] = profile_dir;
+      FingerBrowserPasskeyStore::Load(authenticator, profile_dir);
+    }
+    authenticator->AddObserver(this);
+  }
+  return manager;
+}
