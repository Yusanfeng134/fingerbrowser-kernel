+// FingerBrowser: build a spoofed position from the per-profile geolocation
+// switches. Returns null when they are not set. Adapted to 151's
+// GeolocationCoordinates constructor (std::optional fields).
+Geoposition* CreateFingerBrowserGeoposition() {
+  const std::string lat =
+      fingerbrowser::SwitchValue(fingerbrowser::kGeoLatitudeE6Switch);
+  const std::string lon =
+      fingerbrowser::SwitchValue(fingerbrowser::kGeoLongitudeE6Switch);
+  if (lat.empty() || lon.empty()) {
+    return nullptr;
+  }
+  const double latitude =
+      fingerbrowser::IntSwitch(fingerbrowser::kGeoLatitudeE6Switch) / 1e6;
+  const double longitude =
+      fingerbrowser::IntSwitch(fingerbrowser::kGeoLongitudeE6Switch) / 1e6;
+  auto* coordinates = MakeGarbageCollected<GeolocationCoordinates>(
+      latitude, longitude,
+      /*altitude=*/std::nullopt,
+      // 民用 GPS 的常见量级；给 0 反而不像真实设备。
+      /*accuracy=*/40.0,
+      /*altitude_accuracy=*/std::nullopt,
+      /*heading=*/std::nullopt,
+      /*speed=*/std::nullopt);
+  return MakeGarbageCollected<Geoposition>(
+      coordinates, ConvertTimeToEpochTimeStamp(base::Time::Now()));
+}
+
+bool FingerBrowserGeolocationActive() {
+  return !fingerbrowser::SwitchValue(fingerbrowser::kGeoLatitudeE6Switch)
+              .empty() &&
+         !fingerbrowser::SwitchValue(fingerbrowser::kGeoLongitudeE6Switch)
+              .empty();
+}
