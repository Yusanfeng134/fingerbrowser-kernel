diff --git a/third_party/blink/renderer/core/events/navigator_events.cc b/third_party/blink/renderer/core/events/navigator_events.cc
index a57561775c..6785bc2bd8 100644
--- a/third_party/blink/renderer/core/events/navigator_events.cc
+++ b/third_party/blink/renderer/core/events/navigator_events.cc
@@ -34,10 +34,20 @@
 #include "third_party/blink/renderer/core/frame/local_frame.h"
 #include "third_party/blink/renderer/core/frame/navigator.h"
 #include "third_party/blink/renderer/core/frame/settings.h"
+#include "third_party/blink/renderer/platform/fingerbrowser/fingerbrowser_fingerprint.h"
 
 namespace blink {
 
 int32_t NavigatorEvents::maxTouchPoints(Navigator& navigator) {
+  // FingerBrowser：宿主带触摸屏时这里报 10，而同一台机器上 ontouchstart 不存在、
+  // (pointer: coarse) 为否 —— 这三者本该同进同退。对不上不是「少伪装一项」，
+  // 是阳性证据：检测方看到的是有人动过手脚，而不是一个普通用户。
+  //
+  // 开关值 0 表示无触摸（桌面人格），也是最常见的取值，所以用「是否传了这个
+  // 开关」而不是「值是否大于 0」来判断是否接管。
+  if (fingerbrowser::HasSwitch(fingerbrowser::kMaxTouchPointsSwitch)) {
+    return fingerbrowser::IntSwitch(fingerbrowser::kMaxTouchPointsSwitch);
+  }
   LocalDOMWindow* window = navigator.DomWindow();
   return window ? window->GetFrame()->GetSettings()->GetMaxTouchPoints() : 0;
 }
diff --git a/third_party/blink/renderer/core/frame/local_frame.cc b/third_party/blink/renderer/core/frame/local_frame.cc
index b50b6d67f8..77aca89e5f 100644
--- a/third_party/blink/renderer/core/frame/local_frame.cc
+++ b/third_party/blink/renderer/core/frame/local_frame.cc
@@ -220,6 +220,7 @@
 #include "third_party/blink/renderer/core/svg/svg_document_extensions.h"
 #include "third_party/blink/renderer/core/timing/dom_window_performance.h"
 #include "third_party/blink/renderer/platform/back_forward_cache_utils.h"
+#include "third_party/blink/renderer/platform/fingerbrowser/fingerbrowser_fingerprint.h"
 #include "third_party/blink/renderer/platform/bindings/script_forbidden_scope.h"
 #include "third_party/blink/renderer/platform/bindings/source_location.h"
 #include "third_party/blink/renderer/platform/bindings/v8_binding.h"
@@ -1841,6 +1842,34 @@ double LocalFrame::DevicePixelRatio() const {
   if (!page_)
     return 0;
 
+  // FingerBrowser：devicePixelRatio。宿主 4K + 175% 缩放时这里是 1.75，而人格
+  // 声称的是一块 1920x1080 的普通桌面屏 —— 那种屏的 DPR 几乎总是 1。
+  //
+  // 放在这里而不是 LocalDOMWindow::devicePixelRatio()：媒体查询的
+  // MediaValues::CalculateDevicePixelRatio() 也调这个函数，改一处两边同时生效，
+  // 不会出现 window.devicePixelRatio 与 (resolution: Xdppx) 各说各话。
+  //
+  // LayoutZoomFactor() 在 zoom-for-DSF 下**已经含了设备缩放**（= 设备缩放 ×
+  // 页面缩放），直接相乘等于把 1.75 又乘回去 —— 第一版就这么写的，实测 DPR
+  // 仍是 1.75，改动看起来完全没生效。
+  //
+  // 所以先把真实设备缩放除掉，只保留页面缩放那一份：用户按 Ctrl+= 放大页面时
+  // DPR 本来就该跟着变（真实 1x 屏在 110% 缩放下报 1.1），钉死成常数反而是个
+  // 新特征。
+  if (const int fb_dpr_x1000 =
+          fingerbrowser::IntSwitch(fingerbrowser::kDevicePixelRatioX1000Switch);
+      fb_dpr_x1000 > 0) {
+    // GetScreenInfo 取非 const 引用，而本函数是 const —— 这里只读屏幕信息，
+    // 不改帧状态，故去掉 const 限定是安全的。
+    const float real_dsf =
+        page_->GetChromeClient()
+            .GetScreenInfo(const_cast<LocalFrame&>(*this))
+            .device_scale_factor;
+    const double page_zoom =
+        real_dsf > 0 ? LayoutZoomFactor() / real_dsf : LayoutZoomFactor();
+    return (fb_dpr_x1000 / 1000.0) * page_zoom;
+  }
+
   double ratio = page_->InspectorDeviceScaleFactorOverride();
   ratio *= LayoutZoomFactor();
   return ratio;
diff --git a/third_party/blink/renderer/platform/fingerbrowser/fingerbrowser_fingerprint.h b/third_party/blink/renderer/platform/fingerbrowser/fingerbrowser_fingerprint.h
index 0f2e1843dd..6c2e4f12ec 100644
--- a/third_party/blink/renderer/platform/fingerbrowser/fingerbrowser_fingerprint.h
+++ b/third_party/blink/renderer/platform/fingerbrowser/fingerbrowser_fingerprint.h
@@ -55,6 +55,18 @@ inline constexpr char kAcceptLangSwitch[] = "fp-accept-lang";
 // screen.width/height 仍是宿主真实分辨率，两者不一致本身就是可检测特征。
 inline constexpr char kScreenWidthSwitch[] = "fp-screen-width";
 inline constexpr char kScreenHeightSwitch[] = "fp-screen-height";
+// devicePixelRatio。以 1000 倍整数传递（同经纬度，避免浮点字符串的本地化问题）：
+// 1000 = 1.0，1500 = 1.5。
+//
+// 不伪装它的后果不是「少伪装一项」，而是**制造矛盾**：宿主 4K + 175% 缩放时
+// DPR 报 1.75，而媒体查询的 device-width 是物理宽 ÷ DPR = 3840/1.75 ≈ 2195，
+// 与伪装成 1920 的 screen.width 对不上。检测方看到的不是一个普通用户，而是
+// 「有人动过手脚」——阳性证据，比单纯泄漏真实值严重。
+inline constexpr char kDevicePixelRatioX1000Switch[] = "fp-dpr-x1000";
+// navigator.maxTouchPoints。宿主带触摸屏时它是 10，而 ontouchstart 不存在、
+// pointer:coarse 为否——这三者本该同进同退，对不上同样是阳性证据。
+// 传 0 表示无触摸（桌面人格）。
+inline constexpr char kMaxTouchPointsSwitch[] = "fp-max-touch-points";
 inline constexpr char kDoNotTrackSwitch[] = "fp-do-not-track";
 // 经纬度以 1e6 倍整数传递（命令行开关只走整数解析，避免浮点字符串的本地化问题）。
 inline constexpr char kGeoLatitudeE6Switch[] = "fp-geo-lat-e6";
@@ -103,6 +115,13 @@ inline int IntSwitch(const char* name) {
   return (!value.empty() && base::StringToInt(value, &parsed)) ? parsed : 0;
 }
 
+// 用于合法值包含 0 的开关。此前所有整数开关都靠「值 > 0」判断是否接管，那对
+// screen 宽高、DPR 成立（0 无意义），但对 maxTouchPoints 不成立 —— 0 恰恰是
+// 桌面人格最该传的值，用 IntSwitch 判会把「明确要求无触摸」读成「没配置」。
+inline bool HasSwitch(const char* name) {
+  return base::CommandLine::ForCurrentProcess()->HasSwitch(name);
+}
+
 inline uint32_t CanvasSeed() {
   return static_cast<uint32_t>(IntSwitch(kCanvasNoiseSwitch));
 }
