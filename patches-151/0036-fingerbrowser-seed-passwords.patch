             'passkeyAuthenticator': True,
+            # 启动时把密码种子导入本 profile 的密码库：--fp-seed-passwords=stdin
+            'seedPasswords': True,
             # --fingerbrowser-policy 所接受的 schemaVersion
             'fingerprintPolicy': 1,
         },
