@@ -0,0 +1,275 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/fingerbrowser/fingerbrowser_seed_passwords.h"
+
+#include <stdio.h>
+
+#include <memory>
+#include <set>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/command_line.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/logging.h"
+#include "base/memory/weak_ptr.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/thread_pool.h"
+#include "base/values.h"
+#include "chrome/browser/password_manager/factories/profile_password_store_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "components/password_manager/core/browser/password_manager_util.h"
+#include "components/password_manager/core/browser/password_store/password_store_consumer.h"
+#include "components/password_manager/core/browser/password_store/password_store_interface.h"
+#include "components/password_manager/core/browser/password_store/stored_credential.h"
+#include "content/public/browser/browser_thread.h"
+#include "url/gurl.h"
+
+namespace fingerbrowser {
+
+namespace {
+
+constexpr char kSeedPasswordsSwitch[] = "fp-seed-passwords";
+constexpr char kStdinValue[] = "stdin";
+
+// 种子是一次性的、条目数是店铺凭据量级。设上限只为拒绝畸形输入，不是性能考虑。
+constexpr size_t kMaxSeedBytes = 1024 * 1024;
+
+// 一条待导入的凭据。**只在内存里存在**，读完即随对象析构。
+struct SeedEntry {
+  std::string signon_realm;
+  GURL url;
+  std::u16string username;
+  std::u16string password;
+};
+
+struct SeedParseResult {
+  std::vector<SeedEntry> entries;
+  int total = 0;     // 种子里声明了几条
+  int rejected = 0;  // 格式不合法 / origin 解析失败
+};
+
+// 在阻塞序列上读 stdin。**不在 UI 线程读**：客户端若在写之前崩了，EOF 永不到达，
+// 在 UI 线程读就是启动永久挂住。放到线程池里，最坏情况只是这一个任务挂着，浏览器
+// 照常可用（自动填充不生效，而 §6 的计数行不会出现——两者一起构成可诊断的现象）。
+std::string ReadSeedFromStdinBlocking() {
+  std::string raw;
+  if (!base::ReadStreamToStringWithMaxSize(stdin, kMaxSeedBytes, &raw)) {
+    // 超限或读失败。不打印内容，也不打印长度。
+    fprintf(stderr, "[fp-seed-passwords] error=stdin_read_failed\n");
+    fflush(stderr);
+    return std::string();
+  }
+  return raw;
+}
+
+SeedParseResult ParseSeed(const std::string& raw) {
+  SeedParseResult result;
+  if (raw.empty()) {
+    return result;
+  }
+  std::optional<base::DictValue> root =
+      base::JSONReader::ReadDict(raw, base::JSON_PARSE_RFC);
+  if (!root) {
+    fprintf(stderr, "[fp-seed-passwords] error=not_json_object\n");
+    fflush(stderr);
+    return result;
+  }
+  const base::ListValue* entries = root->FindList("entries");
+  if (!entries) {
+    fprintf(stderr, "[fp-seed-passwords] error=no_entries_list\n");
+    fflush(stderr);
+    return result;
+  }
+
+  for (const base::Value& value : *entries) {
+    result.total++;
+    const base::DictValue* entry = value.GetIfDict();
+    if (!entry) {
+      result.rejected++;
+      continue;
+    }
+    const std::string* origin = entry->FindString("origin");
+    const std::string* username = entry->FindString("username");
+    const std::string* password = entry->FindString("password");
+    if (!origin || !username || !password || password->empty()) {
+      result.rejected++;
+      continue;
+    }
+    GURL url(*origin);
+    if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS()) {
+      result.rejected++;
+      continue;
+    }
+
+    SeedEntry seed;
+    // signon_realm 由 Chromium 自己的辅助函数生成，不自己拼。
+    //
+    // 这条决定「这份凭据会被填到哪里」，而填错地方就是把密码交给别的站点。
+    // 尤其：**http 与 https 的 signon_realm 不同**，自己拼很容易把两者混为一谈，
+    // 那等于允许密码明文发到未加密连接上。交给上游的实现，与原生保存的凭据走
+    // 完全同一条规则。
+    seed.signon_realm = password_manager_util::GetSignonRealm(url);
+    if (seed.signon_realm.empty()) {
+      result.rejected++;
+      continue;
+    }
+    seed.url = std::move(url);
+    seed.username = base::UTF8ToUTF16(*username);
+    seed.password = base::UTF8ToUTF16(*password);
+    result.entries.push_back(std::move(seed));
+  }
+  return result;
+}
+
+// 先取全量已有凭据做判重，再逐条 AddLogin。自析构：所有 AddLogin 都回调后删除。
+class SeedImporter : public password_manager::PasswordStoreConsumer {
+ public:
+  SeedImporter(scoped_refptr<password_manager::PasswordStoreInterface> store,
+               SeedParseResult seed)
+      : store_(std::move(store)), seed_(std::move(seed)) {}
+
+  void Start() {
+    // 取全量而不是逐条按 realm 取：条目数是个位数，一次往返比 N 次简单，也避免
+    // N 个异步回调交织。
+    store_->GetAllLogins(weak_factory_.GetWeakPtr());
+  }
+
+  void OnGetPasswordStoreResultsOrErrorFrom(
+      password_manager::PasswordStoreInterface* store,
+      password_manager::LoginsResultOrError results_or_error) override {
+    DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+
+    if (std::holds_alternative<password_manager::PasswordStoreBackendError>(
+            results_or_error)) {
+      // 读不出已有凭据就**什么都不导入**。
+      //
+      // 换成「读失败就全部导入」看起来更有用，实际是把「只补不覆盖」这条用户
+      // 定下的规则在最不可见的时候丢掉：那正是可能产生「悄悄换回旧密码」的路径。
+      fprintf(stderr, "[fp-seed-passwords] error=cannot_read_existing_logins\n");
+      fflush(stderr);
+      Report(/*imported=*/0, /*skipped=*/0);
+      delete this;
+      return;
+    }
+
+    auto& existing =
+        std::get<password_manager::LoginsResult>(results_or_error);
+    std::set<std::pair<std::string, std::u16string>> have;
+    for (const auto& form : existing) {
+      have.insert({form.signon_realm, form.username_value});
+    }
+
+    std::vector<password_manager::StoredCredential> to_add;
+    int skipped = 0;
+    for (auto& e : seed_.entries) {
+      if (have.count({e.signon_realm, e.username})) {
+        skipped++;
+        continue;
+      }
+      password_manager::StoredCredential form;
+      form.signon_realm = e.signon_realm;
+      form.url = e.url;
+      form.username_value = e.username;
+      form.password_value = e.password;
+      form.date_created = base::Time::Now();
+      // kImported 而不是 kFormSubmission：这条不是用户在表单里提交产生的，
+      // 记成 kFormSubmission 会在密码管理器界面里谎报来源。151 的合法取值见
+      // password_form.h:190-201（没有 kApiCredential，最接近的是 kApi，但那指的
+      // 是 Credential Management API 创建的，也不是这里的情形）。
+      form.type = password_manager::PasswordForm::Type::kImported;
+      to_add.push_back(std::move(form));
+    }
+
+    const int imported = static_cast<int>(to_add.size());
+    if (to_add.empty()) {
+      Report(imported, skipped);
+      delete this;
+      return;
+    }
+    store_->AddLogins(std::move(to_add),
+                      base::BindOnce(&SeedImporter::OnAdded,
+                                     base::Unretained(this), imported, skipped));
+  }
+
+ private:
+  ~SeedImporter() override = default;
+
+  void OnAdded(int imported, int skipped) {
+    Report(imported, skipped);
+    delete this;
+  }
+
+  // §6：四个数必须都在。只报 imported 的话，「3 条里导入了 0 条」和「压根没读到
+  // 种子」看起来一样。**不打印任何条目内容**，连用户名也不打。
+  //
+  // 直接写 stderr，不用 LOG()。Chromium 的 LOG 默认不到 stderr —— 要
+  // `--enable-logging=stderr` 才出来，而客户端读的是 spawn 出来的进程的 stderr，
+  // 不会为了看这一行去开 verbose 日志。实测踩过：功能完全正常
+  // （total=1 imported=1），探针却报「没有计数行」。
+  //
+  // 这条信息只有四个整数，不含任何凭据内容，因此直写 stderr 不引入泄漏面；
+  // 反过来，把它埋进 LOG 才是问题：**一个客户端看不到的诊断等于没有诊断**，
+  // 而交办书 §6 的全部意义就是让「填充没生效」可排查。
+  void Report(int imported, int skipped) {
+    fprintf(stderr,
+            "[fp-seed-passwords] total=%d imported=%d skipped_existing=%d "
+            "rejected=%d\n",
+            seed_.total, imported, skipped, seed_.rejected);
+    fflush(stderr);
+  }
+
+  scoped_refptr<password_manager::PasswordStoreInterface> store_;
+  SeedParseResult seed_;
+  base::WeakPtrFactory<SeedImporter> weak_factory_{this};
+};
+
+void OnSeedRead(base::WeakPtr<Profile> profile, const std::string& raw) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!profile) {
+    return;  // profile 已经没了；什么都不做。
+  }
+  SeedParseResult seed = ParseSeed(raw);
+  // raw 在此作用域结束时析构。C++ 里这只能做到「尽快」，做不到「保证擦除」——
+  // 写明是为了让下一个人知道这是有意为之，不是忘了。
+
+  auto store = ProfilePasswordStoreFactory::GetForProfile(
+      profile.get(), ServiceAccessType::EXPLICIT_ACCESS);
+  if (!store) {
+    fprintf(stderr, "[fp-seed-passwords] error=no_password_store\n");
+    fflush(stderr);
+    return;
+  }
+  // 即使 entries 为空也要走一遍，好让那行计数出现 —— 「四个数全是 0」和「没有
+  // 任何输出」必须可区分。
+  (new SeedImporter(std::move(store), std::move(seed)))->Start();
+}
+
+}  // namespace
+
+void MaybeSeedPasswords(Profile* profile) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!profile) {
+    return;
+  }
+  const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+  // 只接受 stdin 这一个取值。将来若有人想加个文件路径，得先改这里 —— 那时会
+  // 重新读到交办书里「不要改成文件路径」的理由。
+  if (cmd->GetSwitchValueASCII(kSeedPasswordsSwitch) != kStdinValue) {
+    return;
+  }
+
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+       base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+      base::BindOnce(&ReadSeedFromStdinBlocking),
+      base::BindOnce(&OnSeedRead, profile->GetWeakPtr()));
+}
+
+}  // namespace fingerbrowser
