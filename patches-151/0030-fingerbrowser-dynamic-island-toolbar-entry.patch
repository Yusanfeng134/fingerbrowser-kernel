+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_DYNAMIC_ISLAND_DYNAMIC_ISLAND_BUBBLE_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_DYNAMIC_ISLAND_DYNAMIC_ISLAND_BUBBLE_VIEW_H_
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/ui/views/bubble/webui_bubble_dialog_view.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+
+class Browser;
+
+// 灵动岛的气泡宿主。
+//
+// 与 AccountPanelBubbleView 同构，两点不同：
+//
+// 1) **不随失焦关闭**（set_close_on_deactivate(false)）。这正是「岛」与普通气泡
+//    的分界：用户可以点到页面上去看内容、再回来接着问。
+//
+//    这条只有**点击页面其它地方**才验得出来，而截图验收永远不会做这个动作 ——
+//    所以它必须写进验收步骤，不能指望看截图的人想到。
+//
+// 2) 白名单放行的是 AI 新标签页而不是管理台首页。两者同源（同一个本地服务），
+//    但语义不同，所以判定用 fingerbrowser::IsNewTabUrl 而非 IsConsoleUrl ——
+//    管理台那条规则要求只读地址栏，套到这里会让用户在打开的标签里输不进网址。
+//
+// 存在的理由与 0023 相同：WebUI 气泡默认的 OpenURLFromTab 返回 nullptr，页面里的
+// 链接点了什么都不会发生。接过来之后能去哪由这里的白名单决定，不由页面决定 ——
+// 比给页面一个 mojo 方法收得更紧：页面能调用的面是零。
+class DynamicIslandBubbleView : public WebUIBubbleDialogView {
+  METADATA_HEADER(DynamicIslandBubbleView, WebUIBubbleDialogView)
+
+ public:
+  DynamicIslandBubbleView(views::View* anchor_view,
+                          base::WeakPtr<WebUIContentsWrapper> contents_wrapper,
+                          Browser* browser);
+  DynamicIslandBubbleView(const DynamicIslandBubbleView&) = delete;
+  DynamicIslandBubbleView& operator=(const DynamicIslandBubbleView&) = delete;
+  ~DynamicIslandBubbleView() override;
+
+  // WebUIContentsWrapper::Host:
+  content::WebContents* OpenURLFromTab(
+      content::WebContents* source,
+      const content::OpenURLParams& params,
+      base::OnceCallback<void(content::NavigationHandle&)>
+          navigation_handle_callback) override;
+
+ private:
+  raw_ptr<Browser> browser_;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_DYNAMIC_ISLAND_DYNAMIC_ISLAND_BUBBLE_VIEW_H_
diff --git a/chrome/browser/ui/views/dynamic_island/dynamic_island_coordinator.cc b/chrome/browser/ui/views/dynamic_island/dynamic_island_coordinator.cc
new file mode 100644
index 0000000000..c88c2f3653
--- /dev/null
+++ b/chrome/browser/ui/views/dynamic_island/dynamic_island_coordinator.cc
@@ -0,0 +1,87 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/dynamic_island/dynamic_island_coordinator.h"
+
+#include <utility>
+
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/views/dynamic_island/dynamic_island_bubble_view.h"
+#include "chrome/browser/ui/webui/dynamic_island/dynamic_island_ui.h"
+#include "chrome/browser/ui/webui/top_chrome/webui_contents_wrapper.h"
+#include "chrome/browser/ui/webui/webui_embedding_context.h"
+#include "chrome/common/webui_url_constants.h"
+#include "chrome/grit/generated_resources.h"
+#include "ui/views/bubble/bubble_dialog_delegate_view.h"
+#include "ui/views/controls/webview/webview.h"
+
+DynamicIslandCoordinator::DynamicIslandCoordinator(Browser* browser)
+    : browser_(browser) {}
+
+DynamicIslandCoordinator::~DynamicIslandCoordinator() {
+  Close();
+}
+
+bool DynamicIslandCoordinator::IsShowing() const {
+  return widget_ != nullptr;
+}
+
+void DynamicIslandCoordinator::Toggle(views::View* anchor) {
+  if (IsShowing()) {
+    Close();
+    return;
+  }
+  if (!browser_ || !anchor) {
+    return;
+  }
+
+  // 顺序是硬约束，不是风格：
+  //
+  //   1. 建 wrapper
+  //   2. 所有权转到成员（气泡只持 WeakPtr）
+  //   3. SetBrowserWindowInterface
+  //   4. 才能构造气泡 —— WebUIBubbleDialogView 的初始化列表里就解引用 wrapper
+  //      （webui_bubble_dialog_view.cc 的 web_view_ 初始化）
+  //
+  // 第 3 步漏掉的症状是**点击直接闪退**，不是「面板空白」：top-chrome 那套 WebUI
+  // 靠它拿所属浏览器窗口。0023 上漏过一次。
+  auto wrapper = std::make_unique<WebUIContentsWrapperT<DynamicIslandUI>>(
+      GURL(chrome::kChromeUIDynamicIslandURL), browser_->profile(),
+      IDS_DYNAMIC_ISLAND_TITLE);
+  auto* wrapper_ptr = wrapper.get();
+  contents_ = std::move(wrapper);
+  webui::SetBrowserWindowInterface(wrapper_ptr->web_contents(), browser_);
+
+  auto bubble = std::make_unique<DynamicIslandBubbleView>(
+      anchor, wrapper_ptr->GetWeakPtr(), browser_);
+  auto* bubble_ptr = bubble.get();
+  widget_ = views::BubbleDialogDelegateView::CreateBubble(std::move(bubble));
+  observation_.Observe(widget_.get());
+  widget_->Show();
+
+  // 让输入框拿到焦点，否则岛展开后用户还得点一下才能打字 —— 而「展开即可输入」
+  // 正是这个交互的全部意义。
+  bubble_ptr->web_view()->RequestFocus();
+}
+
+void DynamicIslandCoordinator::Close() {
+  if (widget_) {
+    // CloseNow 而非 Close：析构路径上必须同步完成，否则 widget 回调可能在
+    // contents_ 已经析构之后到达。
+    views::Widget* w = widget_;
+    widget_ = nullptr;
+    observation_.Reset();
+    w->CloseNow();
+  }
+  contents_.reset();
+}
+
+void DynamicIslandCoordinator::OnWidgetDestroying(views::Widget* widget) {
+  // 气泡可能被自身关闭（提交后收起）或被外部销毁（窗口关闭），两条路径都要把
+  // 状态清干净，否则 IsShowing() 会长期返回 true，岛再也展不开。
+  observation_.Reset();
+  widget_ = nullptr;
+  contents_.reset();
+}
