+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_DYNAMIC_ISLAND_DYNAMIC_ISLAND_COORDINATOR_H_
+#define CHROME_BROWSER_UI_VIEWS_DYNAMIC_ISLAND_DYNAMIC_ISLAND_COORDINATOR_H_
+
+#include <memory>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "ui/views/widget/widget.h"
+#include "ui/views/widget/widget_observer.h"
+
+class Browser;
+class WebUIContentsWrapper;
+
+namespace views {
+class View;
+}
+
+// 灵动岛气泡的生命周期管理。由工具栏按钮持有。
+//
+// **本头文件刻意只前置声明 views::View，不 include 任何 toolbar 头文件。**
+// 灵动岛的按钮住在 //chrome/browser/ui/views/toolbar 里、要 include 本文件；而
+// chrome/browser/ui/BUILD.gn:1833 已经依赖 toolbar:impl。一旦这里反向依赖 toolbar，
+// gn gen 就会报环。锚点由调用方（按钮自己）以 views::View* 传进来，回边就不存在。
+class DynamicIslandCoordinator : public views::WidgetObserver {
+ public:
+  explicit DynamicIslandCoordinator(Browser* browser);
+  DynamicIslandCoordinator(const DynamicIslandCoordinator&) = delete;
+  DynamicIslandCoordinator& operator=(const DynamicIslandCoordinator&) = delete;
+  ~DynamicIslandCoordinator() override;
+
+  // 已显示则收起，否则以 `anchor` 为锚点展开。
+  //
+  // 锚点由调用方传入而不是在这里向 toolbar 索取：ProfileMenuCoordinator 那条路
+  // （GetAvatarToolbarButton()）返回的是 views::BubbleAnchor，它可能包着
+  // TrackedElement 而非 View —— 取不到 View 时气泡既无 anchor_widget 又无
+  // parent_window，CreateBubble 里
+  // DCHECK(bubble_params.parent || !bubble->has_parent()) 当场失败，表现为点击
+  // 闪退。0023 上实际踩过。按钮把自己的 this 传进来，这条根因链整条不存在。
+  void Toggle(views::View* anchor);
+
+  bool IsShowing() const;
+
+  // views::WidgetObserver:
+  void OnWidgetDestroying(views::Widget* widget) override;
+
+ private:
+  void Close();
+
+  raw_ptr<Browser> browser_;
+
+  // WebContents 的所有权必须在这里：气泡视图只持 WeakPtr（见
+  // WebUIBubbleDialogView 构造函数注释 —— wrapper 的生命周期与 View 无关）。
+  // 放在栈上或让它随构造表达式销毁，气泡一显示就是空白，而那个症状与「资源没
+  // 打包」完全一样，会把人引到错误的方向。
+  std::unique_ptr<WebUIContentsWrapper> contents_;
+
+  raw_ptr<views::Widget> widget_ = nullptr;
+  base::ScopedObservation<views::Widget, views::WidgetObserver> observation_{
+      this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_DYNAMIC_ISLAND_DYNAMIC_ISLAND_COORDINATOR_H_
