+#ifndef CHROME_BROWSER_UI_VIEWS_TOOLBAR_DYNAMIC_ISLAND_BUTTON_H_
+#define CHROME_BROWSER_UI_VIEWS_TOOLBAR_DYNAMIC_ISLAND_BUTTON_H_
+
+#include <memory>
+
+#include "base/memory/raw_ptr.h"
+#include "chrome/browser/ui/views/toolbar/toolbar_button.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+
+class Browser;
+class DynamicIslandCoordinator;
+
+// 灵动岛（AI 助手）的工具栏按钮。
+//
+// 做成 ToolbarView 的直接子 View，而不是 pinned action：pinned action 自带右键
+// 「取消固定」，用户一旦隐藏，唯一的 AI 入口就只能从三点菜单找回 —— 对产品的
+// 签名入口是负债。
+//
+// 刻意**不**注册进 ToolbarView::GetViewCommandMap()：那里有两处写死的
+// std::array<views::Button*, 5>，扩它是典型的静默失效点（数组长度写错不报错，
+// 只是有个按钮的命令再也不生效）。代价是按钮的 enabled 状态不跟随命令 ——
+// 而岛按钮只要可见就该可用，本来也不需要跟随。
+class DynamicIslandButton : public ToolbarButton {
+  METADATA_HEADER(DynamicIslandButton, ToolbarButton)
+
+ public:
+  explicit DynamicIslandButton(Browser* browser);
+  DynamicIslandButton(const DynamicIslandButton&) = delete;
+  DynamicIslandButton& operator=(const DynamicIslandButton&) = delete;
+  ~DynamicIslandButton() override;
+
+  // 展开/收起岛。按钮点击与快捷键共用这一条入口 —— 两条路径分开实现的话，
+  // 迟早只有一条被验到。
+  void Toggle();
+
+ private:
+  raw_ptr<Browser> browser_;
+  std::unique_ptr<DynamicIslandCoordinator> coordinator_;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TOOLBAR_DYNAMIC_ISLAND_BUTTON_H_
