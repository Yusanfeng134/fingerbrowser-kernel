index 0000000000..504cb3ba60
--- /dev/null
+++ b/chrome/browser/ui/views/dynamic_island/BUILD.gn
@@ -0,0 +1,51 @@
+# Copyright 2026 The Chromium Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+assert(is_win || is_mac || is_linux || is_chromeos)
+
+# 为什么这里要独立成 target，而不是像 0023 的 account_panel_bubble_view 那样直接
+# 挂进 chrome/browser/ui 的 sources：
+#
+#   chrome/browser/ui/BUILD.gn:1833 已经 deps 了 //chrome/browser/ui/views/toolbar:impl
+#
+# 灵动岛的工具栏按钮住在 toolbar 里、要 include 这个气泡的头文件。若气泡还留在
+# chrome/browser/ui 里，就成了 toolbar -> chrome/browser/ui -> toolbar 的环，
+# gn gen 直接失败。
+#
+# account_panel 没撞上是因为它挂在**已有的**头像按钮上，不需要 toolbar 反向依赖。
+# 「照抄上一个同类实现」在这里会失效 —— 差别不在气泡本身，在谁去唤起它。
+#
+# header target 绝不能 public_deps 到 toolbar：协调器只前置声明 views::View，
+# 不 include 任何 toolbar 头文件，回边就不存在。
+
+source_set("dynamic_island") {
+  public = [
+    "dynamic_island_bubble_view.h",
+    "dynamic_island_coordinator.h",
+  ]
+  public_deps = [
+    "//base",
+    "//chrome/browser:browser_public_dependencies",
+    "//chrome/browser/ui/views/bubble",
+    "//content/public/browser",
+    "//ui/base/metadata",
+    "//ui/views",
+  ]
+}
+
+source_set("impl") {
+  sources = [
+    "dynamic_island_bubble_view.cc",
+    "dynamic_island_coordinator.cc",
+  ]
+  public_deps = [ ":dynamic_island" ]
+  deps = [
+    "//chrome/browser/fingerbrowser",
+    "//chrome/browser/profiles:profile",
+    "//chrome/browser/ui/webui:webui_util",
+    "//chrome/browser/ui/webui/dynamic_island",
+    "//chrome/browser/ui/webui/top_chrome",
+    "//chrome/common",
+  ]
+}
