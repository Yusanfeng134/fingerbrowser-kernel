+    : browser_(browser),
+      coordinator_(std::make_unique<DynamicIslandCoordinator>(browser)) {
+  // 两个图标是 rounded / old 的**样式**对，两份都是 24dp。
+  //
+  // 不能用 SetVectorIcons(a, b)：它的第二参数是**触摸模式**图标，不是样式变体
+  // （toolbar_button.h:106「Sets an icon and touch-mode icon」，ToolbarButton::
+  // UpdateIcon() 只按 TouchUiController 的 touch_ui() 二选一，
+  // toolbar_button.cc:320-329 —— IsRoundedIconsEnabled 在那条路径上根本没人读）。
+  // 那样写编译链接都过，只是把样式变体接到了触摸这条正交的轴上：桌面永远只见
+  // 圆角款，触摸模式反而换成旧款。这类错配编译器拦不住。
+  //
+  // 样式轴要自己判。SetVectorIcon(x) 即 SetVectorIcons(x, x)（同上 :308），
+  // 触摸模式沿用同一份 24dp 资源 —— 我们本就没有触摸专用尺寸，不丢东西。
+  SetVectorIcon(features::IsRoundedIconsEnabled() ? kDynamicIslandIcon
+                                                  : kDynamicIslandOldIcon);
+  SetTooltipText(l10n_util::GetStringUTF16(IDS_TOOLTIP_DYNAMIC_ISLAND));
+  GetViewAccessibility().SetName(
+      l10n_util::GetStringUTF16(IDS_ACCNAME_DYNAMIC_ISLAND));
+  SetID(VIEW_ID_DYNAMIC_ISLAND_BUTTON);
+  SetProperty(views::kElementIdentifierKey,
+              kToolbarDynamicIslandButtonElementId);
+
+  // MenuButtonController 而不是普通 PressedCallback：气泡展开期间按钮要保持
+  // 「按下」态，且再次点击应当收起而不是重新展开一次。TabSearch 按钮是同一形态。
+  SetButtonController(std::make_unique<views::MenuButtonController>(
+      this,
+      base::BindRepeating(&DynamicIslandButton::Toggle, base::Unretained(this)),
+      std::make_unique<views::Button::DefaultButtonControllerDelegate>(this)));
+}
+
+DynamicIslandButton::~DynamicIslandButton() = default;
+
+void DynamicIslandButton::Toggle() {
+  // 锚点传 this：协调器不向 toolbar 索取按钮，既避免 GN 环，也绕开
+  // BubbleAnchor 可能包着 TrackedElement（取不到 View 会让 CreateBubble 的
+  // DCHECK 当场失败，表现为点击闪退）—— 0023 上实际踩过这条。
+  coordinator_->Toggle(this);
+}
+
+BEGIN_METADATA(DynamicIslandButton)
+END_METADATA
