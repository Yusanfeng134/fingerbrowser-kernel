index 0000000000..5591a5b199
--- /dev/null
+++ b/chrome/browser/ui/views/dynamic_island/dynamic_island_bubble_view.cc
@@ -0,0 +1,70 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/dynamic_island/dynamic_island_bubble_view.h"
+
+#include "chrome/browser/fingerbrowser/fingerbrowser_console.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/navigator/browser_navigator.h"
+#include "chrome/browser/ui/navigator/browser_navigator_params.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/base/window_open_disposition.h"
+
+DynamicIslandBubbleView::DynamicIslandBubbleView(
+    views::View* anchor_view,
+    base::WeakPtr<WebUIContentsWrapper> contents_wrapper,
+    Browser* browser)
+    : WebUIBubbleDialogView(anchor_view, std::move(contents_wrapper)),
+      browser_(browser) {
+  // 「岛」与普通气泡的分界：不随失焦关闭。用户可以点到页面上看内容、再回来接着
+  // 问，而不是一移开焦点整个输入就没了。
+  //
+  // 放在构造函数里只是就近，不是时序要求：核对过 151 的实现，close_on_deactivate_
+  // 只在失焦时经 ShouldCloseOnDeactivate() 读取
+  // （ui/views/bubble/bubble_dialog_delegate_view.cc:743，调用点在 :1326），
+  // CreateBubbleWidget 全程不碰它。所以在 CreateBubble 之后设也来得及。
+  //
+  // 之所以把这句写清楚：第一版注释断言「widget 创建时会读取」，那是错的。留着
+  // 会让下一个人以为「构造函数之后设任何气泡字段都无效」，从而绕开本可直接设的
+  // 属性。真正会被 CreateBubbleInternal 重置的是 adjust_if_offscreen，不是这个。
+  set_close_on_deactivate(false);
+}
+
+DynamicIslandBubbleView::~DynamicIslandBubbleView() = default;
+
+content::WebContents* DynamicIslandBubbleView::OpenURLFromTab(
+    content::WebContents* source,
+    const content::OpenURLParams& params,
+    base::OnceCallback<void(content::NavigationHandle&)>
+        navigation_handle_callback) {
+  // 白名单：只放行 AI 新标签页。这是这个面板唯一的安全边界 —— 页面本身没有可
+  // 调用接口，它能造成的全部影响就是让宿主导航到某个 URL。
+  //
+  // 用 IsNewTabUrl 而不是 IsConsoleUrl：两者同源（同一个本地服务），但语义相反。
+  // 管理台那条规则附带「地址栏只读」，套到这里会让用户在打开的标签里输不进网址
+  // —— 那正是 0020/0022 修过的回归。判定只有一处定义，不在这里另写一份。
+  if (!browser_ || !fingerbrowser::IsNewTabUrl(params.url)) {
+    return nullptr;
+  }
+
+  // 在浏览器里开标签页，而不是在气泡内部导航：气泡是个浮层，把 AI 页加载到里面
+  // 既没有标签栏也无法返回。
+  NavigateParams nav_params(browser_, params.url,
+                            ui::PAGE_TRANSITION_AUTO_BOOKMARK);
+  nav_params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  Navigate(&nav_params);
+
+  // 问题已经送出去了，岛收起来。这一处收起是主动的，与「失焦不关闭」不冲突：
+  // 前者是完成动作后的自然收尾，后者是不因为用户去看别处就消失。
+  if (GetWidget()) {
+    GetWidget()->CloseWithReason(
+        views::Widget::ClosedReason::kAcceptButtonClicked);
+  }
+
+  return nav_params.navigated_or_inserted_contents;
+}
+
+BEGIN_METADATA(DynamicIslandBubbleView)
+END_METADATA
