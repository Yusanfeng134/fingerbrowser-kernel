@@ -89,8 +89,17 @@ if (is_win) {
       "$root_out_dir/initialexe/chrome.exe",
       "$root_out_dir/initialexe/chrome.exe.pdb",
     ]
+    # FingerBrowser：最终可执行文件改名为 yunbrowser.exe。
+    #
+    # 动机不是品牌，是安全：内核叫 chrome.exe 时，任务管理器里它和用户真实的
+    # Google Chrome 完全同名，一个店铺环境又是十几个进程。用户想关浏览器时
+    # 「结束任务树」，会连所有店铺环境一起杀掉。
+    #
+    # 只改最终产物：中间产物 initialexe/chrome.exe 和下面 glob 复制的
+    # chrome.exe.pdb 保持原名 —— pdb 的文件名是编进 exe 里的，跟着改会让
+    # 符号查找失效。
     outputs = [
-      "$root_out_dir/chrome.exe",
+      "$root_out_dir/yunbrowser.exe",
       "$root_out_dir/chrome.exe.pdb",
     ]
     args = [
@@ -100,6 +109,8 @@ if (is_win) {
       rebase_path("$root_out_dir", root_build_dir),
       "-a",
       current_cpu,
+      "-n",
+      "yunbrowser.exe",
     ]
     deps = [ ":chrome_initial" ]
   }
