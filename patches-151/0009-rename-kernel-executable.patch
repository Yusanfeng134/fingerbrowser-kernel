diff --git a/build/win/reorder-imports.py b/build/win/reorder-imports.py
index 88851609d4..7344508754 100755
--- a/build/win/reorder-imports.py
+++ b/build/win/reorder-imports.py
@@ -15,17 +15,24 @@ sys.path.insert(
                  'pefile_py3'))
 import pefile
 
-def reorder_imports(input_dir, output_dir, architecture):
+def reorder_imports(input_dir, output_dir, architecture,
+                    output_name='chrome.exe'):
   """Swap chrome_elf.dll to be the first import of chrome.exe.
   Also copy over any related files that might be needed
   (pdbs, manifests etc.).
+
+  output_name lets a fork ship the browser under its own executable name
+  (FingerBrowser/云登 uses yunbrowser.exe). Only the final image is renamed:
+  the intermediate initialexe/chrome.exe and the side files copied below keep
+  their original names, because the .pdb name is recorded inside the image and
+  renaming the file would break symbol lookup.
   """
   # TODO(thakis): See if there is a reliable way to write the
   # correct executable in the first place, so that this script
   # only needs to verify that and not write a whole new exe.
 
   input_image = os.path.join(input_dir, 'chrome.exe')
-  output_image = os.path.join(output_dir, 'chrome.exe')
+  output_image = os.path.join(output_dir, output_name)
 
   # pefile mmap()s the whole executable, and then parses parts of
   # it into python data structures for ease of processing.
@@ -87,11 +94,15 @@ def main(argv):
       metavar='DIR')
   parser.add_option('-a', '--arch', help='architecture of build (optional)',
       default='ia32')
+  parser.add_option('-n', '--output-name',
+      help='file name of the final executable (default chrome.exe)',
+      default='chrome.exe')
   opts, args = parser.parse_args()
 
   if not opts.input or not opts.output:
     parser.error('Please provide and input and output directory')
-  return reorder_imports(opts.input, opts.output, opts.arch)
+  return reorder_imports(opts.input, opts.output, opts.arch,
+                         opts.output_name)
 
 if __name__ == "__main__":
   sys.exit(main(sys.argv[1:]))
diff --git a/chrome/BUILD.gn b/chrome/BUILD.gn
index 973a46b2a3..e87a7934ed 100644
--- a/chrome/BUILD.gn
