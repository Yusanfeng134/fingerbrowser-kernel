 #include "chrome/browser/first_run/first_run.h"
 #include "chrome/browser/headless/headless_command_processor.h"
 #include "chrome/browser/prefs/session_startup_pref.h"
@@ -570,6 +571,38 @@ void StartupBrowserCreatorImpl::DetermineURLsAndLaunch(
         command_line_->GetSwitchValueASCII("fp-pinned-url");
     if (!pinned_url.empty()) {
       TabStripModel* const model = browser->tab_strip_model();
+
+      // FingerBrowser：先清掉上次启动遗留的管理台标签。
+      //
+      // 管理台的端口由系统在启动时分配（listen(0)），所以活过一次启动的管理台
+      // 标签按构造必然是死的 —— 它的服务已经没了。而上面把它固定了，固定状态
+      // 又会随会话恢复一起回来，于是每启动一次就多积一个死标签。实测在一个
+      // profile 里同时恢复出四次不同启动的管理台地址，只有最后一个是活的。
+      //
+      // 会话恢复本身是被 exit_type=Crashed 触发的（客户端在某些路径上是杀进程
+      // 而非正常关闭）。改成优雅关闭只能降低触发频率：真崩溃时照样恢复出一批
+      // 死标签，所以这里的清理是兜底，不能省。
+      //
+      // 判据要求「已固定」而不只是「loopback」：用户自己开的本地页面（比如一个
+      // 开发服务器）同样是 loopback，关掉它是在删用户的东西。而遗留的管理台
+      // 之所以固定，正是因为上次是我们固定的。
+      //
+      // 倒序遍历：关闭会让其后的索引前移，正序会漏掉紧跟其后的那个。
+      for (int i = model->count() - 1; i >= 0; --i) {
+        // 绝不关到只剩零个标签 —— 那会连浏览器窗口一起关掉。
+        if (model->count() <= 1) {
+          break;
+        }
+        if (!model->IsTabPinned(i)) {
+          continue;
+        }
+        content::WebContents* const contents = model->GetWebContentsAt(i);
+        if (contents &&
+            fingerbrowser::IsStaleConsoleUrl(contents->GetVisibleURL())) {
+          model->CloseWebContentsAt(i, TabCloseTypes::CLOSE_NONE);
+        }
+      }
+
       for (int i = 0; i < model->count(); ++i) {
         content::WebContents* const contents = model->GetWebContentsAt(i);
         if (contents && contents->GetVisibleURL().spec() == pinned_url) {
