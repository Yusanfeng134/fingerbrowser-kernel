diff --git a/chrome/browser/fingerbrowser/fingerbrowser_console.cc b/chrome/browser/fingerbrowser/fingerbrowser_console.cc
index c445526547..4ba9547368 100644
--- a/chrome/browser/fingerbrowser/fingerbrowser_console.cc
+++ b/chrome/browser/fingerbrowser/fingerbrowser_console.cc
@@ -55,6 +55,19 @@ bool IsConsoleUrl(const GURL& url) {
   return url::Origin::Create(url) == console;
 }
 
+bool IsStaleConsoleUrl(const GURL& url) {
+  // With no console configured we cannot tell a stale console tab from any
+  // other loopback page, so claim nothing.
+  if (ConsoleOrigin().opaque()) {
+    return false;
+  }
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS() || !net::IsLocalhost(url)) {
+    return false;
+  }
+  // This launch's console is live; only earlier ones are stale.
+  return !IsConsoleUrl(url);
+}
+
 std::u16string GetConsoleOmniboxTitle(const GURL& url) {
   if (!IsConsoleUrl(url)) {
     return std::u16string();
diff --git a/chrome/browser/fingerbrowser/fingerbrowser_console.h b/chrome/browser/fingerbrowser/fingerbrowser_console.h
index fe1e0aba1b..aa4dc08d6c 100644
--- a/chrome/browser/fingerbrowser/fingerbrowser_console.h
+++ b/chrome/browser/fingerbrowser/fingerbrowser_console.h
@@ -27,6 +27,21 @@ namespace fingerbrowser {
 // Returns true if `url` belongs to the management console origin.
 bool IsConsoleUrl(const GURL& url);
 
+// Returns true if `url` looks like a management console left over from an
+// earlier launch: a loopback http(s) origin that is not this launch's console.
+//
+// The console's port is assigned by the OS at startup (listen(0)), so a console
+// tab that survives into the next launch is dead by construction -- its server
+// is gone. Session restore brings those tabs back, and because they were
+// pinned, they come back pinned, so they accumulate one per launch.
+//
+// This is only half a predicate on purpose. Loopback alone would also match a
+// page the user opened themselves (a local dev server, say), and closing that
+// would be destroying their work. Callers must additionally require that the
+// tab is pinned: a stale console tab is pinned because we pinned it last time,
+// whereas a user's own loopback tab is not unless they pinned it by hand.
+bool IsStaleConsoleUrl(const GURL& url);
+
 // The name to show in place of the console URL, e.g. "YunLogin 管理中心".
 // Empty when the console is not configured or `url` is not the console --
 // callers treat empty as "no override, format the URL normally".
